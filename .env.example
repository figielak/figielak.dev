# Copy to .env and fill in. The repository is public (koncept.md §14):
# personal data and homelab host names live only here and in GitHub secrets.
# They are read at build time; without them the site builds with placeholders.

# Shown on / and /maths, base64-encoded in the HTML.
CONTACT_EMAIL=
CONTACT_PHONE=

# Launcher tile on the private dashboard, e.g. services at mealie.<domain>.
HOMELAB_DOMAIN=

# Runtime, not build time: password of /dashboard/private (koncept.md §14).
# On Cloud Run it comes from Secret Manager. `astro dev` works without it;
# for `node dist/server/entry.mjs` export it in the shell.
# DASHBOARD_PASSWORD=

# Runtime: live data on the public dashboard (koncept.md §9). On Cloud Run the
# keys come from Secret Manager and LASTFM_USER from a GitHub variable.
# Without them `astro dev` serves mocks; to try the real sources locally:
# `npm run build && node --env-file=.env dist/server/entry.mjs`.
# GitHub token without any scopes (public data only).
# GITHUB_TOKEN=
# LASTFM_API_KEY=
# LASTFM_USER=
# WAKATIME_API_KEY=
# Hardcover API token with the read:library scope ("Reading" tile).
# HARDCOVER_TOKEN=

# Runtime: the private dashboard (koncept.md §3.4). Secrets from Secret
# Manager on Cloud Run; the Cloudflare IDs are GitHub variables.
# Cloudflare Web Analytics: API token with Account Analytics: Read, the
# account ID and the site tag of the figielak.dev site.
# CF_ANALYTICS_TOKEN=
# CF_ACCOUNT_ID=
# CF_WEB_ANALYTICS_SITE_TAG=
# Secret iCal address of the Google Calendar that holds only lessons.
# TUTORING_ICAL_URL=

# Runtime: token of the homelab push agent for POST /api/stats (koncept.md §9).
# On Cloud Run it comes from Secret Manager; `astro dev` accepts pushes without it.
# STATS_PUSH_TOKEN=
