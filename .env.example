# Copy to .env and fill in. The repository is public (koncept.md §14):
# personal data and homelab host names live only here and in GitHub secrets.
# They are read at build time; without them the site builds with placeholders.

# Shown on / and /maths, base64-encoded in the HTML.
CONTACT_EMAIL=
CONTACT_PHONE=

# Launcher tile on the private dashboard, e.g. services at mealie.<domain>.
HOMELAB_DOMAIN=
