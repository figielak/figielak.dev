---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DashboardPrivate from '../../../components/views/DashboardPrivate.astro';
import { ownerGate } from '../../../lib/owner';
import { getLangFromUrl, useTranslations } from '../../../i18n';

/* Rendered on request and only for the owner (koncept.md §14): a static
   file could be fetched past the check. Kept out of search and the sitemap. */
export const prerender = false;

const denied = ownerGate(Astro.request);
if (denied) return denied;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const t = useTranslations(getLangFromUrl(Astro.url));
---

<BaseLayout
	title={t('meta.dashboardPrivate.title')}
	description={t('meta.dashboardPrivate.description')}
	wide
	glow
	noindex
>
	<DashboardPrivate />
</BaseLayout>
