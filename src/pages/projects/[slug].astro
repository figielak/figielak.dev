---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/views/ProjectDetail.astro';
import { getProjects, type ProjectEntry } from '../../lib/projects';

/*
 * Detail page of one project (docs/koncept.md §3.2), with the case study — the
 * MDX body of its entry — when there is one. The case study is Polish only;
 * the English twin (/en/projects/<slug>) links here for it.
 */
export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectEntry };
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Krystian Figiela`} description={project.data.summary.pl}>
	<ProjectDetail project={project}>
		<Content />
	</ProjectDetail>
</BaseLayout>
