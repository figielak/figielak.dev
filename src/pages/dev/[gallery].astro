---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TileLabel from '../../components/ui/TileLabel.astro';
import DashboardTeaserTile from '../../components/tiles/DashboardTeaserTile.astro';
import WeatherTile from '../../components/tiles/WeatherTile.astro';
import GithubTile from '../../components/tiles/GithubTile.astro';
import HomelabTile from '../../components/tiles/HomelabTile.astro';
import WakaTile from '../../components/tiles/WakaTile.astro';
import EventTile from '../../components/tiles/EventTile.astro';
import FeaturedTile from '../../components/tiles/FeaturedTile.astro';
import SocialTile from '../../components/tiles/SocialTile.astro';
import GoalTile from '../../components/tiles/GoalTile.astro';
import MusicTile from '../../components/tiles/MusicTile.astro';
import BooksTile from '../../components/tiles/BooksTile.astro';
import DeployTile from '../../components/tiles/DeployTile.astro';
import SiteStatsTile from '../../components/tiles/SiteStatsTile.astro';
import ServicesBarTile from '../../components/tiles/ServicesBarTile.astro';
import ServerTile from '../../components/tiles/ServerTile.astro';
import BackupTile from '../../components/tiles/BackupTile.astro';
import ExpiringTile from '../../components/tiles/ExpiringTile.astro';
import LessonsTile from '../../components/tiles/LessonsTile.astro';
import GoalEditTile from '../../components/tiles/GoalEditTile.astro';
import CurrentWorkTile from '../../components/tiles/CurrentWorkTile.astro';
import ExperimentTile from '../../components/tiles/ExperimentTile.astro';
import { currentWork, experiment } from '../../lib/dev-log';
import { LIVE_STATES } from '../../lib/live';
import { mockWeather } from '../../lib/mocks/weather';
import { mockGithub, mockQuietGithub } from '../../lib/mocks/github';
import { mockLab } from '../../lib/mocks/stats';
import { mockUptime } from '../../lib/mocks/uptime';
import { mockAir } from '../../lib/mocks/air';
import { mockWaka, mockWakaWithoutLanguages } from '../../lib/mocks/waka';
import { mockDns, mockTraffic } from '../../lib/mocks/network';
import { mockMusic, mockMusicTrack } from '../../lib/mocks/music';
import { mockBooks } from '../../lib/mocks/books';
import { mockDeploy } from '../../lib/mocks/deploy';
import { mockSite } from '../../lib/mocks/site';
import { mockBackup, mockContainers, mockMonitors } from '../../lib/mocks/homelab-private';
import { mockExpiring } from '../../lib/mocks/expiring';
import { mockLessons } from '../../lib/mocks/lessons';
import { mockHistory } from '../../lib/mocks/history';

/**
 * Dev-only gallery: every live tile in all four states side by side
 * (docs/architecture.md §3), the homelab with its sections in different states, and
 * the tiles without live data that the dashboard layout depends on.
 * getStaticPaths returns nothing in a build, so the page never ships.
 */
export function getStaticPaths() {
	return import.meta.env.DEV ? [{ params: { gallery: 'tiles' } }] : [];
}
---

<BaseLayout title="Tiles — dev" description="Live tile states" wide>
	<section class="editorial-examples" aria-label="Editorial tile examples">
		{(['pl', 'en'] as const).map((lang) => (
			<section class="editorial-group" data-editorial-lang={lang}>
				<TileLabel>{lang} · editorial</TileLabel>
				<div class="editorial-grid" data-editorial-case="standard">
					<CurrentWorkTile lang={lang} />
					<ExperimentTile lang={lang} />
				</div>
				<TileLabel>no link</TileLabel>
				<div class="editorial-grid" data-editorial-case="no-link">
					<CurrentWorkTile lang={lang} entry={{ ...currentWork, link: undefined }} />
					<ExperimentTile lang={lang} entry={{ ...experiment, link: undefined }} />
				</div>
				<TileLabel>long titles and tags</TileLabel>
				<div class="editorial-grid" data-editorial-case="long">
					<CurrentWorkTile lang={lang} entry={{
						...currentWork,
						title: currentWork.title.repeat(8),
						tags: [...currentWork.tags, 'TypeScript'.repeat(8)],
					}} />
					<ExperimentTile lang={lang} entry={{ ...experiment, title: experiment.title.repeat(8) }} />
				</div>
			</section>
		))}
	</section>
	<section class="github-examples" aria-label="GitHub activity examples">
		{LIVE_STATES.map((state) => (
			<div class="github-example" data-github-case={state}>
				<TileLabel>{state}</TileLabel>
				<GithubTile github={mockGithub(state)} />
			</div>
		))}
		<div class="github-example" data-github-case="quiet">
			<TileLabel>quiet year</TileLabel>
			<GithubTile github={mockQuietGithub()} />
		</div>
		<div class="github-example" data-github-case="live">
			<TileLabel>live endpoint</TileLabel>
			<GithubTile github={{ state: 'loading' }} endpoint="/api/github" />
		</div>
	</section>
	<section class="waka-examples" aria-label="Coding activity examples">
		{LIVE_STATES.map((state) => (
			<div class="waka-example" data-waka-case={state}>
				<TileLabel>{state}</TileLabel>
				<WakaTile waka={mockWaka(state)} />
			</div>
		))}
		<div class="waka-example" data-waka-case="empty">
			<TileLabel>empty week</TileLabel>
			<WakaTile waka={mockWakaWithoutLanguages()} />
		</div>
		<div class="waka-example" data-waka-case="empty-stale">
			<TileLabel>stale empty week</TileLabel>
			<WakaTile waka={mockWakaWithoutLanguages(0, 'stale')} />
		</div>
		<div class="waka-example" data-waka-case="filtered">
			<TileLabel>activity without code languages</TileLabel>
			<WakaTile waka={mockWakaWithoutLanguages(90)} />
		</div>
		<div class="waka-example" data-waka-case="zero-shares">
			<TileLabel>rounded zero language shares</TileLabel>
			<WakaTile waka={{
				state: 'ok',
				data: { ...mockWakaWithoutLanguages(90).data!, languages: [{ name: 'TypeScript', percent: 0 }] },
			}} />
		</div>
		<div class="waka-example" data-waka-case="live">
			<TileLabel>live endpoint</TileLabel>
			<WakaTile waka={{ state: 'loading' }} endpoint="/api/waka" />
		</div>
	</section>
	<section class="music-examples" aria-label="After-hours music examples">
		{LIVE_STATES.map((state) => (
			<div class="music-example" data-music-case={state}>
				<TileLabel>{state}</TileLabel>
				<MusicTile music={mockMusic(state)} />
			</div>
		))}
		<div class="music-example" data-music-case="last">
			<TileLabel>last played</TileLabel>
			<MusicTile music={mockMusicTrack({ nowPlaying: false })} />
		</div>
		<div class="music-example" data-music-case="no-cover">
			<TileLabel>missing cover</TileLabel>
			<MusicTile music={mockMusicTrack({ coverUrl: undefined })} />
		</div>
		<div class="music-example" data-music-case="long">
			<TileLabel>long metadata</TileLabel>
			<MusicTile music={mockMusicTrack({
				title: 'EverythingInItsRightPlace'.repeat(8),
				artist: 'Radiohead'.repeat(16),
				previewUrl: '/dev/music-preview.mp3',
			})} />
		</div>
		<div class="music-example" data-music-case="preview">
			<!-- The preview source is intercepted by browser QA. -->
			<TileLabel>preview</TileLabel>
			<MusicTile music={mockMusicTrack({ previewUrl: '/dev/music-preview.mp3' })} />
		</div>
		<div class="music-example" data-music-case="stale-now">
			<TileLabel>stale live payload</TileLabel>
			<MusicTile music={mockMusicTrack({ nowPlaying: true }, 'stale')} />
		</div>
		<div class="music-example" data-music-case="live">
			<TileLabel>live endpoint</TileLabel>
			<MusicTile music={{ state: 'loading' }} endpoint="/api/music" />
		</div>
	</section>
	<div class="gallery">
		{
			LIVE_STATES.map((state) => (
				<section class="state">
					<TileLabel>{state}</TileLabel>
					<DashboardTeaserTile weather={mockWeather(state)} music={mockMusic(state)} />
					<div class="pair">
						<WeatherTile weather={mockWeather(state)} air={mockAir(state)} />
						<EventTile />
					</div>
					<div class="low">
						<GithubTile github={mockGithub(state)} />
					</div>
					<div class="big">
						<HomelabTile
							stats={mockLab(state)}
							uptime={mockUptime(state)}
							traffic={mockTraffic(state)}
							dns={mockDns(state)}
						/>
					</div>
					<div class="wide">
						<WakaTile waka={mockWaka(state)} />
					</div>
					<div class="pair tall">
						<MusicTile music={mockMusic(state)} />
						<BooksTile books={mockBooks(state)} />
					</div>
					<div class="bar">
						<ServicesBarTile monitors={mockMonitors(state)} />
					</div>
					<div class="wide">
						<ServerTile stats={mockLab(state)} history={mockHistory(state)} containers={mockContainers(state)} />
					</div>
					<div class="pair">
						<BackupTile backup={mockBackup(state)} />
						<DeployTile deploy={mockDeploy(state)} />
					</div>
					<div class="wide">
						<SiteStatsTile site={mockSite(state)} />
					</div>
					<div class="pair">
						<GoalTile goal={{ state }} />
					</div>
					<div class="pair">
						<LessonsTile lessons={mockLessons(state)} />
						<ExpiringTile expiring={mockExpiring(state)} />
					</div>

				</section>
			))
		}
		<section class="state">
			<TileLabel>mixed sections</TileLabel>
			<div class="pair">
				<WeatherTile weather={mockWeather('ok')} air={mockAir('error')} />
				<WeatherTile weather={mockWeather('stale')} air={mockAir('ok')} />
			</div>
			<div class="big">
				<HomelabTile
					stats={mockLab('ok')}
					uptime={mockUptime('stale')}
					traffic={mockTraffic('error')}
					dns={mockDns('ok')}
				/>
			</div>
			<div class="pair">
				<BackupTile backup={mockBackup('ok', true)} />
				<ServerTile stats={mockLab('ok')} history={mockHistory('error')} containers={mockContainers('error')} />
			</div>
			<TileLabel>static</TileLabel>
			<div class="wide">
				<GoalEditTile />
			</div>

			<div class="big">
				<FeaturedTile />
			</div>
			<GoalTile />
			<div class="socials">
				<SocialTile brand="discord" />
				<SocialTile brand="instagram" />
				<SocialTile brand="github" />
				<SocialTile brand="linkedin" />
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.github-examples,
	.waka-examples,
	.music-examples {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--grid-gap);
		margin-bottom: var(--space-3xl);
	}

	.github-example,
	.waka-example,
	.music-example {
		display: grid;
		grid-template-rows: auto 1fr;
		gap: var(--space-sm);
	}

	@media (max-width: 1023px) {
		.github-examples,
		.waka-examples,
		.music-examples {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 639px) {
		.github-example,
		.waka-example {
			grid-column: span 2;
		}
	}

	.editorial-examples,
	.editorial-group {
		display: grid;
		gap: var(--space-lg);
	}

	.editorial-examples {
		margin-bottom: var(--space-3xl);
	}

	.editorial-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--grid-gap);
	}

	.editorial-grid > :global(.current-work-tile) {
		grid-column: span 2;
	}

	@media (min-width: 640px) {
		.editorial-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.editorial-grid > :global(.current-work-tile) {
			grid-column: span 4;
		}

		.editorial-grid > :global(.experiment-tile) {
			grid-column: span 2;
		}
	}

	@media (min-width: 1024px) {
		.editorial-grid {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}

	.gallery {
		display: grid;
		/* About two dashboard columns wide, so the boxes match the real areas. */
		grid-template-columns: repeat(auto-fill, minmax(var(--gallery-column), 1fr));
		gap: var(--grid-gap);
	}

	.state {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	/* Fixed boxes with the proportions of the dashboard areas at 1440×900, so
	   a tile that changes size between states is easy to spot. */
	.pair,
	.low,
	.wide,
	.big {
		display: grid;
	}

	/* Two 1×1 tiles side by side; `tall` makes them 1×2. */
	.pair {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--grid-gap-dense);
		aspect-ratio: 1.8;
	}

	.pair.tall {
		aspect-ratio: 0.9;
	}

	.low {
		aspect-ratio: 2.4;
	}

	/* The private services bar: one line across. */
	.bar {
		display: grid;
		aspect-ratio: 8;
	}

	.wide {
		aspect-ratio: 1.85;
	}

	.big {
		aspect-ratio: 0.9;
	}

	.socials {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: var(--size-social-row);
		gap: var(--grid-gap-dense);
	}
</style>
