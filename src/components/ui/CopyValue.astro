---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';

/**
 * One-click copy of an e-mail address or phone number with a "Copied ✓"
 * confirmation (koncept.md §3.1).
 *
 * The value never appears in the HTML: it ships base64-encoded and is
 * assembled in the browser, which keeps it away from simple scraping bots.
 * The same script also fills in every `a[data-mailto]`, `a[data-tel]` and
 * `a[data-whatsapp]` on the page, so those links stay hidden the same way.
 */
interface Props {
	/** Base64 of the value — `emailEncoded` / `phoneEncoded` from src/lib/contact.ts. */
	encoded: string;
	kind?: 'email' | 'phone';
	class?: string;
}

const { encoded, kind = 'email', class: className } = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
const labels = {
	email: { action: t('contact.copyEmail'), hidden: t('contact.emailHidden') },
	phone: { action: t('contact.copyPhone'), hidden: t('contact.phoneHidden') },
}[kind];
---

<button
	type="button"
	class:list={['copy-value', className]}
	data-copy-value={encoded}
	data-label-copied={t('contact.copied')}
	data-label-failed={t('contact.copyFailed')}
	aria-label={labels.action}
>
	<span class="copy-value-text" data-value-text>{labels.hidden}</span>
	<span class="copy-value-status" aria-live="polite">
		<span class="copy-value-idle">
			<Icon name="copy" size={14} />
			{t('contact.copy')}
		</span>
		<span class="copy-value-done">
			<Icon name="check" size={14} />
			<span data-status-text>{t('contact.copied')}</span>
		</span>
	</span>
</button>

<script>
	const decode = (value: string) => atob(value);

	/* navigator.clipboard only exists in secure contexts (https, localhost);
	   the textarea fallback covers plain-http previews such as a LAN address. */
	async function copyText(text: string) {
		if (navigator.clipboard && window.isSecureContext) {
			await navigator.clipboard.writeText(text);
			return;
		}
		const area = document.createElement('textarea');
		area.value = text;
		area.setAttribute('readonly', '');
		area.style.position = 'fixed';
		area.style.opacity = '0';
		document.body.append(area);
		area.select();
		const ok = document.execCommand('copy');
		area.remove();
		if (!ok) throw new Error('copy failed');
	}

	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-mailto]')) {
		link.href = `mailto:${decode(link.dataset.mailto!)}`;
	}

	/* tel: and wa.me want the bare number: digits, plus a leading + for tel:. */
	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-tel]')) {
		link.href = `tel:${decode(link.dataset.tel!).replace(/[^\d+]/g, '')}`;
	}

	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-whatsapp]')) {
		link.href = `https://wa.me/${decode(link.dataset.whatsapp!).replace(/\D/g, '')}`;
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-value]')) {
		const value = decode(button.dataset.copyValue!);
		const status = button.querySelector<HTMLElement>('[data-status-text]')!;
		button.querySelector('[data-value-text]')!.textContent = value;

		let timer: number | undefined;
		button.addEventListener('click', async () => {
			let copied = true;
			try {
				await copyText(value);
			} catch {
				copied = false;
			}
			status.textContent = copied ? button.dataset.labelCopied! : button.dataset.labelFailed!;
			button.dataset.state = copied ? 'done' : 'failed';
			clearTimeout(timer);
			timer = window.setTimeout(() => delete button.dataset.state, 2000);
		});
	}
</script>

<style>
	.copy-value {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		width: 100%;
		padding: var(--space-sm) var(--space-sm) var(--space-sm) var(--space-lg);
		border: 1px solid var(--border);
		border-radius: var(--radius-inset);
		background: var(--surface-inset);
		color: var(--text-muted);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: border-color var(--duration-hover) var(--ease-out);
	}

	.copy-value:hover {
		border-color: var(--border-hover);
	}

	.copy-value-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--size-label);
	}

	.copy-value-status {
		flex: none;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.copy-value-idle,
	.copy-value-done {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-2xs) var(--space-sm);
		border-radius: var(--radius-pill);
	}

	.copy-value-idle {
		color: var(--text-muted);
	}

	.copy-value:hover .copy-value-idle {
		color: var(--text);
	}

	/* Confirmation is an active state, so it takes the accent. */
	.copy-value-done {
		display: none;
		color: var(--accent);
		background: var(--accent-soft);
	}

	.copy-value[data-state] .copy-value-idle {
		display: none;
	}

	.copy-value[data-state] .copy-value-done {
		display: inline-flex;
	}

	/* No tick when the copy did not happen. */
	.copy-value[data-state='failed'] .copy-value-done :global(svg) {
		display: none;
	}
</style>
