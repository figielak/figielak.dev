---
/**
 * One labelled usage bar: `CPU  ████░░░░  23%`. The fill is neutral; red is
 * kept for problems (docs/koncept.md §5), so with `alertAt` the bar turns red once
 * the value reaches that percentage.
 */
interface Props {
	label: string;
	/** Percent, 0–100. */
	value: number;
	/** Shown instead of the percentage, e.g. `14.2 / 32 GB`. */
	detail?: string;
	/** Percent from which the bar is shown as a problem, e.g. a nearly full disk. */
	alertAt?: number;
}

const { label, value, detail, alertAt } = Astro.props;
const percent = Math.round(Math.min(100, Math.max(0, value)));
---

<div
	class="stat"
	data-alert-at={alertAt}
	data-alert={alertAt !== undefined && percent >= alertAt ? '' : undefined}
>
	<span class="stat-label" data-skeleton>{label}</span>
	<span
		class="stat-track"
		role="meter"
		aria-label={label}
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow={percent}
	>
		<span class="stat-fill" style={`width: ${percent}%`}></span>
	</span>
	<span class="stat-value" data-skeleton aria-live="polite">{detail ?? `${percent}%`}</span>
</div>

<style>
	.stat {
		display: grid;
		grid-template-columns: minmax(0, auto) 1fr;
		align-items: center;
		column-gap: var(--space-md);
		row-gap: var(--space-2xs);
	}

	.stat-label {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.stat-value {
		justify-self: end;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.stat-track {
		grid-column: 1 / -1;
		grid-row: 2;
		display: block;
		height: var(--size-bar);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.stat-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--text-muted);
	}

	/* Dashboard intro: the bar grows from zero once its tile is in. */
	:global(.tile[data-reveal]) .stat-fill {
		transform-origin: left;
		animation: stat-grow var(--duration-grow) var(--ease-out) both;
	}

	@keyframes stat-grow {
		from {
			transform: scaleX(0);
		}
	}

	.stat[data-alert] .stat-fill {
		background: var(--status-down);
	}
</style>
