---
/**
 * A row of equal cards inside a dossier section — a small bento within the
 * stream. Cards keep their HTML order on every breakpoint, so plain columns
 * are enough here and no grid-template-areas are needed.
 *
 * Phones get two columns, never one (docs/koncept.md §7); an odd last card spans
 * both so the row closes cleanly.
 */
interface Props {
	columns?: 2 | 3;
}

const { columns = 3 } = Astro.props;
---

<div class="card-grid" data-columns={columns}><slot /></div>

<style>
	.card-grid {
		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		gap: var(--grid-gap);
	}

	.card-grid[data-columns='2'] {
		--columns: 2;
	}

	.card-grid[data-columns='3'] {
		--columns: 3;
	}

	@media (max-width: 639px) {
		.card-grid[data-columns] {
			--columns: 2;
		}

		.card-grid > :global(:last-child:nth-child(odd)) {
			grid-column: span 2;
		}
	}
</style>
