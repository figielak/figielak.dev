---
/**
 * The big mono number of a dashboard tile (koncept.md §6), with an optional
 * unit or caption under it. It shrinks with its container, so it fits a
 * 1×1 tile at any width — so it needs a parent that gives it a width
 * (block, stretched flex item or grid cell), not a shrink-to-fit one.
 */
interface Props {
	value: string | number;
	caption?: string;
	class?: string;
}

const { value, caption, class: className } = Astro.props;
---

<p class:list={['big', className]}>
	<span class="big-value" data-skeleton aria-live="polite">{value}</span>
	{caption && <span class="big-caption" data-skeleton>{caption}</span>}
</p>

<style>
	.big {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2xs);
		min-width: 0;
		margin: 0;
		container-type: inline-size;
	}

	.big-value {
		font-family: var(--font-mono);
		font-size: min(var(--size-number), 26cqi);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.big-caption {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}
</style>
