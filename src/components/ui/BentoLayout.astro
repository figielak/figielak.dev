---
/**
 * The bento grid (koncept.md §7).
 *
 * Every breakpoint gets its own explicit `grid-template-areas`, so tile order
 * never depends on the order of the markup. Phones always get two columns —
 * never a single stacked column.
 *
 * Areas are passed as arrays of rows, e.g.
 *   lg={['about about featured featured', 'exp skills skills social']}
 */
interface Breakpoint {
	areas: string[];
	columns: number;
	/** Track size for every row, e.g. `minmax(0, 1fr)` to fill a viewport. */
	rowSize?: string;
}

interface Props {
	/** < 640px — two columns by rule. */
	base: Breakpoint;
	/** 640–1023px */
	md: Breakpoint;
	/** >= 1024px */
	lg: Breakpoint;
	/** >= 1280px, optional — for a grid that needs more columns to fit one screen. */
	xl?: Breakpoint;
	dense?: boolean;
	/** Stretch to fill the remaining height of a flex parent. */
	fill?: boolean;
	/** With `fill` and `xl`: fit one screen only from 1440×900, not 1280×720. */
	tall?: boolean;
	class?: string;
}

const { base, md, lg, xl, dense = false, fill = false, tall = false, class: className } = Astro.props;

const toAreas = (rows: string[]) => rows.map((row) => `"${row}"`).join(' ');
const toColumns = (count: number) => `repeat(${count}, minmax(0, 1fr))`;
/* `grid-template-areas` defines the explicit rows, so they are sized here —
   `grid-auto-rows` would not reach them. */
const toRows = ({ areas, rowSize }: Breakpoint) =>
	rowSize ? `repeat(${areas.length}, ${rowSize})` : 'auto';

const vars = [
	`--areas-base: ${toAreas(base.areas)}`,
	`--columns-base: ${toColumns(base.columns)}`,
	`--rows-base: ${toRows(base)}`,
	`--areas-md: ${toAreas(md.areas)}`,
	`--columns-md: ${toColumns(md.columns)}`,
	`--rows-md: ${toRows(md)}`,
	`--areas-lg: ${toAreas(lg.areas)}`,
	`--columns-lg: ${toColumns(lg.columns)}`,
	`--rows-lg: ${toRows(lg)}`,
	...(xl
		? [`--areas-xl: ${toAreas(xl.areas)}`, `--columns-xl: ${toColumns(xl.columns)}`, `--rows-xl: ${toRows(xl)}`]
		: []),
].join('; ');
---

<div
	class:list={['bento', className]}
	data-dense={dense ? '' : undefined}
	data-fill={fill ? '' : undefined}
	data-xl={xl ? '' : undefined}
	data-tall={tall ? '' : undefined}
	style={vars}
>
	<slot />
</div>

<style>
	.bento {
		display: grid;
		gap: var(--grid-gap);
		grid-template-columns: var(--columns-base);
		grid-template-areas: var(--areas-base);
		grid-template-rows: var(--rows-base);
	}

	.bento[data-dense] {
		gap: var(--grid-gap-dense);
	}

	.bento[data-fill] {
		flex: 1;
		min-height: 0;
	}

	@media (min-width: 640px) {
		.bento {
			grid-template-columns: var(--columns-md);
			grid-template-areas: var(--areas-md);
			grid-template-rows: var(--rows-md);
		}
	}

	@media (min-width: 1024px) {
		.bento {
			grid-template-columns: var(--columns-lg);
			grid-template-areas: var(--areas-lg);
			grid-template-rows: var(--rows-lg);
		}
	}

	@media (min-width: 1280px) {
		.bento[data-xl] {
			grid-template-columns: var(--columns-xl);
			grid-template-areas: var(--areas-xl);
			grid-template-rows: var(--rows-xl);
		}
	}

	/* One screen on desktop (koncept.md §7): tiles stop sizing the rows by
	   their content, so the grid takes exactly the height the page leaves
	   and the rows split it. Smaller screens scroll as usual; a grid with an
	   xl layout fits one screen only from 1280px. */
	@media (min-width: 1024px) and (min-height: 720px) {
		.bento[data-fill]:not([data-xl]) > :global(*) {
			contain: size;
		}
	}

	@media (min-width: 1280px) and (min-height: 720px) {
		.bento[data-fill][data-xl]:not([data-tall]) > :global(*) {
			contain: size;
		}
	}

	/* A grid with more rows (the public dashboard) needs a taller screen;
	   below it the grid grows with its content and the page scrolls. */
	@media (min-width: 1280px) and (min-height: 860px) {
		.bento[data-fill][data-xl][data-tall] > :global(*) {
			contain: size;
		}
	}

	@media not all and (min-width: 1280px) and (min-height: 860px) {
		.bento[data-fill][data-tall] {
			min-height: auto;
		}
	}
</style>
