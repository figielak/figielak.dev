---
import Tile from './Tile.astro';
import LiveDot from './LiveDot.astro';
import IconLink from './IconLink.astro';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Identity card for the left column of a dossier (koncept.md §3.1): avatar,
 * name and role, status, location, bio, then the view's own actions and a
 * row of social icons. Each view decides what those say.
 */
export interface Social {
	label: string;
	icon: IconName;
	href?: string;
	external?: boolean;
	/** Extra attributes for the link, e.g. `data-mailto` filled in by CopyValue. */
	attrs?: Record<string, string>;
}

interface Props {
	name: string;
	role: string;
	status: string;
	/** Own line under the status; leave out when the role already names the place. */
	location?: string;
	bio: string;
	socials: readonly Social[];
	/** `lg` gives the photo more room, e.g. where parents want to see who teaches. */
	avatarSize?: 'md' | 'lg';
	/** Social icons in one row with the actions instead of a row of their own. */
	inlineSocials?: boolean;
}

const {
	name,
	role,
	status,
	location,
	bio,
	socials,
	avatarSize = 'md',
	inlineSocials = false,
} = Astro.props;

/* "Student · Data & Software Developer · Rzeszów": each part stays whole and
   the separator leads the next part, so a line never ends on a dot. */
const roleParts = role.split(' · ');

/* Rendered widths for 1x–3x screens; must match --size-avatar / --size-avatar-lg. */
const avatarPx = avatarSize === 'lg' ? 160 : 96;

/* Drop a square photo at src/assets/avatar.{jpg,png,webp,avif}; until one
   exists the card shows the empty placeholder frame. */
const avatarFiles = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/avatar.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const avatar = Object.values(avatarFiles)[0]?.default;
---

<Tile>
	<div class="profile">
		{
			avatar ? (
				<Image
					class="profile-avatar"
					data-size={avatarSize}
					src={avatar}
					alt={name}
					widths={[avatarPx, avatarPx * 2, avatarPx * 3]}
					sizes={`${avatarPx}px`}
					loading="eager"
				/>
			) : (
				<div class="profile-avatar" data-size={avatarSize} aria-hidden="true" />
			)
		}

		<div>
			<h1 class="profile-name">{name}</h1>
			<p class="profile-role">
				{
					roleParts.length > 1
						? roleParts.map((part, i) => (
								<>
									{i > 0 && ' '}
									<span class="profile-role-part">{i > 0 ? `· ${part}` : part}</span>
								</>
							))
						: role
				}
			</p>
		</div>

		<p class="profile-status">
			<LiveDot state="up" pulse />
			<span>{status}</span>
		</p>

		{location && <p class="profile-muted">{location}</p>}

		<p class="profile-muted">{bio}</p>

		{/* Inline: actions and icons share one wrapping row, the default slot
		    (e.g. the e-mail field) comes after it. Otherwise the wrapper is
		    transparent and the order is actions, default slot, icons. */}
		<div class="profile-links" data-inline={inlineSocials ? '' : undefined}>
			{
				Astro.slots.has('actions') && (
					<div class="profile-actions">
						<slot name="actions" />
					</div>
				)
			}

			{!inlineSocials && <slot />}

			<ul class="profile-socials">
				{
					socials.map((social) => (
						<li>
							<IconLink
								href={social.href}
								label={social.label}
								external={social.external}
								{...social.attrs}
							>
								<Icon name={social.icon} size={22} />
							</IconLink>
						</li>
					))
				}
			</ul>
		</div>

		{inlineSocials && <slot />}
	</div>
</Tile>

<style>
	.profile {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.profile-avatar {
		width: var(--size-avatar);
		height: var(--size-avatar);
		border-radius: var(--radius-inset);
		border: 1px solid var(--border);
		background: var(--surface-inset);
		object-fit: cover;
	}

	.profile-avatar[data-size='lg'] {
		width: var(--size-avatar-lg);
		height: var(--size-avatar-lg);
	}

	.profile-name {
		margin: 0;
		font-size: var(--size-hero);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.profile-role {
		margin: var(--space-2xs) 0 0;
		color: var(--text-muted);
	}

	.profile-role-part {
		white-space: nowrap;
	}

	/* A badge, not a plain line: it is the first thing a visitor looks for. */
	.profile-status {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		width: fit-content;
		margin: 0;
		padding: var(--space-2xs) var(--space-md);
		border: 1px solid var(--status-ok-border);
		border-radius: var(--radius-pill);
		background: var(--status-ok-soft);
		color: var(--text);
	}

	.profile-muted {
		margin: 0;
		color: var(--text-muted);
	}

	.profile-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.profile-socials {
		display: flex;
		gap: var(--space-sm);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.profile-links {
		display: contents;
	}

	/* Buttons and icons in one row: slimmer buttons at the icons' height, so
	   two buttons and two icons fit the 320px column. */
	.profile-links[data-inline] {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.profile-links[data-inline] .profile-actions {
		display: contents;
	}

	.profile-links[data-inline] .profile-actions :global(.button) {
		min-height: var(--size-icon-button);
		padding-inline: var(--space-lg);
	}
</style>
