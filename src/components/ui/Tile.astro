---
import TileLabel from './TileLabel.astro';
import Icon, { type IconName } from './Icon.astro';

/**
 * The one building block every tile is made of (koncept.md §4).
 * Layout inside a tile is always: label on top, content, detail or action at
 * the bottom. Clickable tiles get the ↗ affordance and the hover treatment.
 */
interface Props {
	/** Name of the `grid-template-areas` slot this tile occupies. */
	area?: string;
	label?: string;
	/** Small icon before the label, in the accent (koncept.md §4). */
	icon?: IconName;
	href?: string;
	external?: boolean;
	/** The ↗ of a clickable tile; off for tiles that are one big button (social). */
	arrow?: boolean;
	/** Full accent background — at most one or two tiles per view. */
	accent?: boolean;
	/** Denser padding, used by the dashboard. */
	dense?: boolean;
	class?: string;
	/** Anything else lands on the root element (data-*, aria-*, style...). */
	[key: string]: unknown;
}

const {
	area,
	label,
	icon,
	href,
	external = false,
	arrow = true,
	accent = false,
	dense = false,
	class: className,
	...rest
} = Astro.props;

const Tag = href ? 'a' : 'div';
const interactive = Boolean(href);
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
	class:list={['tile', className]}
	style={area ? `grid-area: ${area};` : undefined}
	data-interactive={interactive ? '' : undefined}
	data-accent={accent ? '' : undefined}
	data-dense={dense ? '' : undefined}
	href={href}
	{...externalAttrs}
	{...rest}
>
	{
		(label || Astro.slots.has('label') || (interactive && arrow)) && (
			<header class="tile-header">
				<span class="tile-title">
					{icon && <Icon name={icon} size={14} />}
					{label ? <TileLabel>{label}</TileLabel> : <slot name="label" />}
				</span>
				<span class="tile-header-end">
					<slot name="meta" />
					{interactive && arrow && (
						<svg
							class="tile-arrow"
							viewBox="0 0 24 24"
							width="14"
							height="14"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17 17 7M9 7h8v8" />
						</svg>
					)}
				</span>
			</header>
		)
	}

	<div class="tile-body"><slot /></div>

	{
		Astro.slots.has('footer') && (
			<footer class="tile-footer">
				<slot name="footer" />
			</footer>
		)
	}
</Tag>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		min-width: 0;
		padding: var(--tile-padding);
		border: 1px solid var(--border);
		border-radius: var(--radius-tile);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		overflow: hidden;
	}

	.tile[data-dense] {
		padding: var(--tile-padding-dense);
		gap: var(--space-md);
	}

	.tile[data-interactive] {
		transition:
			background-color var(--duration-hover) var(--ease-out),
			border-color var(--duration-hover) var(--ease-out),
			transform var(--duration-hover) var(--ease-out),
			box-shadow var(--duration-hover) var(--ease-out);
	}

	.tile[data-interactive]:hover {
		background: var(--surface-hover);
		border-color: var(--border-hover);
		transform: translateY(var(--lift));
		box-shadow: var(--shadow-tile);
	}

	/* Dashboard (BentoLayout `alive`): see-through tiles over the glow, and a
	   small hover on every tile — a border and 1px, less than a clickable one.
	   `:where` keeps the specificity of the plain rules, so the accent tile
	   below and the brand colours of the social tiles still win. */
	:global(:where([data-alive])) .tile {
		position: relative;
		background: var(--surface-glass);
		backdrop-filter: blur(var(--glass-blur));
	}

	/* Light on the edge around the cursor (src/scripts/spotlight.ts sets the
	   position per tile, so neighbours in reach light up too). A 1px ring just
	   inside the border — `overflow: hidden` clips anything on the border
	   itself. Not on the accent tile, where red would not show. */
	:global(:where([data-alive])) .tile:not([data-accent])::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		padding: 1px;
		border-radius: inherit;
		background: radial-gradient(
			var(--spotlight-size) circle at var(--spot-x, -100vmax) var(--spot-y, -100vmax),
			var(--spotlight),
			transparent
		);
		-webkit-mask:
			linear-gradient(var(--bg) 0 0) content-box,
			linear-gradient(var(--bg) 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(var(--bg) 0 0) content-box exclude,
			linear-gradient(var(--bg) 0 0);
		opacity: var(--spot-on, 0);
		pointer-events: none;
		transition: opacity var(--duration-hover) var(--ease-out);
	}

	:global(:where([data-alive])) .tile[data-interactive]:hover {
		background: var(--surface-glass-hover);
	}

	:global(:where([data-alive])) .tile:not([data-interactive]) {
		transition:
			border-color var(--duration-hover) var(--ease-out),
			transform var(--duration-hover) var(--ease-out);
	}

	:global(:where([data-alive])) .tile:not([data-interactive]):hover {
		border-color: var(--border-hover);
		transform: translateY(var(--lift-subtle));
	}

	/* Dashboard intro (src/scripts/intro.ts): hidden until it plays, then in
	   one by one along the diagonal — a little from below, and on desktop out
	   of a blur. */
	:global(:where([data-intro='pending']) :where([data-alive])) .tile {
		opacity: 0;
	}

	:global(:where([data-intro='run']) :where([data-alive])) .tile {
		animation: intro-tile var(--duration-intro) var(--ease-out) var(--intro-delay, 0ms) both;
	}

	@keyframes intro-tile {
		from {
			opacity: 0;
			transform: translateY(var(--intro-rise)) scale(0.98);
		}
	}

	@media (min-width: 1024px) {
		:global(:where([data-intro='run']) :where([data-alive])) .tile {
			animation-name: intro-tile-blur;
		}
	}

	@keyframes intro-tile-blur {
		from {
			opacity: 0;
			transform: translateY(var(--intro-rise)) scale(0.98);
			filter: blur(var(--intro-blur));
		}
	}

	/* A tile waiting for its data: a sheen sweeps over its skeleton. Only
	   transform moves; ::before is the cursor light. */
	.tile:has(:global(.live-body[data-live='loading'])) {
		position: relative;
	}

	.tile:has(:global(.live-body[data-live='loading']))::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(100deg, transparent 30%, var(--shimmer) 50%, transparent 70%);
		transform: translateX(-100%);
		animation: tile-shimmer var(--duration-shimmer) ease-in-out infinite;
		pointer-events: none;
	}

	@keyframes tile-shimmer {
		to {
			transform: translateX(100%);
		}
	}

	/* Full accent: the text tokens switch to the graphite that reads on it, so
	   what is inside the tile needs no idea it sits on the accent. */
	.tile[data-accent] {
		--text: var(--accent-foreground);
		--text-muted: var(--accent-foreground);
		--text-subtle: var(--accent-foreground-subtle);
		--surface-inset: var(--accent-inset);
		--status-down: var(--accent-foreground);
		--tile-icon: var(--accent-foreground);
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-foreground);
	}

	.tile[data-accent]:hover {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.tile-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.tile-title {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		min-width: 0;
		color: var(--tile-icon, var(--accent));
	}

	.tile-header-end {
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		color: var(--text-subtle);
	}

	.tile[data-interactive]:hover .tile-arrow {
		color: var(--text);
	}

	.tile-arrow {
		transition: color var(--duration-hover) var(--ease-out);
	}

	.tile-body {
		flex: 1;
		min-height: 0;
	}

	.tile-footer {
		color: var(--text-muted);
		font-size: var(--size-label);
	}

	@media (prefers-reduced-motion: reduce) {
		.tile[data-interactive]:hover {
			transform: none;
		}

		:global(:where([data-alive])) .tile:not([data-interactive]):hover {
			transform: none;
		}
	}
</style>
