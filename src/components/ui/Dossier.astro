---
/**
 * Two-column dossier: a pinned identity card on the left, a stream of
 * sections on the right. Used by the views that step outside the bento grid
 * on purpose — home and tutoring (koncept.md §3.1, §3.3).
 *
 * Below 1024px the columns stack and the card stops being sticky.
 */
---

<div class="dossier">
	<div class="dossier-profile"><slot name="profile" /></div>
	<div class="dossier-stream"><slot /></div>
</div>

<style>
	.dossier {
		display: grid;
		grid-template-columns: var(--dossier-profile-width) minmax(0, 1fr);
		gap: var(--grid-gap);
		align-items: start;
	}

	/* The identity card stays in view while the right column scrolls. */
	.dossier-profile {
		position: sticky;
		top: var(--grid-gap);
	}

	.dossier-stream {
		display: flex;
		flex-direction: column;
		gap: var(--grid-gap);
	}

	@media (max-width: 1023px) {
		.dossier {
			grid-template-columns: minmax(0, 1fr);
		}

		.dossier-profile {
			position: static;
		}
	}
</style>
