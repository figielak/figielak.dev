---
/**
 * Two-column dossier: a pinned identity card on the left, a stream of
 * sections on the right. Used by the views that step outside the bento grid
 * on purpose — home and tutoring (docs/koncept.md §3.1, §3.3).
 *
 * Below 1024px the columns stack and the card stops being sticky.
 */
interface Props {
	/** More air between sections, for calmer, less dense views. */
	relaxed?: boolean;
}

const { relaxed = false } = Astro.props;
---

<div class="dossier" data-relaxed={relaxed ? '' : undefined}>
	<div class="dossier-profile"><slot name="profile" /></div>
	<div class="dossier-stream"><slot /></div>
</div>

<style>
	.dossier {
		display: grid;
		grid-template-columns: var(--dossier-profile-width) minmax(0, 1fr);
		gap: var(--grid-gap);
		align-items: start;
	}

	/* The identity card stays in view while the right column scrolls. */
	.dossier-profile {
		position: sticky;
		top: var(--grid-gap);
	}

	.dossier-stream {
		display: flex;
		flex-direction: column;
		gap: var(--dossier-section-gap);
	}

	/* Read by DossierSection for its bottom padding, so the divider sits
	   midway between sections. */
	.dossier {
		--dossier-section-gap: var(--grid-gap);
	}

	.dossier[data-relaxed] {
		--dossier-section-gap: var(--space-3xl);
	}

	@media (max-width: 1023px) {
		.dossier {
			grid-template-columns: minmax(0, 1fr);
		}

		.dossier-profile {
			position: static;
		}
	}
</style>
