---
import { getLangFromUrl, useTranslations } from '../../i18n';
import type { LiveState } from '../../lib/live';

/**
 * Body of a live tile in any of its four states (koncept.md §9).
 *
 * The content is always rendered — with placeholder data while loading or on
 * error — so the tile keeps exactly the same size in every state:
 *   loading  every `[data-skeleton]` element turns into a skeleton block
 *   error    the content is hidden and a calm message sits in its place
 *
 * Tiles fed from /api/* start as `loading` and switch in the browser
 * (src/scripts/live.ts), so both messages are always in the markup.
 */
interface Props {
	state: LiveState;
	errorText: string;
	class?: string;
}

const { state, errorText, class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const hidden = state === 'loading' || state === 'error';
---

<div class:list={['live-body', className]} data-live={state}>
	<div class="live-content" aria-hidden={hidden ? 'true' : undefined}>
		<slot />
	</div>
	<span class="live-loading visually-hidden">{t('state.loading')}</span>
	<p class="live-error">{errorText}</p>
</div>

<style>
	.live-body {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.live-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-md);
		min-height: 0;
	}

	.live-body[data-live='error'] > .live-content {
		visibility: hidden;
	}

	.live-body:not([data-live='loading']) > .live-loading,
	.live-body:not([data-live='error']) > .live-error {
		display: none;
	}

	.live-error {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		color: var(--text-subtle);
		text-align: center;
	}

	.live-body[data-live='loading'] :global([data-skeleton]) {
		border-radius: var(--radius-inset);
		background: var(--surface-inset);
		color: transparent;
	}

	/* When the data comes in, it settles into the skeleton's place instead of
	   popping in (the tile's sheen marks the wait, see Tile). */
	.live-body:not([data-live='loading']) > .live-content,
	.live-body[data-live='error'] > .live-error {
		animation: live-in var(--duration-intro) var(--ease-out);
	}

	@keyframes live-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}
</style>
