---
import { getLangFromUrl, useTranslations } from '../../i18n';
import { minutesSince, type Live } from '../../lib/live';

/**
 * Footer line of a live tile: "3 min ago" — short, so it fits a 1×1 tile —
 * and an optional detail passed in the slot. Rendered in every state and only hidden, so the tile never changes
 * height (koncept.md §9).
 */
interface Props {
	live: Live<object>;
	/** Only show the line once the data is stale — for a section of a larger tile. */
	staleOnly?: boolean;
}

const { live, staleOnly = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const template = t('state.ago');
const text = live.data ? template.replace('{n}', String(minutesSince(live.data.updatedAt))) : '';
---

<span class="live-footer" data-state={live.state} data-stale-only={staleOnly ? '' : undefined}>
	{Astro.slots.has('default') && <span class="live-footer-detail"><slot /></span>}
	<span class="live-footer-updated" data-template={template}>{text || '\u00a0'}</span>
</span>

<style>
	.live-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-subtle);
		white-space: nowrap;
	}

	.live-footer-detail {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--text-muted);
	}

	.live-footer-updated {
		margin-left: auto;
	}

	.live-footer:is([data-state='loading'], [data-state='error']),
	.live-footer[data-stale-only]:not([data-state='stale']) {
		visibility: hidden;
	}
</style>
