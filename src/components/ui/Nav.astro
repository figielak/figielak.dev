---
import Icon from './Icon.astro';
import { tutoringOpen } from '../../lib/tutoring';
import {
	defaultLang,
	getLangFromUrl,
	languages,
	localizePath,
	stripLang,
	useTranslations,
	type Lang,
} from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const current = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';

const items = [
	{ path: '/', key: 'nav.home' },
	{ path: '/projects', key: 'nav.projects' },
	{ path: '/dashboard', key: 'nav.dashboard' },
	{ path: '/maths', key: 'nav.maths' },
] as const;

/* /maths is Polish-only for now (koncept.md §11), so it never takes a prefix
   and there is no other language to switch to while on it. */
const polishOnly: string[] = ['/maths'];
const hrefFor = (path: string) => (polishOnly.includes(path) ? path : localizePath(path, lang));
const canSwitchLang = !polishOnly.includes(current);

/* A view that is not open yet stays in the pill, greyed out and not a link. */
const isSoon = (path: string) => path === '/maths' && !tutoringOpen;

const isActive = (path: string) => current === path || current.startsWith(`${path}/`);

/* The language switch keeps the reader on the same view. */
const otherLangs = (Object.keys(languages) as Lang[]).filter((code) => code !== lang);
---

<nav class="nav" aria-label={t('nav.label')}>
	{/* A prompt-like wordmark: the name and a blinking cursor in the accent. */}
	<a class="nav-brand" href={localizePath('/', lang)} aria-label="figielak">
		figielak<span class="nav-brand-cursor" aria-hidden="true">_</span>
	</a>

	<ul class="nav-items">
		{
			items.map((item) => (
				<li>
					{isSoon(item.path) ? (
						<span class="nav-link" data-soon aria-disabled="true" title={t('nav.soonTitle')}>
							{t(item.key)}
							<span class="nav-soon">{t('nav.soon')}</span>
						</span>
					) : (
					<a
						href={hrefFor(item.path)}
						class="nav-link"
						data-intro-replay={item.path === '/dashboard' ? '' : undefined}
						data-active={isActive(item.path) ? '' : undefined}
						aria-current={isActive(item.path) ? 'page' : undefined}
					>
						{t(item.key)}
					</a>
					)}
				</li>
			))
		}
	</ul>

	<div class="nav-end">
		{
			otherLangs.map((code) =>
				canSwitchLang ? (
					<a
						class="nav-control"
						href={code === defaultLang ? current : localizePath(current, code)}
						hreflang={code}
						aria-label={t('nav.language')}
					>
						{languages[code]}
					</a>
				) : (
					<button
						class="nav-control"
						type="button"
						disabled
						title={t('nav.languageUnavailable')}
						aria-label={t('nav.languageUnavailable')}
					>
						{languages[code]}
					</button>
				),
			)
		}

		{/* The only way into the terminal on touch screens (koncept.md §8). */}
		<button
			class="nav-control"
			type="button"
			data-terminal-toggle
			aria-expanded="false"
			aria-label={t('term.open')}
			title={t('term.open')}
		>
			<Icon name="terminal" size={16} />
		</button>

		<button
			class="nav-control"
			type="button"
			disabled
			aria-label={t('nav.theme')}
			title={t('nav.theme')}
		>
			<svg
				viewBox="0 0 24 24"
				width="16"
				height="16"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
			</svg>
		</button>
	</div>
</nav>

<script>
	/* A click on Dashboard plays its intro again (src/scripts/intro.ts),
	   which otherwise runs once per session. */
	for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-intro-replay]')) {
		link.addEventListener('click', () => {
			try {
				sessionStorage.removeItem(`intro:${new URL(link.href).pathname.replace(/\/$/, '')}`);
			} catch {}
		});
	}
</script>

<style>
	/*
	 * Three separate pieces on the page background: wordmark left, link pill
	 * centred, controls right. Only the two groups carry a border — the bar
	 * itself is transparent.
	 */
	.nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		grid-template-areas: 'brand items end';
		align-items: center;
		gap: var(--grid-gap);
		width: var(--nav-width);
		min-width: min(100% - 2 * var(--page-gutter), var(--nav-min-width));
		margin: 0 auto;
		padding: var(--grid-gap) 0;
	}

	.nav-brand {
		grid-area: brand;
		justify-self: start;
		font-family: var(--font-sans);
		font-size: var(--size-title);
		font-weight: 900;
		letter-spacing: -0.015em;
		color: var(--text);
		text-decoration: none;
		transition: color var(--duration-hover) var(--ease-out);
	}

	.nav-brand:hover {
		color: var(--accent);
	}

	.nav-brand-cursor {
		color: var(--accent);
		animation: brand-blink var(--duration-blink) steps(1) infinite;
	}

	/* While the intro types the name, the cursor holds still. */
	.nav-brand[data-typing] .nav-brand-cursor {
		animation: none;
	}

	@keyframes brand-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-brand-cursor {
			animation: none;
		}
	}

	/* The two bordered groups share one shape. */
	.nav-items,
	.nav-end {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-2xs);
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
	}

	.nav-items {
		grid-area: items;
		justify-self: center;
		margin: 0;
		list-style: none;
		max-width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-items::-webkit-scrollbar {
		display: none;
	}

	.nav-end {
		grid-area: end;
		justify-self: end;
	}

	.nav-link {
		display: block;
		padding: var(--space-xs) var(--nav-link-padding-x);
		border-radius: var(--radius-pill);
		font-size: var(--size-body);
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--text);
		background: var(--surface-hover);
	}

	/* Not open yet: no hover, a quiet mono tag instead (src/lib/tutoring.ts). */
	.nav-link[data-soon] {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-2xs);
		color: var(--text-subtle);
		cursor: default;
	}

	.nav-link[data-soon]:hover {
		color: var(--text-subtle);
		background: transparent;
	}

	/* Phones have no room for the tag in the pill; the grey says enough there. */
	.nav-soon {
		display: none;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	@media (min-width: 640px) {
		.nav-soon {
			display: inline;
		}
	}

	/* The current page: the accent, see-through, so it sits with the glow. */
	.nav-link[data-active] {
		color: var(--text);
		background: var(--nav-active);
	}

	.nav-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: var(--size-nav-control);
		min-width: calc(var(--size-nav-control) + var(--space-2xs));
		padding: 0 var(--space-sm);
		border: 0;
		border-radius: var(--radius-pill);
		background: transparent;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		color: var(--text-muted);
		text-decoration: none;
		cursor: pointer;
		transition:
			color var(--duration-hover) var(--ease-out),
			background-color var(--duration-hover) var(--ease-out);
	}

	.nav-control:hover:not(:disabled) {
		color: var(--text);
		background: var(--surface-hover);
	}

	/* Only one theme exists so far (koncept.md §12) — the control stays in place
	   but inert until a second set of token values lands. */
	.nav-control:disabled {
		cursor: default;
		color: var(--text-subtle);
	}

	/* Phones cannot fit three groups side by side: the wordmark and the controls
	   share the top row, the link pill takes the one below. */
	@media (max-width: 639px) {
		.nav-items {
			justify-self: stretch;
		}

		.nav {
			grid-template-columns: auto auto;
			grid-template-areas:
				'brand end'
				'items items';
			justify-content: space-between;
			row-gap: var(--space-sm);
		}
	}
</style>
