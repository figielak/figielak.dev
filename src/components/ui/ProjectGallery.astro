---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';

/**
 * Screenshots on a project's detail page (docs/koncept.md §3.2): a sideways
 * strip like the featured carousel on the home page — the next shot peeks in,
 * ‹ › and the counter under it, swipe and arrow keys on the focused strip —
 * with every shot in the same frame and its caption underneath.
 * Each shot links to its full-size file, so it opens without JS; with JS the
 * link opens a lightbox (native <dialog>) with ‹ ›, arrow keys and Esc, and
 * focus goes back to the shot shown last.
 */
interface Props {
	items: { image: ImageMetadata; caption: string }[];
	/** Accessible name of the strip and the lightbox. */
	label: string;
}

const SHOT_WIDTHS = [480, 720, 960, 1440];
const FULL_WIDTH = 2400;

const { items, label } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const shots = await Promise.all(
	items.map(async (item) => ({
		...item,
		full: await getImage({ src: item.image, width: Math.min(item.image.width, FULL_WIDTH), format: 'webp' }),
	})),
);
const many = shots.length > 1;
---

{
	shots.length > 0 && (
		<div class="gallery" data-gallery>
			<ul class="track" tabindex={many ? 0 : undefined} aria-label={label} data-single={many ? undefined : ''}>
				{shots.map((shot, i) => (
					<li class="slide">
						<figure>
							<a
								class="shot"
								href={shot.full.src}
								data-index={i}
								data-caption={shot.caption}
								aria-label={t('gallery.open').replace('{caption}', shot.caption)}
							>
								<Image
									src={shot.image}
									alt={shot.caption}
									widths={SHOT_WIDTHS}
									sizes="(min-width: 1024px) 840px, 90vw"
									loading={i === 0 ? 'eager' : 'lazy'}
								/>
							</a>
							<figcaption>{shot.caption}</figcaption>
						</figure>
					</li>
				))}
			</ul>
			{many && (
				<div class="controls">
					<span class="counter" aria-hidden="true">
						<span class="counter-current">1</span> / {shots.length}
					</span>
					<span class="buttons">
						<button type="button" class="control" data-step="-1" aria-label={t('gallery.prev')} disabled>
							<Icon name="chevron-left" size={18} />
						</button>
						<button type="button" class="control" data-step="1" aria-label={t('gallery.next')}>
							<Icon name="chevron-right" size={18} />
						</button>
					</span>
				</div>
			)}
			<dialog class="lightbox" aria-label={label}>
				<figure class="lightbox-figure">
					<img class="lightbox-img" alt="" />
					<figcaption class="lightbox-bar">
						<span class="lightbox-caption" />
						<span class="buttons">
							{many && (
								<>
									<span class="counter" aria-hidden="true">
										<span class="lightbox-current">1</span> / {shots.length}
									</span>
									<button type="button" class="control" data-lightbox-step="-1" aria-label={t('gallery.prev')}>
										<Icon name="chevron-left" size={18} />
									</button>
									<button type="button" class="control" data-lightbox-step="1" aria-label={t('gallery.next')}>
										<Icon name="chevron-right" size={18} />
									</button>
								</>
							)}
							<button type="button" class="control" data-lightbox-close aria-label={t('gallery.close')}>
								<Icon name="x" size={18} />
							</button>
						</span>
					</figcaption>
				</figure>
			</dialog>
		</div>
	)
}

<script>
	for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
		const track = gallery.querySelector<HTMLElement>('.track');
		const dialog = gallery.querySelector<HTMLDialogElement>('.lightbox');
		const image = gallery.querySelector<HTMLImageElement>('.lightbox-img');
		const caption = gallery.querySelector<HTMLElement>('.lightbox-caption');
		if (!track || !dialog || !image || !caption) continue;

		const slides = [...track.children] as HTMLElement[];
		const links = [...track.querySelectorAll<HTMLAnchorElement>('.shot')];
		const current = gallery.querySelector<HTMLElement>('.counter-current');
		const lightboxCurrent = gallery.querySelector<HTMLElement>('.lightbox-current');
		const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('.controls .control')];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let shown = 0;

		/* The same measure as the home carousel: the slide nearest the strip's
		   left edge, or the last one at the end of the scroll. */
		const index = () => {
			if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 1) return slides.length - 1;
			const left = track.getBoundingClientRect().left;
			let best = 0;
			slides.forEach((slide, i) => {
				const distance = Math.abs(slide.getBoundingClientRect().left - left);
				if (distance < Math.abs(slides[best].getBoundingClientRect().left - left)) best = i;
			});
			return best;
		};

		const scrollTo = (i: number, smooth: boolean) =>
			track.scrollTo({
				left: slides[i].offsetLeft - slides[0].offsetLeft,
				behavior: smooth && !reduced.matches ? 'smooth' : 'auto',
			});

		const update = () => {
			const i = index();
			if (current) current.textContent = String(i + 1);
			buttons.forEach((button) => {
				button.disabled = Number(button.dataset.step) < 0 ? i === 0 : i === slides.length - 1;
			});
		};

		for (const button of buttons) {
			button.addEventListener('click', () => {
				scrollTo(Math.min(Math.max(index() + Number(button.dataset.step), 0), slides.length - 1), true);
			});
		}
		track.addEventListener('scroll', update, { passive: true });
		update();

		/* Lightbox: wraps around, unlike the strip, so ‹ › never go dead. */
		const show = (i: number) => {
			shown = (i + links.length) % links.length;
			const link = links[shown];
			image.src = link.href;
			image.alt = link.dataset.caption ?? '';
			caption.textContent = link.dataset.caption ?? '';
			if (lightboxCurrent) lightboxCurrent.textContent = String(shown + 1);
		};

		links.forEach((link, i) => {
			link.addEventListener('click', (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
				event.preventDefault();
				show(i);
				dialog.showModal();
				document.documentElement.style.overflow = 'hidden';
			});
		});

		for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-lightbox-step]')) {
			button.addEventListener('click', () => show(shown + Number(button.dataset.lightboxStep)));
		}
		dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

		dialog.addEventListener('keydown', (event) => {
			if (links.length < 2) return;
			if (event.key === 'ArrowLeft') show(shown - 1);
			else if (event.key === 'ArrowRight') show(shown + 1);
			else return;
			event.preventDefault();
		});

		/* A click on the backdrop lands on the dialog itself, not on the figure. */
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		/* Back on the page: the strip shows the last shot seen and focus is on it. */
		dialog.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
			scrollTo(shown, false);
			links[shown].focus({ preventScroll: true });
		});
	}
</script>

<style>
	.track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: var(--project-slide-width);
		gap: var(--grid-gap);
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.track[data-single] {
		grid-auto-columns: 100%;
	}

	.track:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: var(--radius-tile);
	}

	.slide {
		min-width: 0;
		scroll-snap-align: start;
	}

	figure {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		margin: 0;
	}

	/* Every shot in the same frame, whatever its own shape: letterboxed, never cropped. */
	.shot {
		display: block;
		aspect-ratio: var(--project-shot-ratio);
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-tile);
		background: var(--surface-inset);
		cursor: zoom-in;
		transition: border-color var(--duration-hover) var(--ease-out);
	}

	.shot:hover {
		border-color: var(--border-hover);
	}

	.shot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	figcaption {
		font-size: var(--size-small);
		color: var(--text-muted);
	}

	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: var(--space-md);
	}

	.counter {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text-muted);
	}

	.counter-current,
	.lightbox-current {
		color: var(--text);
	}

	.buttons {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
	}

	.control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size-carousel-control);
		height: var(--size-carousel-control);
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--duration-hover) var(--ease-out),
			border-color var(--duration-hover) var(--ease-out),
			background-color var(--duration-hover) var(--ease-out);
	}

	.control:hover:not(:disabled) {
		color: var(--text);
		border-color: var(--border-hover);
		background: var(--surface-hover);
	}

	.control:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.lightbox {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: var(--page-gutter);
		border: 0;
		background: transparent;
		color: var(--text);
	}

	.lightbox::backdrop {
		background: var(--scrim);
		backdrop-filter: blur(var(--glass-blur));
	}

	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox-figure {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		max-width: 100%;
		max-height: 100%;
	}

	.lightbox-img {
		display: block;
		min-height: 0;
		max-width: 100%;
		max-height: calc(100dvh - 2 * var(--page-gutter) - var(--size-carousel-control) - var(--space-md));
		margin: 0 auto;
		object-fit: contain;
		border: 1px solid var(--border);
		border-radius: var(--radius-tile);
		background: var(--surface-inset);
	}

	.lightbox-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.lightbox-caption {
		min-width: 0;
		color: var(--text);
	}
</style>
