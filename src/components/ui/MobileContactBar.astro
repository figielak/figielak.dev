---
/**
 * Phone-only bar pinned to the bottom of the screen with the two actions a
 * parent is most likely to want: book the free lesson and call. It slides
 * away while the target section (the contact block) is on screen, where the
 * same actions are already visible.
 *
 * The tel: link is filled in by CopyValue's script from `data-tel`, so the
 * page must also render a CopyValue.
 */
interface Props {
	/** id of the section the primary action jumps to; hides the bar while visible. */
	target: string;
	primaryLabel: string;
	callLabel: string;
	/** Base64 phone number — `phoneEncoded` from src/lib/contact.ts. */
	phoneEncoded: string;
}

const { target, primaryLabel, callLabel, phoneEncoded } = Astro.props;
---

<div class="mobile-bar" data-mobile-bar data-target={target}>
	<a class="button button-primary" href={`#${target}`}>{primaryLabel}</a>
	<a class="button" data-tel={phoneEncoded}>{callLabel}</a>
</div>

<script>
	for (const bar of document.querySelectorAll<HTMLElement>('[data-mobile-bar]')) {
		const target = document.getElementById(bar.dataset.target!);
		if (!target) continue;

		new IntersectionObserver(([entry]) => {
			const hidden = entry.isIntersecting;
			bar.toggleAttribute('data-hidden', hidden);
			bar.toggleAttribute('inert', hidden);
		}).observe(target);
	}
</script>

<style>
	.mobile-bar {
		display: none;
	}

	@media (max-width: 639px) {
		.mobile-bar {
			position: fixed;
			inset: auto 0 0;
			z-index: 10;
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: var(--space-sm);
			min-height: var(--size-mobile-bar);
			padding: var(--space-lg) var(--page-gutter) calc(var(--space-lg) + env(safe-area-inset-bottom));
			border-top: 1px solid var(--border);
			background: var(--surface);
			transition: transform var(--duration-hover) var(--ease-out);
		}

		.mobile-bar[data-hidden] {
			transform: translateY(100%);
		}

		/* Keep the end of the page clear of the bar. */
		:global(body) {
			padding-bottom: calc(var(--size-mobile-bar) + env(safe-area-inset-bottom));
		}
	}
</style>
