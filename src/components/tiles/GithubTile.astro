---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { githubUrl } from '../../lib/contact';
import { dotState } from '../../lib/live';
import { GITHUB_PLACEHOLDER, type Github } from '../../lib/mocks/github';

/**
 * A contribution total for the past year and its full 53-week heatmap,
 * cached 1 h (docs/architecture.md §3). Activity is supporting context;
 * repository and streak fields stay in the API for other clients.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `github` as given (mocks in /dev/tiles).
 */
interface Props {
	github: Github;
	endpoint?: string;
	area?: string;
}

/* The API refreshes hourly, so an hour-old answer is still fresh. */
const STALE_AFTER_MIN = 3 * 60;

const { github, endpoint, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = github.data ?? GITHUB_PLACEHOLDER;

const summaryTemplate = t('github.summary');
---

<Tile
	area={area}
	label={t('tile.github')}
	icon="github"
	href={githubUrl}
	external
	dense
	class="github-tile"
	data-endpoint={endpoint}
	data-stale-after={STALE_AFTER_MIN}
>
	<LiveDot slot="meta" state={dotState(github.state)} />

	<LiveBody state={github.state} errorText={t('github.unavailable')}>
		<div class="github">
			<p class="github-stat">
				<span class="github-value tile-value" data-skeleton data-count aria-live="polite">{d.contributions}</span>
				<span class="github-label" data-skeleton>{t('github.contributions')}</span>
			</p>

			<div
				class="contrib"
				role="img"
				aria-label={summaryTemplate.replace('{n}', String(d.contributions))}
				data-summary-template={summaryTemplate}
			>
				{
					d.weeks.map((week, col) => (
						<span class="contrib-week" style={`--col: ${col}`}>
							{week.map((level) => (
								<span class="contrib-day" data-level={github.state === 'loading' ? 0 : level} />
							))}
						</span>
					))
				}
			</div>
			<div class="github-footer">
				<span class="contrib-legend" aria-hidden="true">
					{t('github.less')}
					{[0, 1, 2, 3, 4].map((level) => <span class="contrib-day" data-level={level} />)}
					{t('github.more')}
				</span>
				<LiveFooter live={github} staleOnly />
			</div>
		</div>
	</LiveBody>
	<span slot="footer">{t('github.profile')} ↗</span>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import type { GithubData } from '../../lib/server/github';

	for (const tile of document.querySelectorAll<HTMLElement>('.github-tile[data-endpoint]')) {
		watchLive<GithubData>(tile, (data) => {
			setText(tile.querySelector('.github-value'), String(data.contributions));
			const chart = tile.querySelector<HTMLElement>('.contrib');
			if (chart) {
				const summary = (chart.dataset.summaryTemplate ?? '').replace('{n}', String(data.contributions));
				chart.setAttribute('aria-label', summary);
			}

			const days = tile.querySelectorAll('.contrib .contrib-day');
			data.weeks.flat().forEach((level, i) => days[i]?.setAttribute('data-level', String(level)));
		});
	}
</script>

<style>
	/* Reserve the same footprint for a quiet year, skeleton and unavailable data. */
	.github {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-sm);
		height: 100%;
		min-height: calc(var(--dashboard-row-min) + var(--space-3xl));
		min-width: 0;
	}

	.github-stat {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2xs);
		margin: 0;
	}

	.github-value {
		min-width: 4ch;
	}

	.github-label {
		color: var(--text-muted);
	}

	.contrib {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: var(--space-3xs);
		min-width: 0;
	}

	.contrib-week {
		display: grid;
		grid-template-rows: repeat(7, auto);
		gap: var(--space-3xs);
	}

	.contrib-day {
		display: block;
		aspect-ratio: 1;
		border-radius: var(--space-3xs);
		background: var(--surface-inset);
	}

	.contrib-day[data-level='1'] {
		background: var(--contrib-level-1);
	}
	.contrib-day[data-level='2'] {
		background: var(--contrib-level-2);
	}
	.contrib-day[data-level='3'] {
		background: var(--contrib-level-3);
	}
	.contrib-day[data-level='4'] {
		background: var(--contrib-level-4);
	}

	.github-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	.contrib-legend {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	.contrib-legend .contrib-day {
		width: var(--size-label);
	}

	.github-footer > :global(.live-footer),
	:global(.github-tile .live-body .live-error) {
		color: var(--text-muted);
	}

	/* Dashboard intro: the chart lights up in a wave from the left, one
	   column (week) after another. */
	:global(.tile[data-reveal]) .contrib .contrib-day {
		animation: contrib-in var(--duration-grow) var(--ease-out) both;
		animation-delay: calc(var(--col) * var(--intro-cell-step));
	}

	@keyframes contrib-in {
		from {
			opacity: 0;
			transform: scale(0.4);
		}
	}
</style>
