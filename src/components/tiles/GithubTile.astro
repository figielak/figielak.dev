---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { githubUrl } from '../../lib/contact';
import { dotState } from '../../lib/live';
import { GITHUB_PLACEHOLDER, type Github } from '../../lib/mocks/github';

/**
 * Contribution chart and headline numbers from the GitHub GraphQL API,
 * cached 1 h (koncept.md §9): the numbers, the legend and "updated … ago" in
 * one row on top — no footer, so the year's chart under them gets the height
 * of a low tile — and the chart across the whole width, in four accent levels.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `github` as given (mocks in /dev/tiles).
 */
interface Props {
	github: Github;
	endpoint?: string;
	area?: string;
}

/* The API refreshes hourly, so an hour-old answer is still fresh. */
const STALE_AFTER_MIN = 3 * 60;

const { github, endpoint, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = github.data ?? GITHUB_PLACEHOLDER;

const stats = [
	{ value: d.contributions, label: t('github.contributions') },
	{ value: d.streakDays, label: t('github.streak') },
	{ value: d.repos, label: t('github.repos') },
];
---

<Tile
	area={area}
	label={t('tile.github')}
	icon="github"
	href={githubUrl}
	external
	dense
	class="github-tile"
	data-endpoint={endpoint}
	data-stale-after={STALE_AFTER_MIN}
>
	<LiveDot slot="meta" state={dotState(github.state)} />

	<LiveBody state={github.state} errorText={t('github.unavailable')}>
		<div class="github">
			<div class="github-top">
				<dl class="github-stats">
					{
						stats.map((stat) => (
							<div class="github-stat">
								<dt class="github-label">{stat.label}</dt>
								<dd class="github-value" data-skeleton aria-live="polite">
									{stat.value}
								</dd>
							</div>
						))
					}
				</dl>
				<LiveFooter live={github}>
					<span class="contrib-legend">
						{t('github.less')}
						{[0, 1, 2, 3, 4].map((level) => <span class="contrib-day" data-level={level} />)}
						{t('github.more')}
					</span>
				</LiveFooter>
			</div>

			<div class="contrib" aria-hidden="true">
				{
					d.weeks.map((week) => (
						<span class="contrib-week">
							{week.map((level) => (
								<span class="contrib-day" data-level={github.state === 'loading' ? 0 : level} />
							))}
						</span>
					))
				}
			</div>
		</div>
	</LiveBody>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import type { GithubData } from '../../lib/server/github';

	for (const tile of document.querySelectorAll<HTMLElement>('.github-tile[data-endpoint]')) {
		watchLive<GithubData>(tile, (data) => {
			const values = tile.querySelectorAll('.github-value');
			[data.contributions, data.streakDays, data.repos].forEach((n, i) => setText(values[i], String(n)));

			const days = tile.querySelectorAll('.contrib .contrib-day');
			data.weeks.flat().forEach((level, i) => days[i]?.setAttribute('data-level', String(level)));
		});
	}
</script>

<style>
	/* A wide, low tile: the numbers in one row, the chart across under them. */
	.github {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-lg);
		height: 100%;
		min-width: 0;
	}

	.github-top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2xs) var(--space-2xl);
		flex: none;
	}

	.github-top > :global(.live-footer) {
		flex: 1;
	}

	.github-stats {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2xs) var(--space-2xl);
		margin: 0;
		flex: none;
	}

	/* Number, then its label on the same line (the markup keeps dt before dd),
	   so the row stays one line high and the chart gets the height. */
	.github-stat {
		display: flex;
		flex-direction: row-reverse;
		align-items: baseline;
		gap: var(--space-xs);
	}

	.github-value {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--size-title);
		font-weight: 700;
		line-height: 1.2;
		font-variant-numeric: tabular-nums;
	}


	.github-label {
		white-space: nowrap;
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	.contrib {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: var(--size-contrib-gap);
		min-width: 0;
	}

	.contrib-week {
		display: grid;
		grid-template-rows: repeat(7, auto);
		gap: var(--size-contrib-gap);
	}

	.contrib-day {
		display: block;
		aspect-ratio: 1;
		border-radius: var(--space-2xs);
		background: var(--surface-inset);
	}

	.contrib-day[data-level='1'] {
		background: var(--accent-level-1);
	}
	.contrib-day[data-level='2'] {
		background: var(--accent-level-2);
	}
	.contrib-day[data-level='3'] {
		background: var(--accent-level-3);
	}
	.contrib-day[data-level='4'] {
		background: var(--accent-level-4);
	}

	.contrib-legend {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	.contrib-legend .contrib-day {
		width: var(--size-label);
	}

	/* Half a year fits a phone; the full year would shrink cells to dots. */
	@media (max-width: 639px) {
		.contrib-week:nth-child(-n + 26) {
			display: none;
		}
	}
</style>
