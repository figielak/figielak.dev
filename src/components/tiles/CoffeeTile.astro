---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import BigNumber from '../ui/BigNumber.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { COFFEE_PLACEHOLDER, type Coffee } from '../../lib/mocks/coffee';

/** Coffee counter — the data source is still open (koncept.md §17). */
interface Props {
	coffee: Coffee;
	area?: string;
}

const { coffee, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = coffee.data ?? COFFEE_PLACEHOLDER;
const number = new Intl.NumberFormat(lang);
---

<Tile area={area} label={t('tile.coffee')} dense>
	<LiveDot slot="meta" state={dotState(coffee.state)} />

	<LiveBody state={coffee.state} errorText={t('coffee.unavailable')}>
		<div class="coffee">
			<BigNumber value={d.today} caption={`${t('coffee.today')} · ${t('coffee.year').replace('{n}', number.format(d.year))}`} />
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={coffee} />
</Tile>

<style>
	.coffee {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
	}
</style>
