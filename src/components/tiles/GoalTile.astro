---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { goal as defaultGoal, goalProgress, type LiveGoal } from '../../lib/goal';

/**
 * The goal I am working towards now (docs/koncept.md §3.4): its name, a neutral
 * bar of the steps done (§5) and the steps themselves, ticked off or not,
 * one under another in a narrow card. Where the list does not fit only the
 * next step shows; in a low tile the name and the bar share a line and the
 * next step gives way first.
 *
 * Edited on the private dashboard (GoalEditTile) and read from /api/goal, so
 * a change needs no deploy; until the first save it shows src/lib/goal.ts.
 */
interface Props {
	goal?: LiveGoal;
	endpoint?: string;
	area?: string;
}

/* A goal written by hand does not age: never shown as stale. */
const NEVER_STALE_MIN = 100 * 365 * 24 * 60;

const { goal: live = { state: 'ok' }, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const goal = live.data?.goal ?? defaultGoal;
const { total, done, percent, next } = goalProgress(goal);

/* MM.YYYY, like the periods on the home page. */
const by = goal.by ? t('goal.by').replace('{date}', `${goal.by.slice(5, 7)}.${goal.by.slice(0, 4)}`) : '';
const progress = t('goal.progress').replace('{done}', String(done)).replace('{total}', String(total));
---

<Tile
	area={area}
	label={t('tile.goal')}
	icon="target"
	dense
	class="goal-tile"
	data-endpoint={endpoint}
	data-stale-after={NEVER_STALE_MIN}
	data-lang={lang}
	data-by={t('goal.by')}
	data-progress={t('goal.progress')}
	data-next={t('goal.next')}
	data-all-done={t('goal.done')}
>
	<span slot="meta" class="goal-meta">
		<span class="goal-by">{by}</span>
		{endpoint && <LiveDot state={dotState(live.state)} />}
	</span>

	<LiveBody state={live.state} errorText={t('goal.unavailable')}>
		<div class="goal-box">
			<div class="goal">
				<span class="goal-title" data-skeleton>{goal.title[lang]}</span>
				<span
					class="goal-progress"
					role="meter"
					aria-label={t('tile.goal')}
					aria-valuemin="0"
					aria-valuemax={total}
					aria-valuenow={done}
					aria-valuetext={progress}
				>
					<span class="goal-track"><span class="goal-fill" style={`width: ${percent}%`}></span></span>
					<span class="goal-count" aria-hidden="true">{done}/{total}</span>
				</span>
				<ol class="goal-steps" aria-label={progress}>
					{goal.steps.map((step) => (
						<li class="goal-step" data-done={step.done ? '' : undefined} data-next={step === next ? '' : undefined}>
							<span class="goal-mark" aria-hidden="true"><Icon name="check" size={12} /></span>
							<span class="goal-step-title">{step.title[lang]}</span>
						</li>
					))}
				</ol>
				<span class="goal-next" data-skeleton>
					{next ? `${t('goal.next')}: ${next.title[lang]}` : t('goal.done')}
				</span>
			</div>
		</div>
	</LiveBody>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import { goalProgress, type LiveGoal } from '../../lib/goal';

	type GoalData = Omit<NonNullable<LiveGoal['data']>, 'updatedAt'>;

	for (const tile of document.querySelectorAll<HTMLElement>('.goal-tile[data-endpoint]')) {
		const d = tile.dataset;
		const lang = d.lang === 'en' ? 'en' : 'pl';

		watchLive<GoalData>(
			tile,
			({ goal }) => {
				/* Nothing saved yet: the tile keeps the goal it was built with. */
				if (!goal) return;
				const { total, done, percent, next } = goalProgress(goal);
				const progress = (d.progress ?? '').replace('{done}', String(done)).replace('{total}', String(total));
				const by = goal.by ? (d.by ?? '{date}').replace('{date}', `${goal.by.slice(5, 7)}.${goal.by.slice(0, 4)}`) : '';

				setText(tile.querySelector('.goal-by'), by);
				setText(tile.querySelector('.goal-title'), goal.title[lang]);
				const meter = tile.querySelector<HTMLElement>('.goal-progress')!;
				meter.setAttribute('aria-valuemax', String(total));
				meter.setAttribute('aria-valuenow', String(done));
				meter.setAttribute('aria-valuetext', progress);
				tile.querySelector<HTMLElement>('.goal-fill')!.style.width = `${percent}%`;
				setText(tile.querySelector('.goal-count'), `${done}/${total}`);
				setText(tile.querySelector('.goal-next'), next ? `${d.next}: ${next.title[lang]}` : (d.allDone ?? ''));

				/* One row per step, cloned from the first rendered one. */
				const list = tile.querySelector<HTMLElement>('.goal-steps')!;
				const template = list.querySelector('.goal-step');
				list.setAttribute('aria-label', progress);
				if (template) {
					list.replaceChildren(
						...goal.steps.map((step) => {
							const row = template.cloneNode(true) as HTMLElement;
							row.toggleAttribute('data-done', step.done);
							row.toggleAttribute('data-next', step === next);
							row.querySelector('.goal-step-title')!.textContent = step.title[lang];
							return row;
						}),
					);
				}
			},
			5 * 60_000,
		);
	}
</script>

<style>
	.goal-meta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-md);
	}

	.goal-by {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text-muted);
	}

	/* Height queries only on the desktop dashboard, where the grid rows set the
	   tile's height (a size container has none of its own). */
	.goal-box {
		height: 100%;
	}

	@media (min-width: 1024px) {
		.goal-box {
			container-type: size;
		}
	}

	.goal {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-content: space-between;
		gap: var(--space-md);
		height: 100%;
		min-width: 0;
	}

	/* A narrow card: the name may take two lines rather than lose its end. */
	.goal-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		font-size: var(--size-title);
		font-weight: 500;
	}

	.goal-next {
		display: none;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	/* The steps: done ones ticked and quieter, the next one in full text colour. */
	.goal-steps {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		min-height: 0;
		margin: 0;
		padding: 0;
		overflow: hidden;
		list-style: none;
		font-size: var(--size-small);
		color: var(--text-muted);
	}

	.goal-step {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		min-width: 0;
	}

	.goal-step-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.goal-step[data-done] .goal-step-title {
		text-decoration: line-through;
	}

	.goal-step[data-next] {
		color: var(--text);
	}

	.goal-mark {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: var(--size-goal-mark);
		height: var(--size-goal-mark);
		border: 1px solid var(--border-hover);
		border-radius: var(--radius-pill);
	}

	.goal-mark :global(svg) {
		visibility: hidden;
	}

	.goal-step[data-done] .goal-mark {
		border-color: var(--text-muted);
		background: var(--text-muted);
		color: var(--surface);
	}

	.goal-step[data-done] .goal-mark :global(svg) {
		visibility: visible;
	}


	.goal-progress {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		min-width: 0;
	}

	.goal-track {
		flex: 1;
		height: var(--size-bar);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.goal-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--text-muted);
	}

	/* Dashboard intro: the bar grows from zero once the tile is in. */
	:global(.tile[data-reveal]) .goal-fill {
		transform-origin: left;
		animation: goal-grow var(--duration-grow) var(--ease-out) both;
	}

	@keyframes goal-grow {
		from {
			transform: scaleX(0);
		}
	}

	.goal-count {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	/* A little short (1440×900): the ticks show the progress, so the bar goes. */
	@container (max-height: 150px) {
		.goal {
			gap: var(--space-sm);
		}

		.goal-progress {
			display: none;
		}

		.goal-steps {
			gap: var(--space-2xs);
		}
	}

	/* No room for the list: the bar and only the next step. */
	@container (max-height: 115px) {
		.goal-progress {
			display: flex;
		}

		.goal-steps {
			display: none;
		}

		.goal-next {
			display: block;
		}
	}

	/* Low tile: the name and the bar share a line, the next step under them. */
	@container (max-height: 80px) {
		.goal-title {
			display: block;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.goal {
			grid-template-columns: minmax(0, auto) minmax(0, 1fr);
			align-content: end;
			align-items: center;
			column-gap: var(--space-2xl);
		}

		.goal-next {
			grid-column: 1 / -1;
		}
	}

	/* Room for one line only (1440×900): the name and the bar. */
	@container (max-height: 44px) {
		.goal-next {
			display: none;
		}
	}
</style>
