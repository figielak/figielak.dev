---
import Tile from '../ui/Tile.astro';
import Icon from '../ui/Icon.astro';
import StatBar from '../ui/StatBar.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { sunTimes } from '../../lib/sun';
import { PROGRESS_SPANS, progress } from '../../lib/progress';

/**
 * Where we are in the day and the year, in Europe/Warsaw (docs/koncept.md §3.4):
 * the time ticking every second with the date, sunrise and sunset in Rzeszów,
 * and how much of the day, month and year has passed. All of it is computed —
 * the build renders a first value and the browser keeps it current — so the
 * tile has no loading or error state and no dot.
 */
interface Props {
	area?: string;
}

const { area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const zone = 'Europe/Warsaw';

const sun = sunTimes(new Date());
const time = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: zone });
const format = (date?: Date) => (date ? time.format(date) : '--:--');
const minutes = Math.round((sun?.dayLength ?? 0) / 60_000);
const dayLength = (min: number) =>
	t('sun.dayLength')
		.replace('{h}', String(Math.floor(min / 60)))
		.replace('{m}', String(min % 60));
const now = progress(new Date());
---

<Tile area={area} label={t('tile.day')} icon="clock" dense>
	<div class="day">
		<div class="day-top">
			<div class="day-clock">
				<p class="day-time">
					<time data-clock data-locale={lang} data-time-zone={zone}>--:--</time><time
						class="day-seconds"
						data-clock
						data-clock-format="seconds"
						data-locale={lang}
						data-time-zone={zone}>--</time
					>
				</p>
				<time class="day-date" data-clock data-clock-format="date" data-locale={lang} data-time-zone={zone}
					>&nbsp;</time
				>
			</div>

			<div class="sun" data-sun data-locale={lang} data-time-zone={zone} data-day-length={t('sun.dayLength')}>
				<p class="sun-row">
					<Icon name="sunrise" size={16} />
					<span class="visually-hidden">{t('sun.sunrise')}</span>
					<time class="sun-time" data-sun-rise>{format(sun?.sunrise)}</time>
				</p>
				<p class="sun-row">
					<Icon name="sunset" size={16} />
					<span class="visually-hidden">{t('sun.sunset')}</span>
					<time class="sun-time" data-sun-set>{format(sun?.sunset)}</time>
				</p>
				<span class="sun-length" data-sun-length>{dayLength(minutes)}</span>
			</div>
		</div>

		<div class="day-progress">
			{
				PROGRESS_SPANS.map((span) => (
					<div data-progress={span}>
						<StatBar label={t(`progress.${span}`)} value={now[span]} />
					</div>
				))
			}
		</div>
	</div>
</Tile>

<script>
	import { startClocks } from '../../scripts/clock';
	import { sunTimes } from '../../lib/sun';
	import { progress, type ProgressSpan } from '../../lib/progress';

	startClocks();

	for (const el of document.querySelectorAll<HTMLElement>('[data-sun]')) {
		const sun = sunTimes(new Date());
		if (!sun) continue;

		const { locale, timeZone, dayLength = '' } = el.dataset;
		const time = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone });
		const minutes = Math.round(sun.dayLength / 60_000);

		el.querySelector('[data-sun-rise]')!.textContent = time.format(sun.sunrise);
		el.querySelector('[data-sun-set]')!.textContent = time.format(sun.sunset);
		el.querySelector('[data-sun-length]')!.textContent = dayLength
			.replace('{h}', String(Math.floor(minutes / 60)))
			.replace('{m}', String(minutes % 60));
	}

	const spans = [...document.querySelectorAll<HTMLElement>('[data-progress]')];

	const tick = () => {
		const now = progress(new Date());
		for (const el of spans) {
			const percent = Math.round(now[el.dataset.progress as ProgressSpan]);
			const value = `${percent}%`;
			const text = el.querySelector('.stat-value');
			if (!text || text.textContent === value) continue;
			text.textContent = value;
			el.querySelector<HTMLElement>('.stat-fill')!.style.width = value;
			el.querySelector('.stat-track')!.setAttribute('aria-valuenow', String(percent));
		}
	};

	if (spans.length > 0) {
		tick();
		setInterval(tick, 60_000);
	}
</script>

<style>
	/* Time and sun on top, the three progress bars along the bottom. */
	.day {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-lg);
		height: 100%;
		min-width: 0;
	}

	.day-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xl);
		min-width: 0;
	}

	.day-clock {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
		container-type: inline-size;
	}

	.day-time {
		margin: 0;
		font-family: var(--font-mono);
		font-size: min(var(--size-number), 30cqi);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.day-seconds {
		margin-left: var(--space-2xs);
		font-size: 0.45em;
		color: var(--text-subtle);
	}

	.day-date {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	.sun {
		display: flex;
		flex: none;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-2xs);
	}

	.sun-row {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin: 0;
		color: var(--text-muted);
	}

	.sun-time {
		font-family: var(--font-mono);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.sun-length {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-subtle);
	}

	.day-progress {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-xl);
	}
</style>
