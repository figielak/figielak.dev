---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { MUSIC_PLACEHOLDER, type Music } from '../../lib/mocks/music';

/**
 * What I am listening to and this week's top artists from Last.fm
 * (koncept.md §9). The cover fills the whole tile in full colour under a
 * dark scrim, with the text at the bottom (§4); without a cover the tile is
 * a plain one. A tall, narrow card: top artists, then the track at the bottom.
 * Beside the track a play button plays a 30-second preview when the server
 * found one (src/lib/server/preview.ts); without one there is no button.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser, refreshing every 30 s; without it, it shows `music` as given.
 */
interface Props {
	music: Music;
	endpoint?: string;
	area?: string;
}

const { music, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = music.data ?? MUSIC_PLACEHOLDER;
const playing = music.state === 'ok' && d.track.nowPlaying;
const cover = music.data?.track.coverUrl;
---

<Tile
	area={area}
	label={t('tile.music')}
	icon="brand-lastfm"
	dense
	class="music-tile"
	data-endpoint={endpoint}
	data-cover={cover ? '' : undefined}
>
	<LiveDot slot="meta" state={dotState(music.state)} />

	<div class="music-art" aria-hidden="true">
		<img src={cover} alt="" />
	</div>

	<LiveBody state={music.state} errorText={t('music.unavailable')}>
		<div class="music-frame">
			<div class="music">
				<div class="track">
					<span class="track-text">
						<span class="track-status" data-now={t('music.nowPlaying')} data-last={t('music.lastPlayed')}>
							<span class="track-dot" hidden={!playing}><LiveDot state="up" pulse /></span>
							<span class="track-status-text">{playing ? t('music.nowPlaying') : t('music.lastPlayed')}</span>
						</span>
						<span class="track-title" data-skeleton aria-live="polite">{d.track.title}</span>
						<span class="track-artist" data-skeleton>{d.track.artist}</span>
					</span>
					<button
						type="button"
						class="track-play"
						data-preview={d.track.previewUrl}
						data-play={t('music.play')}
						data-pause={t('music.pause')}
						aria-label={t('music.play')}
						title={t('music.play')}
						hidden={!d.track.previewUrl}
					>
						<span class="track-play-icon" data-icon="play"><Icon name="player-play" size={16} /></span>
						<span class="track-play-icon" data-icon="pause"><Icon name="player-pause" size={16} /></span>
					</button>
				</div>

				<div class="top">
					<span class="top-label">{t('music.top')}</span>
					<ol class="top-list" data-template={t('music.plays')}>
						{
							d.topArtists.map((artist, i) => (
								<li class="top-artist">
									<span class="top-rank">{i + 1}</span>
									<span class="top-name" data-skeleton>{artist.name}</span>
									<span class="top-plays" data-skeleton data-count>
										{t('music.plays').replace('{n}', String(artist.plays))}
									</span>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={music} />
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import type { Music } from '../../lib/mocks/music';

	type MusicData = Omit<NonNullable<Music['data']>, 'updatedAt'>;

	/* The preview plays from Apple's CDN only after a click. A track that
	   changes mid-preview lets it finish; the next click plays the new one. */
	for (const button of document.querySelectorAll<HTMLButtonElement>('.music-tile .track-play')) {
		const audio = new Audio();
		audio.preload = 'none';
		audio.volume = 0.6;

		const setPlaying = (playing: boolean) => {
			button.toggleAttribute('data-playing', playing);
			const label = (playing ? button.dataset.pause : button.dataset.play) ?? '';
			button.setAttribute('aria-label', label);
			button.title = label;
			if (!playing && !button.dataset.preview) button.hidden = true;
		};

		button.addEventListener('click', () => {
			if (!audio.paused) return audio.pause();
			const url = button.dataset.preview;
			if (!url) return;
			if (audio.src !== url) audio.src = url;
			audio.play().catch(() => setPlaying(false));
		});
		audio.addEventListener('play', () => setPlaying(true));
		audio.addEventListener('pause', () => setPlaying(false));
		audio.addEventListener('ended', () => setPlaying(false));
	}

	for (const tile of document.querySelectorAll<HTMLElement>('.music-tile[data-endpoint]')) {
		watchLive<MusicData>(
			tile,
			({ track, topArtists }) => {
				const cover = tile.querySelector<HTMLImageElement>('.music-art img');
				if (cover && track.coverUrl && cover.getAttribute('src') !== track.coverUrl) cover.src = track.coverUrl;
				tile.toggleAttribute('data-cover', Boolean(track.coverUrl));

				const status = tile.querySelector<HTMLElement>('.track-status');
				tile.querySelector<HTMLElement>('.track-dot')!.hidden = !track.nowPlaying;
				const statusText = track.nowPlaying ? status?.dataset.now : status?.dataset.last;
				setText(tile.querySelector('.track-status-text'), statusText ?? '');
				setText(tile.querySelector('.track-title'), track.title);
				setText(tile.querySelector('.track-artist'), track.artist);

				const play = tile.querySelector<HTMLButtonElement>('.track-play');
				if (play) {
					play.dataset.preview = track.previewUrl ?? '';
					if (track.previewUrl) play.hidden = false;
					else if (!play.hasAttribute('data-playing')) play.hidden = true;
				}

				const list = tile.querySelector<HTMLElement>('.top-list');
				tile.querySelectorAll('.top-artist').forEach((row, i) => {
					const artist = topArtists[i];
					setText(row.querySelector('.top-name'), artist?.name ?? '—');
					setText(
						row.querySelector('.top-plays'),
						artist ? (list?.dataset.template ?? '{n}').replace('{n}', String(artist.plays)) : '',
					);
				});
			},
			30_000,
		);
	}
</script>

<style>
	/* The cover sits under the header, body and footer of the whole tile. */
	:global(.music-tile) {
		position: relative;
	}

	:global(.music-tile) > :global(.tile-header),
	:global(.music-tile) > :global(.tile-footer),
	.music-art ~ :global(.live-body) {
		position: relative;
		z-index: 1;
	}

	.music-art {
		display: none;
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	:global(.music-tile[data-cover]) .music-art {
		display: block;
	}

	.music-art img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Dashboard intro: the cover settles in, slightly larger at first, and on
	   desktop sharpens out of a blur. */
	:global(.tile[data-reveal]) .music-art img {
		animation: music-art-in var(--duration-intro) var(--ease-out) both;
	}

	@keyframes music-art-in {
		from {
			opacity: 0.6;
			transform: scale(1.08);
		}
	}

	@media (min-width: 1024px) {
		:global(.tile[data-reveal]) .music-art img {
			animation-name: music-art-in-blur;
		}
	}

	@keyframes music-art-in-blur {
		from {
			opacity: 0.6;
			transform: scale(1.08);
			filter: blur(var(--intro-blur));
		}
	}

	/* Darker at the bottom under the text, a touch at the top for the label. */
	.music-art::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--scrim) 0%, var(--scrim-soft) 65%, var(--scrim-soft) 100%);
	}

	/* Over a cover the subtle greys would drop below AA, so they step up. */
	:global(.music-tile[data-cover]) :is(.track-status, .top-rank, .top-plays, .top-label) {
		color: var(--text-muted);
	}

	:global(.music-tile[data-cover]) .track-artist {
		color: var(--text);
	}

	.music-frame {
		height: 100%;
		container-type: inline-size;
	}

	/* A phone-narrow card keeps the artists' names and drops the play counts. */
	@container (max-width: 220px) {
		.top-plays {
			display: none;
		}
	}

	.music {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: var(--space-lg);
		height: 100%;
		min-width: 0;
	}

	.track {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-md);
		min-width: 0;
	}

	.track-play {
		flex: none;
		display: inline-grid;
		place-items: center;
		width: var(--size-carousel-control);
		height: var(--size-carousel-control);
		padding: 0;
		border: 1px solid var(--border-hover);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		color: var(--text);
		cursor: pointer;
		transition:
			background-color var(--duration-hover) var(--ease-out),
			border-color var(--duration-hover) var(--ease-out);
	}

	.track-play:hover {
		background: var(--surface-hover);
	}

	.track-play[hidden],
	.track-play:not([data-playing]) [data-icon='pause'],
	.track-play[data-playing] [data-icon='play'] {
		display: none;
	}

	.track-play-icon {
		display: inline-flex;
	}

	.track-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.track-status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	.track-title,
	.track-artist,
	.top-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.track-title {
		align-self: flex-start;
		max-width: 100%;
		font-size: var(--size-title);
		font-weight: 500;
	}

	.track-artist {
		align-self: flex-start;
		max-width: 100%;
		color: var(--text-muted);
	}

	/* Shown above the track, which closes the tile like a caption under the
	   cover; the markup keeps the track first for screen readers. */
	.top {
		order: -1;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		padding-bottom: var(--space-md);
		border-bottom: 1px solid var(--border);
	}

	.top-label {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	.top-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.top-artist {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: baseline;
		gap: var(--space-md);
	}

	.top-rank,
	.top-plays {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text-subtle);
	}
</style>
