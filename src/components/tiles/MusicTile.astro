---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { MUSIC_PLACEHOLDER, type Music } from '../../lib/mocks/music';

/**
 * A compact after-hours track, with decorative cover art and an optional
 * 30-second preview. Ranking data stays in /api/music for other consumers.
 * With an endpoint the tile starts loading and refreshes every 30 seconds.
 */
interface Props {
	music: Music;
	endpoint?: string;
	area?: string;
}

const { music, endpoint, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = music.data ?? MUSIC_PLACEHOLDER;
const playing = music.state === 'ok' && d.track.nowPlaying;
const cover = music.data?.track.coverUrl;
---

<Tile
	area={area}
	label={t('tile.music')}
	icon="brand-lastfm"
	dense
	class="music-tile"
	data-endpoint={endpoint}
	data-cover={cover ? '' : undefined}
>
	<LiveDot slot="meta" state={dotState(music.state)} />
	<LiveBody state={music.state} errorText={t('music.unavailable')}>
		<div class="music">
			<span class="music-art" data-skeleton aria-hidden="true">
				<span class="music-fallback"><Icon name="music" size={24} /></span>
				<img src={cover} alt="" />
			</span>
			<div class="track-text">
				<span class="track-status" data-now={t('music.nowPlaying')} data-last={t('music.lastPlayed')}>
					<span class="track-dot" hidden={!playing}><LiveDot state="up" pulse /></span>
					<span class="track-status-text">{playing ? t('music.nowPlaying') : t('music.lastPlayed')}</span>
				</span>
				<span class="track-title tile-value" data-skeleton title={d.track.title} aria-live="polite">{d.track.title}</span>
				<span class="track-artist" data-skeleton title={d.track.artist}>{d.track.artist}</span>
			</div>
			<button
				type="button"
				class="track-play"
				data-preview={d.track.previewUrl}
				data-play={t('music.play')}
				data-pause={t('music.pause')}
				aria-label={t('music.play')}
				title={t('music.play')}
				hidden={!d.track.previewUrl}
			>
				<span class="track-play-icon" data-icon="play"><Icon name="player-play" size={16} /></span>
				<span class="track-play-icon" data-icon="pause"><Icon name="player-pause" size={16} /></span>
			</button>
		</div>
	</LiveBody>
	<LiveFooter slot="footer" live={music} staleOnly />
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import type { Music } from '../../lib/mocks/music';

	type MusicData = Omit<NonNullable<Music['data']>, 'updatedAt'>;

	/* The preview plays from Apple's CDN only after a click. A track that
	   changes mid-preview lets it finish; the next click plays the new one. */
	for (const button of document.querySelectorAll<HTMLButtonElement>('.music-tile .track-play')) {
		const audio = new Audio();
		audio.preload = 'none';
		audio.volume = 0.6;

		const setPlaying = (playing: boolean) => {
			button.toggleAttribute('data-playing', playing);
			const label = (playing ? button.dataset.pause : button.dataset.play) ?? '';
			button.setAttribute('aria-label', label);
			button.title = label;
			if (!playing && !button.dataset.preview) button.hidden = true;
		};

		button.addEventListener('click', () => {
			if (!audio.paused) return audio.pause();
			const url = button.dataset.preview;
			if (!url) return;
			if (audio.src !== url) audio.src = url;
			audio.play().catch(() => setPlaying(false));
		});
		audio.addEventListener('play', () => setPlaying(true));
		audio.addEventListener('pause', () => setPlaying(false));
		audio.addEventListener('ended', () => setPlaying(false));
	}


	for (const tile of document.querySelectorAll<HTMLElement>('.music-tile[data-endpoint]')) {
		let nowPlaying = false;
		const body = tile.querySelector<HTMLElement>('.live-body');
		const refreshStatus = () => {
			const playing = body?.dataset.live === 'ok' && nowPlaying;
			const status = tile.querySelector<HTMLElement>('.track-status');
			const dot = tile.querySelector<HTMLElement>('.track-dot');
			if (dot) dot.hidden = !playing;
			setText(tile.querySelector('.track-status-text'), (playing ? status?.dataset.now : status?.dataset.last) ?? '');
		};
		/* Freshness can change after a failed poll, without another track payload. */
		if (body) new MutationObserver(refreshStatus).observe(body, { attributes: true, attributeFilter: ['data-live'] });

		watchLive<MusicData>(tile, ({ track }) => {
			const cover = tile.querySelector<HTMLImageElement>('.music-art img');
			if (cover) {
				if (track.coverUrl) {
					if (cover.getAttribute('src') !== track.coverUrl) cover.src = track.coverUrl;
				} else cover.removeAttribute('src');
			}
			tile.toggleAttribute('data-cover', Boolean(track.coverUrl));
			nowPlaying = track.nowPlaying;
			refreshStatus();
			setText(tile.querySelector('.track-title'), track.title);
			setText(tile.querySelector('.track-artist'), track.artist);
			tile.querySelector('.track-title')?.setAttribute('title', track.title);
			tile.querySelector('.track-artist')?.setAttribute('title', track.artist);

			const play = tile.querySelector<HTMLButtonElement>('.track-play');
			if (play) {
				play.dataset.preview = track.previewUrl ?? '';
				if (track.previewUrl) play.hidden = false;
				else if (!play.hasAttribute('data-playing')) play.hidden = true;
			}
		}, 30_000);
	}
</script>

<style>
	:global(.music-tile) {
		container-type: inline-size;
	}

	:global(.music-tile .tile-label) {
		line-height: 1.3;
	}

	.music {
		display: grid;
		grid-template-columns: var(--size-book-cover) minmax(0, 1fr) var(--size-icon-button);
		grid-template-areas: 'cover text play';
		align-items: center;
		gap: var(--space-lg);
		height: 100%;
		min-height: calc(var(--size-avatar) + var(--space-3xs));
		min-width: 0;
	}

	.music-art {
		grid-area: cover;
		position: relative;
		width: var(--size-book-cover);
		aspect-ratio: 1;
		border-radius: var(--radius-inset);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.music-fallback {
		display: grid;
		place-items: center;
		height: 100%;
		color: var(--text-muted);
	}

	.music-art img {
		display: none;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	:global(.music-tile[data-cover]) .music-art img {
		display: block;
	}

	:global(.music-tile[data-cover]) .music-fallback {
		display: none;
	}

	.track-text {
		grid-area: text;
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.track-status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	.track-dot {
		display: inline-flex;
		flex: none;
	}

	.track-dot[hidden] {
		display: none;
	}

	.track-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
	}

	.track-artist {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	.track-play {
		grid-area: play;
		display: inline-grid;
		place-items: center;
		width: var(--size-icon-button);
		height: var(--size-icon-button);
		padding: 0;
		border: 1px solid var(--border-hover);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		color: var(--text);
		cursor: pointer;
		transition: background-color var(--duration-hover) var(--ease-out);
	}

	.track-play:hover {
		background: var(--surface-hover);
	}

	.track-play[hidden],
	.track-play:not([data-playing]) [data-icon='pause'],
	.track-play[data-playing] [data-icon='play'] {
		display: none;
	}

	.track-play-icon {
		display: inline-flex;
	}

	:global(.music-tile .tile-footer .live-footer),
	:global(.music-tile .live-body .live-error) {
		color: var(--text-muted);
	}

	:global(.tile[data-reveal]) .music-art img {
		animation: music-art-in var(--duration-intro) var(--ease-out) both;
	}

	@keyframes music-art-in {
		from { opacity: 0.6; transform: scale(1.08); }
	}

	@container (max-width: 260px) {
		.music {
			grid-template-columns: minmax(0, 1fr) var(--size-icon-button);
			grid-template-areas: 'cover play' 'text text';
			align-content: center;
			gap: var(--space-md);
			min-height: var(--size-avatar-lg);
		}

		.music-art {
			width: var(--size-book-cover-small);
		}
	}
</style>
