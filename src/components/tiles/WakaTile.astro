---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import BigNumber from '../ui/BigNumber.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { WAKA_PLACEHOLDER, type Waka } from '../../lib/mocks/waka';

/**
 * Coding time from WakaTime, cached 1 h (koncept.md §9). The dashboard's one
 * full accent tile (§4) — its anchor; Tile switches the text tokens for it.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `waka` as given (mocks in /dev/tiles).
 */
interface Props {
	waka: Waka;
	endpoint?: string;
	area?: string;
}

/* The API refreshes hourly, so an hour-old answer is still fresh. */
const STALE_AFTER_MIN = 3 * 60;

const { waka, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = waka.data ?? WAKA_PLACEHOLDER;

const hm = (min: number) =>
	t('duration.hm')
		.replace('{h}', String(Math.floor(min / 60)))
		.replace('{m}', String(min % 60));
const short = (min: number) => `${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')}`;
---

<Tile
	area={area}
	label={t('tile.waka')}
	icon="code"
	accent
	dense
	class="waka-tile"
	data-endpoint={endpoint}
	data-stale-after={STALE_AFTER_MIN}
	data-week={t('waka.week')}
	data-hm={t('duration.hm')}
>
	<LiveDot slot="meta" state={dotState(waka.state)} />

	<LiveBody state={waka.state} errorText={t('waka.unavailable')}>
		<div class="waka">
			<BigNumber value={short(d.todayMin)} caption={t('waka.today')} />
			<ul class="waka-languages">
				{
					d.languages.map((language) => (
						<li class="waka-language">
							<span class="waka-name" data-skeleton>{language.name}</span>
							<span class="waka-percent" data-skeleton>{language.percent}%</span>
						</li>
					))
				}
			</ul>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={waka}>{t('waka.week').replace('{t}', hm(d.weekMin))}</LiveFooter>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import type { WakaData } from '../../lib/server/wakatime';

	const short = (min: number) => `${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')}`;

	for (const tile of document.querySelectorAll<HTMLElement>('.waka-tile[data-endpoint]')) {
		const { week = '{t}', hm = '{h}:{m}' } = tile.dataset;

		watchLive<WakaData>(tile, (data) => {
			setText(tile.querySelector('.big-value'), short(data.todayMin));

			tile.querySelectorAll('.waka-language').forEach((row, i) => {
				const language = data.languages[i];
				setText(row.querySelector('.waka-name'), language?.name ?? '—');
				setText(row.querySelector('.waka-percent'), language ? `${language.percent}%` : '');
			});

			const weekText = hm
				.replace('{h}', String(Math.floor(data.weekMin / 60)))
				.replace('{m}', String(data.weekMin % 60));
			setText(tile.querySelector('.live-footer-detail'), week.replace('{t}', weekText));
		});
	}
</script>

<style>
	/* The tile is the container, so a narrow one can also drop the footer detail. */
	:global(.waka-tile) {
		container-type: inline-size;
	}

	.waka {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-xl);
		height: 100%;
	}

	.waka-languages {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.waka-language {
		display: flex;
		justify-content: space-between;
		gap: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--size-label);
	}

	.waka-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	.waka-percent {
		font-variant-numeric: tabular-nums;
	}

	/* One column wide (beside the social tiles): the number, its caption and
	   only the top language; the week in the footer does not fit. */
	@container (max-width: 280px) {
		.waka {
			grid-template-columns: minmax(0, 1fr);
			align-content: center;
			gap: var(--space-md);
		}

		.waka-language:nth-child(n + 2),
		:global(.waka-tile .live-footer-detail) {
			display: none;
		}
	}
</style>
