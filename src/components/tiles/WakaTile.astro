---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { WAKA_PLACEHOLDER, type Waka } from '../../lib/mocks/waka';
import { languageSegments } from '../../lib/waka';

/**
 * This week's tracked time and up to three code languages. The server's week
 * starts Monday in Europe/Warsaw; language percentages exclude prose and
 * unrecognised files. Empty data remains a successful, possibly stale week.
 * With an endpoint, the loading tile is filled by the browser.
 */
interface Props {
	waka: Waka;
	endpoint?: string;
	area?: string;
}

const STALE_AFTER_MIN = 3 * 60;
const LEGEND = 3;
/* Up to three named languages and "other". */
const SLOTS = LEGEND + 1;
const { waka, endpoint, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = waka.data ?? WAKA_PLACEHOLDER;
const fill = (template: string, h: number, m: number) =>
	template.replace('{h}', String(h)).replace('{m}', String(m));
const short = (min: number) =>
	min < 60
		? fill(t('duration.shortMin'), 0, min)
		: min % 60
			? fill(t('duration.short'), Math.floor(min / 60), min % 60)
			: fill(t('duration.shortHours'), Math.floor(min / 60), 0);
const named = d.languages.filter((language) => language.percent > 0).slice(0, LEGEND);
const segments = languageSegments(named, t('waka.other'));
const hasLanguages = segments.length > 0;
---

<Tile
	area={area}
	label={t('tile.waka')}
	icon="code"
	dense
	class="waka-tile"
	data-endpoint={endpoint}
	data-stale-after={STALE_AFTER_MIN}
	data-short={t('duration.short')}
	data-short-min={t('duration.shortMin')}
	data-short-hours={t('duration.shortHours')}
	data-other={t('waka.other')}
	data-empty-week={t('waka.emptyWeek')}
	data-no-languages={t('waka.noLanguages')}
>
	<LiveDot slot="meta" state={dotState(waka.state)} />
	<LiveBody state={waka.state} errorText={t('waka.unavailable')}>
		<div class="waka">
			<div class="waka-total">
				<span class="waka-value tile-value" data-skeleton aria-live="polite">{short(d.weekMin)}</span>
				<span class="waka-caption" title="Europe/Warsaw" data-skeleton>{t('waka.weekCaption')}</span>
			</div>
			<div class="waka-details">
				<div class="waka-languages" hidden={!hasLanguages && waka.state !== 'loading'}>
					<span class="waka-language-caption" data-skeleton>{t('waka.languageCaption')}</span>
					<span class="waka-bar" data-skeleton aria-hidden="true">
						{segments.map((segment) => (
							<span class="waka-segment" style={`width: ${segment.percent}%; --c: ${segment.color}`} />
						))}
					</span>
					<ul class="waka-legend">
						{Array.from({ length: SLOTS }, (_, i) => segments[i]).map((segment) => (
							<li class="waka-language" style={segment && `--c: ${segment.color}`} hidden={!segment}>
								<span class="waka-name">{segment?.name}</span>
								<span class="waka-percent">{segment && `${segment.percent}%`}</span>
							</li>
						))}
					</ul>
				</div>
				<p class="waka-empty" hidden={hasLanguages || waka.state === 'loading'}>
					{d.weekMin === 0 ? t('waka.emptyWeek') : t('waka.noLanguages')}
				</p>
			</div>
		</div>
	</LiveBody>
	<LiveFooter slot="footer" live={waka} staleOnly />
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import { languageSegments } from '../../lib/waka';
	import type { WakaData } from '../../lib/server/wakatime';

	const LEGEND = 3;
	for (const tile of document.querySelectorAll<HTMLElement>('.waka-tile[data-endpoint]')) {
		const {
			short: shortTemplate = '{h}h {m}m', shortMin = '{m}m', shortHours = '{h}h',
			other = '', emptyWeek = '', noLanguages = '',
		} = tile.dataset;
		const fill = (template: string, h: number, m: number) =>
			template.replace('{h}', String(h)).replace('{m}', String(m));
		const short = (min: number) =>
			min < 60
				? fill(shortMin, 0, min)
				: min % 60
					? fill(shortTemplate, Math.floor(min / 60), min % 60)
					: fill(shortHours, Math.floor(min / 60), 0);

		watchLive<WakaData>(tile, (data) => {
			setText(tile.querySelector('.waka-value'), short(data.weekMin));
			const named = data.languages.filter((language) => language.percent > 0).slice(0, LEGEND);
			const segments = languageSegments(named, other);
			const languages = tile.querySelector<HTMLElement>('.waka-languages');
			if (languages) languages.hidden = segments.length === 0;
			const empty = tile.querySelector<HTMLElement>('.waka-empty');
			if (empty) {
				empty.hidden = segments.length > 0;
				setText(empty, data.weekMin === 0 ? emptyWeek : noLanguages);
			}
			tile.querySelector('.waka-bar')?.replaceChildren(...segments.map((segment) => {
				const el = document.createElement('span');
				el.className = 'waka-segment';
				el.style.width = `${segment.percent}%`;
				el.style.setProperty('--c', segment.color);
				return el;
			}));
			tile.querySelectorAll<HTMLElement>('.waka-language').forEach((row, i) => {
				const segment = segments[i];
				row.hidden = !segment;
				row.style.setProperty('--c', segment?.color ?? 'var(--chart-rest)');
				setText(row.querySelector('.waka-name'), segment?.name ?? '');
				setText(row.querySelector('.waka-percent'), segment ? `${segment.percent}%` : '');
			});
		});
	}
</script>

<style>
	:global(.waka-tile) {
		container-type: inline-size;
	}

	.waka {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-lg);
		height: 100%;
		min-width: 0;
	}

	.waka-total {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.waka-value {
		align-self: flex-start;
		white-space: nowrap;
	}

	.waka-caption,
	.waka-language-caption {
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	/* Reserve two legend lines, including when the week has no code data. */
	.waka-details {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: calc(var(--size-label) * 5 + var(--space-xl));
	}

	.waka-languages {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		min-width: 0;
	}

	.waka-languages[hidden],
	.waka-empty[hidden],
	.waka-language[hidden] {
		display: none;
	}

	.waka-empty {
		margin: 0;
		color: var(--text-muted);
		overflow-wrap: anywhere;
	}

	.waka-bar {
		display: flex;
		gap: var(--size-segment-gap);
		height: var(--size-bar);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.waka-bar :global(.waka-segment) {
		display: block;
		height: 100%;
		background: var(--c);
	}

	.waka-legend {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-sm);
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--size-label);
	}

	.waka-language {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		min-width: 0;
		max-width: 100%;
	}

	/* A full-width card puts the languages beside the total. */
	@container (min-width: 560px) {
		.waka {
			flex-direction: row;
			align-items: center;
			gap: var(--space-3xl);
		}

		.waka-details {
			flex: 1;
			min-width: 0;
		}
	}

	.waka-language::before {
		content: '';
		flex: none;
		width: var(--size-dot);
		height: var(--size-dot);
		border-radius: var(--radius-pill);
		background: var(--c);
	}

	.waka-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	.waka-percent {
		flex: none;
		font-variant-numeric: tabular-nums;
	}

	:global(.waka-tile .tile-footer .live-footer),
	:global(.waka-tile .live-body .live-error) {
		color: var(--text-muted);
	}

	:global(.tile[data-reveal]) .waka-bar {
		transform-origin: left;
		animation: waka-grow-x var(--duration-grow) var(--ease-out) both;
	}

	@keyframes waka-grow-x {
		from { transform: scaleX(0); }
	}
</style>
