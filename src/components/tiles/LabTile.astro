---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import StatBar from '../ui/StatBar.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { percent } from '../../lib/units';
import { MACHINE_PLACEHOLDER, type MachineStats } from '../../lib/mocks/stats';

/**
 * Homelab usage, pushed by the agent (koncept.md §9): CPU, RAM and one bar
 * per disk side by side, like the progress tile; GPU only when the machine
 * has one. Containers and CPU temperature sit in the footer.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `stats` as given (mocks in /dev/tiles).
 */
interface Props {
	stats: MachineStats;
	endpoint?: string;
	area?: string;
}

const { stats, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = stats.data ?? MACHINE_PLACEHOLDER;

const footer = (containers: number | undefined, tempC: number) =>
	[
		containers === undefined ? undefined : t('stats.containers').replace('{n}', String(containers)),
		t('stats.cpuTemp').replace('{n}', String(Math.round(tempC))),
	]
		.filter(Boolean)
		.join(' · ');
---

<Tile
	area={area}
	label={t('tile.lab')}
	dense
	class="lab-tile"
	data-endpoint={endpoint}
	data-containers={t('stats.containers')}
	data-temp={t('stats.cpuTemp')}
>
	<LiveDot slot="meta" state={dotState(stats.state)} />

	<LiveBody state={stats.state} errorText={t('lab.offline')}>
		<div class="lab">
			<StatBar label={t('stats.cpu')} value={d.cpu} />
			<StatBar label={t('stats.ram')} value={percent(d.ramUsedGb, d.ramTotalGb)} />
			{d.gpu !== undefined && <StatBar label={t('stats.gpu')} value={d.gpu} />}
			{
				d.disks.map((disk) => (
					<StatBar label={t(`disk.${disk.kind}`)} value={percent(disk.usedGb, disk.totalGb)} />
				))
			}
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={stats}>{footer(d.containers, d.cpuTempC)}</LiveFooter>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import { percent } from '../../lib/units';
	import type { LabSection } from '../../lib/server/homelab';

	/* Rows come from the first render: CPU, RAM, then the disks in order. */
	function setBar(stat: Element | undefined, value: number) {
		if (!stat) return;
		const rounded = String(Math.round(Math.min(100, Math.max(0, value))));
		stat.querySelector<HTMLElement>('.stat-fill')?.style.setProperty('width', `${rounded}%`);
		stat.querySelector('.stat-track')?.setAttribute('aria-valuenow', rounded);
		setText(stat.querySelector('.stat-value'), `${rounded}%`);
	}

	for (const tile of document.querySelectorAll<HTMLElement>('.lab-tile[data-endpoint]')) {
		const { containers = '{n}', temp = '{n}' } = tile.dataset;

		watchLive<LabSection>(tile, (data) => {
			const [cpu, ram, ...disks] = tile.querySelectorAll('.stat');
			setBar(cpu, data.cpu);
			setBar(ram, percent(data.ramUsedGb, data.ramTotalGb));
			data.disks.forEach((disk, i) => setBar(disks[i], percent(disk.usedGb, disk.totalGb)));

			const parts = [temp.replace('{n}', String(Math.round(data.cpuTempC)))];
			if (data.containers !== undefined) parts.unshift(containers.replace('{n}', String(data.containers)));
			setText(tile.querySelector('.live-footer-detail'), parts.join(' · '));
		});
	}
</script>

<style>
	.lab {
		display: grid;
		grid-auto-columns: minmax(0, 1fr);
		grid-auto-flow: column;
		align-content: center;
		gap: var(--space-xl);
		height: 100%;
	}
</style>
