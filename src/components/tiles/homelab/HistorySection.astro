---
import Section from './Section.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n';
import { CHART_HEIGHT, CHART_WIDTH, chartEnd, chartTop, seriesPaths, seriesSummary } from '../../../lib/chart';
import type { History } from '../../../lib/mocks/history';

/**
 * CPU and RAM of the last 24 hours (koncept.md §3.4), for the owner only:
 * two small area charts side by side — two measures, so two charts, never a
 * shared axis — each a single neutral series (§5) with its latest value
 * beside the name. Each scale ends at a round number above its peak, shown
 * at the top, so a quiet CPU still reads. One crosshair follows the pointer
 * across both, and the
 * tooltip gives the time and both values. A gap in the line is time the
 * agent was offline. Each chart has a text summary for screen readers.
 */
interface Props {
	history: History;
	endpoint?: string;
}

const SERIES = [
	{ key: 'cpu', label: 'stats.cpu' },
	{ key: 'ram', label: 'stats.ram' },
] as const;

const { history, endpoint } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const points = history.data?.points ?? [];
const end = chartEnd(points);
const time = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Warsaw' });

const summary = (key: 'cpu' | 'ram', name: string) => {
	const s = seriesSummary(points, key);
	if (!s) return t('history.noData');
	return t('history.summary')
		.replace('{name}', name)
		.replace('{avg}', String(Math.round(s.average)))
		.replace('{peak}', String(Math.round(s.peak)))
		.replace('{time}', time.format(new Date(s.peakAt)));
};
---

<Section
	title={t('homelab.history')}
	live={history}
	class="history-section"
	data-endpoint={endpoint}
	data-lang={lang}
	data-summary={t('history.summary')}
	data-no-data={t('history.noData')}
	data-points={history.data ? JSON.stringify(points) : undefined}
>
	<div class="history" data-history>
		{
			SERIES.map(({ key, label }) => {
				const { line, area } = seriesPaths(points, key, end);
				const last = seriesSummary(points, key)?.last;
				return (
					<figure class="chart" data-series={key}>
						<figcaption class="chart-head">
							<span class="chart-name">{t(label)}</span>
							<span class="chart-value" data-skeleton>
								{last === undefined ? '—' : `${Math.round(last)}%`}
							</span>
						</figcaption>
						<div class="chart-plot">
							<span class="chart-top" aria-hidden="true">
								{chartTop(points, key)}%
							</span>
							<svg
								class="chart-svg"
								viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`}
								preserveAspectRatio="none"
								role="img"
								aria-label={summary(key, t(label))}
							>
								<path class="chart-area" d={area} />
								<path class="chart-line" d={line} vector-effect="non-scaling-stroke" />
							</svg>
							<span class="chart-cross" aria-hidden="true" hidden />
							<span class="chart-dot" aria-hidden="true" hidden />
						</div>
						<div class="chart-axis" aria-hidden="true">
							<span>{t('history.start')}</span>
							<span>{t('history.now')}</span>
						</div>
					</figure>
				);
			})
		}
		<p class="chart-tip" aria-hidden="true" hidden></p>
	</div>
</Section>

<script>
	import { watchLive, setText } from '../../../scripts/live';
	import { CHART_WIDTH, chartEnd, chartTop, chartX, chartY, seriesPaths, seriesSummary } from '../../../lib/chart';
	import type { History, HistoryPoint } from '../../../lib/mocks/history';

	type HistoryData = Omit<NonNullable<History['data']>, 'updatedAt'>;
	const KEYS = ['cpu', 'ram'] as const;

	for (const section of document.querySelectorAll<HTMLElement>('.history-section')) {
		const d = section.dataset;
		const time = new Intl.DateTimeFormat(d.lang, { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Warsaw' });
		const box = section.querySelector<HTMLElement>('[data-history]')!;
		const tip = box.querySelector<HTMLElement>('.chart-tip')!;
		const charts = [...box.querySelectorAll<HTMLElement>('.chart')];
		let points: HistoryPoint[] = d.points ? JSON.parse(d.points) : [];
		for (const chart of charts) chart.dataset.top = String(chartTop(points, chart.dataset.series as 'cpu' | 'ram'));

		const draw = () => {
			const end = chartEnd(points);
			for (const chart of charts) {
				const key = chart.dataset.series as (typeof KEYS)[number];
				const top = chartTop(points, key);
				const { line, area } = seriesPaths(points, key, end, top);
				chart.dataset.top = String(top);
				setText(chart.querySelector('.chart-top'), `${top}%`);
				chart.querySelector('.chart-line')!.setAttribute('d', line);
				chart.querySelector('.chart-area')!.setAttribute('d', area);
				const s = seriesSummary(points, key);
				setText(chart.querySelector('.chart-value'), s ? `${Math.round(s.last)}%` : '—');
				const name = chart.querySelector('.chart-name')!.textContent ?? '';
				chart.querySelector('svg')!.setAttribute(
					'aria-label',
					s
						? (d.summary ?? '')
								.replace('{name}', name)
								.replace('{avg}', String(Math.round(s.average)))
								.replace('{peak}', String(Math.round(s.peak)))
								.replace('{time}', time.format(new Date(s.peakAt)))
						: (d.noData ?? ''),
				);
			}
		};

		const hide = () => {
			tip.hidden = true;
			for (const chart of charts) {
				chart.querySelector<HTMLElement>('.chart-cross')!.hidden = true;
				chart.querySelector<HTMLElement>('.chart-dot')!.hidden = true;
			}
		};

		/* The crosshair snaps to the nearest bucket; none within two means a gap. */
		box.addEventListener('pointermove', (event) => {
			const plot = (event.target as Element).closest<HTMLElement>('.chart-plot');
			if (!plot || !points.length) return hide();
			const rect = plot.getBoundingClientRect();
			const x = ((event.clientX - rect.left) / rect.width) * CHART_WIDTH;
			const end = chartEnd(points);
			let nearest: HistoryPoint | undefined;
			let distance = Infinity;
			for (const point of points) {
				const dx = Math.abs(chartX(point.t, end) - x);
				if (dx < distance) [nearest, distance] = [point, dx];
			}
			if (!nearest || distance > 2) return hide();

			const left = `${(chartX(nearest.t, end) / CHART_WIDTH) * 100}%`;
			for (const chart of charts) {
				const key = chart.dataset.series as (typeof KEYS)[number];
				const cross = chart.querySelector<HTMLElement>('.chart-cross')!;
				const dot = chart.querySelector<HTMLElement>('.chart-dot')!;
				cross.style.left = left;
				dot.style.left = left;
				const top = Number(chart.dataset.top) || chartTop(points, key);
				dot.style.top = `${chartY(nearest[key], top)}%`;
				cross.hidden = false;
				dot.hidden = false;
			}
			const names = charts.map((chart) => chart.querySelector('.chart-name')!.textContent);
			tip.textContent = `${time.format(new Date(nearest.t))} · ${names[0]} ${Math.round(nearest.cpu)}% · ${names[1]} ${Math.round(nearest.ram)}%`;
			tip.hidden = false;
		});
		box.addEventListener('pointerleave', hide);

		if (d.endpoint) {
			watchLive<HistoryData>(
				section,
				(data) => {
					points = data.points;
					draw();
				},
				5 * 60_000,
			);
		}
	}
</script>

<style>
	/* Fills the section's body, so the charts take the tile's spare height. */
	.history {
		position: relative;
		flex: 1;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-lg);
		min-height: 0;
	}

	.chart {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
		min-height: 0;
		margin: 0;
	}

	.chart-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--size-label);
	}

	.chart-name {
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.chart-value {
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.chart-plot {
		position: relative;
		flex: 1;
		min-height: calc(var(--space-2xl) * 1.5);
		border-bottom: 1px solid var(--border);
		touch-action: pan-y;
	}

	/* The scale's top, on the gridline it names. */
	.chart-top {
		position: absolute;
		top: 0;
		left: 0;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		line-height: 1;
		color: var(--text-subtle);
		transform: translateY(-50%);
		padding-right: var(--space-2xs);
		background: var(--surface);
	}

	.chart-plot::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		border-top: 1px solid var(--border);
	}

	.chart-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* One neutral series (koncept.md §5): a 2px line over a faint wash. */
	.chart-line {
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.chart-area {
		fill: var(--text-muted);
		fill-opacity: 0.1;
	}

	.chart-cross {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--border-hover);
		pointer-events: none;
	}

	/* 8px, with a ring of the surface so it lifts off the line. */
	.chart-dot {
		position: absolute;
		width: var(--space-sm);
		height: var(--space-sm);
		border-radius: var(--radius-pill);
		background: var(--text);
		box-shadow: 0 0 0 2px var(--surface);
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.chart-cross[hidden],
	.chart-dot[hidden],
	.chart-tip[hidden] {
		display: none;
	}

	.chart-axis {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-subtle);
	}

	/* The time and both values, above the charts so the pointer never hides it. */
	.chart-tip {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 3;
		margin: 0;
		padding: var(--space-3xs) var(--space-md);
		border: 1px solid var(--border-hover);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		transform: translate(-50%, -110%);
		pointer-events: none;
	}
</style>
