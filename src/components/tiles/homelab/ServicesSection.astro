---
import Section from './Section.astro';
import LiveDot from '../../ui/LiveDot.astro';
import Icon from '../../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n';
import { services } from '../../../lib/services';
import { UPTIME_PLACEHOLDER, type Uptime } from '../../../lib/mocks/uptime';

/**
 * Host uptime and the homelab apps as pills (docs/koncept.md §3.4, §14): the
 * name, its icon and a dot — green up, red down (§5), grey without a monitor.
 * Only names and states are public; addresses and response times stay on
 * the private dashboard.
 */
interface Props {
	uptime: Uptime;
	endpoint?: string;
}

const { uptime, endpoint } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = uptime.data ?? UPTIME_PLACEHOLDER;

/* Under a day the number is hours, so a fresh restart does not read "0". */
const host = (days: number) =>
	days >= 1
		? `${Math.floor(days)} ${t('uptime.days')}`
		: `${Math.floor(days * 24)} ${t('uptime.hours')}`;

const byName = new Map((d.apps ?? []).map((app) => [app.name, app.up]));
const state = (name: string) => {
	const up = byName.get(name);
	return up === true && uptime.state === 'ok' ? 'up' : up === false ? 'down' : 'none';
};
---

<Section
	title={t('homelab.services')}
	live={uptime}
	class="services-section"
	data-endpoint={endpoint}
	data-days={t('uptime.days')}
	data-hours={t('uptime.hours')}
	data-down={t('uptime.down')}
>
	<span slot="meta" class="services-host">{uptime.data ? host(d.uptimeDays) : ''}</span>

	<ul class="apps">
		{
			services.map((service) => (
				<li class="app" data-name={service.name} data-skeleton>
					<LiveDot
						state={state(service.name)}
						label={state(service.name) === 'down' ? t('uptime.down') : undefined}
					/>
					<Icon name={service.icon} size={12} />
					<span>{service.name}</span>
				</li>
			))
		}
	</ul>
</Section>

<script>
	import { setText, watchLive } from '../../../scripts/live';
	import type { AppStatus } from '../../../lib/mocks/uptime';

	interface UptimeData {
		uptimeDays: number;
		apps?: AppStatus[];
	}

	for (const section of document.querySelectorAll<HTMLElement>('.services-section[data-endpoint]')) {
		const { days = '', hours = '', down = '' } = section.dataset;

		watchLive<UptimeData>(section, (data) => {
			const underDay = data.uptimeDays < 1;
			const value = Math.floor(underDay ? data.uptimeDays * 24 : data.uptimeDays);
			setText(section.querySelector('.services-host'), `${value} ${underDay ? hours : days}`);

			const byName = new Map((data.apps ?? []).map((app) => [app.name, app.up]));
			for (const app of section.querySelectorAll<HTMLElement>('.app')) {
				const up = byName.get(app.dataset.name ?? '');
				const status = up === true ? 'up' : up === false ? 'down' : 'none';
				const dot = app.querySelector<HTMLElement>('.live-dot');
				if (!dot) continue;
				dot.dataset.state = status;
				if (status === 'down') {
					dot.setAttribute('role', 'img');
					dot.setAttribute('aria-label', down);
				} else {
					dot.removeAttribute('role');
					dot.removeAttribute('aria-label');
				}
			}
		});
	}
</script>

<style>
	.services-host {
		color: var(--text-muted);
	}

	.apps {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The same pill as the tags elsewhere, with the state dot in front. */
	.app {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-2xs) var(--space-sm);
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		line-height: 1.4;
		color: var(--text-muted);
		white-space: nowrap;
	}
</style>
