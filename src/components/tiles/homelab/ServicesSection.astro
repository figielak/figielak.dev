---
import Section from './Section.astro';
import LiveDot from '../../ui/LiveDot.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n';
import { availabilityBar, BAR_FLOOR } from '../../../lib/uptime';
import { uptimePercent } from '../../../lib/units';
import { SERVICE_KINDS, UPTIME_PLACEHOLDER, type ServiceStatus, type Uptime } from '../../../lib/mocks/uptime';

/**
 * Host uptime and the services under generic names (koncept.md §3.4, §14):
 * state, 30-day availability and average response time. Up is green, down
 * red (§5). Under each service a bar shows its availability from BAR_FLOOR
 * upwards, so 96% and 99% look different. A kind the homelab does not run
 * is not a row of dashes but one "no data: …" line under the others.
 */
interface Props {
	uptime: Uptime;
	endpoint?: string;
}

const { uptime, endpoint } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = uptime.data ?? UPTIME_PLACEHOLDER;

/* Under a day the number is hours, so a fresh restart does not read "0". */
const host = (days: number) =>
	days >= 1
		? `${Math.floor(days)} ${t('uptime.days')}`
		: `${Math.floor(days * 24)} ${t('uptime.hours')}`;

const detail = (service: ServiceStatus) =>
	[
		service.uptime30d === undefined ? undefined : uptimePercent(service.uptime30d, lang),
		service.avgMs === undefined ? undefined : `${Math.round(service.avgMs)} ms`,
	]
		.filter(Boolean)
		.join(' · ');

const status = (service?: ServiceStatus) => (!service ? 'none' : service.up ? 'up' : 'down');

/* While loading every row is a skeleton; with data only the known kinds show. */
const rows = SERVICE_KINDS.map((kind) => {
	const service = d.services.find((s) => s.kind === kind);
	return {
		kind,
		status: status(service),
		detail: service ? detail(service) : '',
		bar: availabilityBar(service?.uptime30d),
		uptime30d: service?.uptime30d,
		hidden: Boolean(uptime.data) && !service,
	};
});
const missing = rows.filter((row) => row.hidden).map((row) => t(`service.${row.kind}`));
---

<Section
	title={t('homelab.services')}
	live={uptime}
	class="services-section"
	data-endpoint={endpoint}
	data-lang={lang}
	data-days={t('uptime.days')}
	data-hours={t('uptime.hours')}
	data-down={t('uptime.down')}
	data-missing={t('homelab.missing')}
>
	<span slot="meta" class="services-host">{uptime.data ? host(d.uptimeDays) : ''}</span>

	<div class="services">
		<ul class="services-list">
			{
				rows.map((row) => (
					<li class="service" data-kind={row.kind} data-status={row.status} hidden={row.hidden}>
						<LiveDot
							state={row.status === 'down' ? 'down' : row.status === 'up' && uptime.state === 'ok' ? 'up' : 'none'}
							label={row.status === 'down' ? t('uptime.down') : undefined}
						/>
						<span class="service-name" data-skeleton>
							{t(`service.${row.kind}`)}
						</span>
						<span class="service-detail" data-skeleton>
							{row.detail}
						</span>
						<span
							class="service-track"
							role="meter"
							aria-label={t(`service.${row.kind}`)}
							aria-valuemin={BAR_FLOOR}
							aria-valuemax="100"
							aria-valuenow={row.uptime30d}
						>
							<span class="service-fill" style={`width: ${row.bar}%`} />
						</span>
					</li>
				))
			}
		</ul>
		<p class="services-missing" hidden={missing.length === 0}>
			{t('homelab.missing').replace('{list}', missing.join(', '))}
		</p>
	</div>
</Section>

<script>
	import { setText, watchLive } from '../../../scripts/live';
	import { uptimePercent } from '../../../lib/units';
	import { availabilityBar } from '../../../lib/uptime';
	import type { ServiceStatus } from '../../../lib/mocks/uptime';

	interface UptimeData {
		uptimeDays: number;
		services: ServiceStatus[];
	}

	for (const section of document.querySelectorAll<HTMLElement>('.services-section[data-endpoint]')) {
		const { lang = 'pl', days = '', hours = '', down = '', missing = '{list}' } = section.dataset;

		watchLive<UptimeData>(section, (data) => {
			const underDay = data.uptimeDays < 1;
			const value = Math.floor(underDay ? data.uptimeDays * 24 : data.uptimeDays);
			setText(section.querySelector('.services-host'), `${value} ${underDay ? hours : days}`);

			const absent: string[] = [];
			for (const row of section.querySelectorAll<HTMLElement>('.service')) {
				const service = data.services.find((s) => s.kind === row.dataset.kind);
				const status = !service ? 'none' : service.up ? 'up' : 'down';
				row.dataset.status = status;
				row.hidden = !service;
				if (!service) {
					absent.push(row.querySelector('.service-name')?.textContent?.trim() ?? '');
					continue;
				}

				const dot = row.querySelector<HTMLElement>('.live-dot');
				if (dot) {
					dot.dataset.state = status;
					if (status === 'down') {
						dot.setAttribute('role', 'img');
						dot.setAttribute('aria-label', down);
					} else {
						dot.removeAttribute('role');
						dot.removeAttribute('aria-label');
					}
				}

				const parts = [
					service.uptime30d === undefined ? undefined : uptimePercent(service.uptime30d, lang),
					service.avgMs === undefined ? undefined : `${Math.round(service.avgMs)} ms`,
				].filter(Boolean);
				setText(row.querySelector('.service-detail'), parts.join(' · '));

				const track = row.querySelector<HTMLElement>('.service-track');
				if (service.uptime30d !== undefined) track?.setAttribute('aria-valuenow', String(service.uptime30d));
				track
					?.querySelector<HTMLElement>('.service-fill')
					?.style.setProperty('width', `${availabilityBar(service.uptime30d)}%`);
			}

			const line = section.querySelector<HTMLElement>('.services-missing');
			if (line) {
				line.hidden = absent.length === 0;
				setText(line, missing.replace('{list}', absent.join(', ')));
			}
		});
	}
</script>

<style>
	.services {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.services-host {
		color: var(--text-muted);
	}

	.services-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
		gap: var(--space-md) var(--space-xl);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Dot, name and figures on one line, the availability bar under them. */
	.service {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		column-gap: var(--space-sm);
		row-gap: var(--space-xs);
		min-width: 0;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.service[hidden] {
		display: none;
	}

	.service-name {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.service-detail {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
	}

	.service-track {
		grid-column: 1 / -1;
		display: block;
		height: var(--size-bar);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.service-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--text-muted);
	}

	.service[data-status='down'] .service-fill {
		background: var(--status-down);
	}

	.services-missing {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		color: var(--text-subtle);
	}
</style>
