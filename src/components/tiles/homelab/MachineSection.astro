---
import Section from './Section.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n';
import { percent, usedOf } from '../../../lib/units';
import { MACHINE_PLACEHOLDER, type MachineStats } from '../../../lib/mocks/stats';

/**
 * Machine usage pushed by the agent (docs/koncept.md §9): the hardware and the
 * container count on one line, then a column each for CPU, RAM and every
 * disk (GPU only when the machine has one) — the percentage large, a bar,
 * and under it what the percentage is of: CPU temperature, GB used of the
 * total. A bar turns red from ALERT_AT, so a nearly full disk or a busy CPU
 * stands out. Only the current reading: a history would show when someone
 * at home is using the server (§14).
 *
 * `showContainers={false}` leaves out the container count where a list of
 * the containers sits beside it: the agent counts all of them, the list
 * names only some, and two numbers on one tile would disagree. `compact`
 * puts each value on its label's line, for a narrow column (the private
 * server tile).
 */
interface Props {
	stats: MachineStats;
	endpoint?: string;
	showContainers?: boolean;
	compact?: boolean;
}

const ALERT_AT = 85;
/* The machine itself; the agent does not send it, it does not change. */
const HARDWARE = 'Raspberry Pi 4 · ARM64';

const { stats, endpoint, showContainers = true, compact = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = stats.data ?? MACHINE_PLACEHOLDER;

const spec = [HARDWARE, showContainers && d.containers !== undefined ? t('stats.containers').replace('{n}', String(d.containers)) : undefined]
	.filter(Boolean)
	.join(' · ');

const gauges = [
	{ label: t('stats.cpu'), value: d.cpu, detail: t('stats.temp').replace('{n}', String(Math.round(d.cpuTempC))) },
	{ label: t('stats.ram'), value: percent(d.ramUsedGb, d.ramTotalGb), detail: usedOf(d.ramUsedGb, d.ramTotalGb, lang) },
	...(d.gpu === undefined ? [] : [{ label: t('stats.gpu'), value: d.gpu, detail: '' }]),
	...d.disks.map((disk) => ({
		label: t(`disk.${disk.kind}`),
		value: percent(disk.usedGb, disk.totalGb),
		detail: usedOf(disk.usedGb, disk.totalGb, lang),
	})),
].map((gauge) => ({ ...gauge, value: Math.round(Math.min(100, Math.max(0, gauge.value))) }));
---

<Section
	live={stats}
	class="machine-section"
	data-endpoint={endpoint}
	data-lang={lang}
	data-hardware={HARDWARE}
	data-containers={showContainers ? t('stats.containers') : undefined}
	data-temp={t('stats.temp')}
>
	{!compact && <span slot="meta" class="machine-spec">{spec}</span>}

	<div class="machine" data-compact={compact ? '' : undefined}>
		<div class="machine-gauges">
			{
				gauges.map((gauge) => (
					<div class="gauge" data-alert-at={ALERT_AT} data-alert={gauge.value >= ALERT_AT ? '' : undefined}>
						<span class="gauge-label">{gauge.label}</span>
						<span class="gauge-value" data-skeleton aria-live="polite">
							{gauge.value}%
						</span>
						<span
							class="gauge-track"
							role="meter"
							aria-label={gauge.label}
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow={gauge.value}
						>
							<span class="gauge-fill" style={`width: ${gauge.value}%`} />
						</span>
						<span class="gauge-detail" data-skeleton>
							{gauge.detail || ' '}
						</span>
					</div>
				))
			}
		</div>
	</div>
</Section>

<script>
	import { setText, watchLive } from '../../../scripts/live';
	import { percent, usedOf } from '../../../lib/units';
	import type { LabSection } from '../../../lib/server/homelab';

	/* Columns come from the first render: CPU, RAM, then the disks in order. */
	function setGauge(gauge: HTMLElement | undefined, value: number, detail: string) {
		if (!gauge) return;
		const rounded = Math.round(Math.min(100, Math.max(0, value)));
		const alertAt = Number(gauge.dataset.alertAt);
		gauge.toggleAttribute('data-alert', !Number.isNaN(alertAt) && rounded >= alertAt);
		gauge.querySelector<HTMLElement>('.gauge-fill')?.style.setProperty('width', `${rounded}%`);
		gauge.querySelector('.gauge-track')?.setAttribute('aria-valuenow', String(rounded));
		setText(gauge.querySelector('.gauge-value'), `${rounded}%`);
		setText(gauge.querySelector('.gauge-detail'), detail || ' ');
	}

	for (const section of document.querySelectorAll<HTMLElement>('.machine-section[data-endpoint]')) {
		const { lang = 'pl', hardware = '', containers, temp = '{n}' } = section.dataset;

		watchLive<LabSection>(section, (data) => {
			const [cpu, ram, ...disks] = section.querySelectorAll<HTMLElement>('.gauge');
			setGauge(cpu, data.cpu, temp.replace('{n}', String(Math.round(data.cpuTempC))));
			setGauge(ram, percent(data.ramUsedGb, data.ramTotalGb), usedOf(data.ramUsedGb, data.ramTotalGb, lang));
			data.disks.forEach((disk, i) =>
				setGauge(disks[i], percent(disk.usedGb, disk.totalGb), usedOf(disk.usedGb, disk.totalGb, lang)),
			);

			const spec = [
				hardware,
				data.containers === undefined || containers === undefined ? undefined : containers.replace('{n}', String(data.containers)),
			].filter(Boolean);
			setText(section.querySelector('.machine-spec'), spec.join(' · '));
		});
	}
</script>

<style>
	.machine {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	/* In the section heading, in place of a title. */
	.machine-spec {
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--text-muted);
	}

	.machine-gauges {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(7rem, 100%), 1fr));
		gap: var(--space-md) var(--space-xl);
	}

	.gauge {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.gauge-label {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.gauge-value {
		align-self: flex-start;
		font-family: var(--font-mono);
		font-size: var(--size-hero);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
	}

	.gauge-track {
		display: block;
		height: var(--size-bar);
		margin-block: var(--space-2xs);
		border-radius: var(--radius-pill);
		background: var(--surface-inset);
		overflow: hidden;
	}

	.gauge-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--text-muted);
	}

	.gauge[data-alert] .gauge-fill {
		background: var(--status-down);
	}

	/* Dashboard intro: the bar grows from zero once its tile is in. */
	:global(.tile[data-reveal]) .gauge-fill {
		transform-origin: left;
		animation: gauge-grow var(--duration-grow) var(--ease-out) both;
	}

	@keyframes gauge-grow {
		from {
			transform: scaleX(0);
		}
	}

	/* Narrow column: `CPU … 7%` on one line, the bar and the detail under it. */
	.machine[data-compact] .machine-gauges {
		grid-template-columns: repeat(auto-fit, minmax(min(6rem, 100%), 1fr));
		gap: var(--space-sm) var(--space-xl);
	}

	.machine[data-compact] .gauge {
		display: grid;
		grid-template-columns: minmax(0, auto) 1fr;
		column-gap: var(--space-md);
	}

	.machine[data-compact] .gauge-value {
		justify-self: end;
		font-size: var(--size-label);
		font-weight: 400;
	}

	.machine[data-compact] .gauge-track,
	.machine[data-compact] .gauge-detail {
		grid-column: 1 / -1;
	}

	.machine[data-compact] .gauge-track {
		margin-block: 0;
	}

	/* Room for one detail only: the CPU temperature, as before. */
	.machine[data-compact] .gauge:not(:first-child) .gauge-detail {
		display: none;
	}

	.gauge-detail {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text-muted);
	}
</style>
