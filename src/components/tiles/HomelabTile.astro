---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import MachineSection from './homelab/MachineSection.astro';
import ServicesSection from './homelab/ServicesSection.astro';
import TrafficSection from './homelab/TrafficSection.astro';
import DnsSection from './homelab/DnsSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState, worstState } from '../../lib/live';
import type { MachineStats } from '../../lib/mocks/stats';
import type { Uptime } from '../../lib/mocks/uptime';
import type { Dns, Traffic } from '../../lib/mocks/network';

/**
 * The homelab as one machine (docs/koncept.md §3.4): usage, services, traffic and
 * ad blocking, each a section with its own source and states (§9). The dot
 * shows the worst of them; only when every section failed does the tile say
 * it is offline.
 *
 * With `endpoints` the sections render as loading and fill themselves in the
 * browser; without them they show the data given (mocks in /dev/tiles).
 */
interface Props {
	stats: MachineStats;
	uptime: Uptime;
	traffic: Traffic;
	dns: Dns;
	endpoints?: { lab: string; uptime: string; net: string; dns: string };
	area?: string;
}

const { stats, uptime, traffic, dns, endpoints, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const states = [stats.state, uptime.state, traffic.state, dns.state];
const offline = states.every((state) => state === 'error');
---

<Tile
	area={area}
	label={t('tile.lab')}
	icon="server"
	dense
	class="homelab-tile"
	data-offline={offline ? '' : undefined}
>
	<LiveDot slot="meta" state={dotState(worstState(states))} />

	<div class="homelab">
		<div class="homelab-sections">
			<MachineSection stats={stats} endpoint={endpoints?.lab} />
			<ServicesSection uptime={uptime} endpoint={endpoints?.uptime} />
			<div class="homelab-pair">
				<TrafficSection traffic={traffic} endpoint={endpoints?.net} />
				<DnsSection dns={dns} endpoint={endpoints?.dns} />
			</div>
		</div>
		<p class="homelab-offline">{t('lab.offline')}</p>
	</div>
</Tile>

<style>
	.homelab {
		position: relative;
		height: 100%;
		min-width: 0;
	}

	/* Sections spread over the height, a hairline between them. */
	.homelab-sections {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-lg);
		height: 100%;
	}

	.homelab-sections > :global(* + *) {
		padding-top: var(--space-lg);
		border-top: 1px solid var(--border);
	}

	/* Traffic and ad blocking are short, so they share the last row. */
	.homelab-pair {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
		gap: var(--space-lg) var(--space-xl);
	}

	.homelab-offline {
		display: none;
		position: absolute;
		inset: 0;
		place-items: center;
		margin: 0;
		color: var(--text-subtle);
	}

	:global(.homelab-tile[data-offline]) .homelab-sections {
		visibility: hidden;
	}

	:global(.homelab-tile[data-offline]) .homelab-offline {
		display: grid;
	}
</style>
