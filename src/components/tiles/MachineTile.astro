---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import StatBar from '../ui/StatBar.astro';
import { getLangFromUrl, useTranslations, type TranslationKey } from '../../i18n';
import { dotState } from '../../lib/live';
import { MACHINE_PLACEHOLDER, type MachineStats } from '../../lib/mocks/stats';

/**
 * Body of the homelab tile: usage bars pushed by the agent (koncept.md §9).
 * Use LabTile, not this directly.
 */
interface Props {
	stats: MachineStats;
	label: TranslationKey;
	offline: TranslationKey;
	area?: string;
}

const { stats, label, offline, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = stats.data ?? MACHINE_PLACEHOLDER;

const number = new Intl.NumberFormat(lang, { maximumFractionDigits: 1 });
const size = (gb: number) => (gb >= 1000 ? `${number.format(gb / 1000)} TB` : `${number.format(gb)} GB`);
const percent = (used: number, total: number) => (total > 0 ? (used / total) * 100 : 0);

const footer =
	d.containers === undefined
		? t('stats.cpuTemp').replace('{n}', String(d.cpuTempC))
		: `${t('stats.containers').replace('{n}', String(d.containers))} · ${t('stats.cpuTemp').replace('{n}', String(d.cpuTempC))}`;
---

<Tile area={area} label={t(label)} dense>
	<LiveDot slot="meta" state={dotState(stats.state)} />

	<LiveBody state={stats.state} errorText={t(offline)}>
		<div class="machine">
			<StatBar label={t('stats.cpu')} value={d.cpu} />
			<StatBar
				label={t('stats.ram')}
				value={percent(d.ramUsedGb, d.ramTotalGb)}
				detail={`${number.format(d.ramUsedGb)} / ${size(d.ramTotalGb)}`}
			/>
			<StatBar label={t('stats.gpu')} value={d.gpu} />
			<hr class="machine-divider" />
			{
				d.disks.map((disk) => (
					<StatBar
						label={t(`disk.${disk.kind}`)}
						value={percent(disk.usedGb, disk.totalGb)}
						detail={`${size(disk.usedGb)} / ${size(disk.totalGb)}`}
					/>
				))
			}
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={stats}>{footer}</LiveFooter>
</Tile>

<style>
	.machine {
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		gap: var(--space-md);
		height: 100%;
	}

	.machine-divider {
		width: 100%;
		margin: 0;
		border: 0;
		border-top: 1px solid var(--border);
	}
</style>
