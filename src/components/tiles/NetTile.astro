---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { decimal } from '../../lib/units';
import { TRAFFIC_PLACEHOLDER, type Traffic } from '../../lib/mocks/network';

/**
 * Traffic of the homelab itself — the Pi's Wi-Fi, not the whole home — today
 * and in total since the agent first ran; pushed by the agent (koncept.md §9).
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `traffic` as given (mocks in /dev/tiles).
 */
interface Props {
	traffic: Traffic;
	endpoint?: string;
	area?: string;
}

const { traffic, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = traffic.data ?? TRAFFIC_PLACEHOLDER;

const rows = [
	{ icon: 'arrow-down', label: t('net.down'), value: d.downGbToday },
	{ icon: 'arrow-up', label: t('net.up'), value: d.upGbToday },
] as const;

const sinceDate = (iso: string) =>
	new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'numeric' }).format(new Date(`${iso}T12:00:00Z`));
const total = (data: typeof d) =>
	t('net.total')
		.replace('{date}', sinceDate(data.totalSince))
		.replace('{down}', decimal(data.downGbTotal, lang))
		.replace('{up}', decimal(data.upGbTotal, lang));
---

<Tile
	area={area}
	label={t('tile.net')}
	dense
	class="net-tile"
	data-endpoint={endpoint}
	data-lang={lang}
	data-total={t('net.total')}
>
	<LiveDot slot="meta" state={dotState(traffic.state)} />

	<LiveBody state={traffic.state} errorText={t('net.unavailable')}>
		<div class="net">
			<dl class="net-today">
				{
					rows.map((row) => (
						<div class="net-row">
							<dt class="net-label">
								<Icon name={row.icon} size={14} />
								<span class="visually-hidden">{row.label}</span>
							</dt>
							<dd class="net-value" data-skeleton aria-live="polite">
								{decimal(row.value, lang)} GB
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={traffic}>{total(d)}</LiveFooter>
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import { decimal } from '../../lib/units';
	import type { TrafficSection } from '../../lib/server/homelab';

	for (const tile of document.querySelectorAll<HTMLElement>('.net-tile[data-endpoint]')) {
		const { lang = 'pl', total = '' } = tile.dataset;
		const date = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'numeric' });

		watchLive<TrafficSection>(tile, (data) => {
			const values = tile.querySelectorAll('.net-value');
			setText(values[0], `${decimal(data.downGbToday, lang)} GB`);
			setText(values[1], `${decimal(data.upGbToday, lang)} GB`);
			setText(
				tile.querySelector('.live-footer-detail'),
				total
					.replace('{date}', date.format(new Date(`${data.totalSince}T12:00:00Z`)))
					.replace('{down}', decimal(data.downGbTotal, lang))
					.replace('{up}', decimal(data.upGbTotal, lang)),
			);
		});
	}
</script>

<style>
	.net {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
	}

	.net-today {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		margin: 0;
	}

	.net-row {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.net-label {
		display: inline-flex;
		color: var(--text-subtle);
	}

	.net-value {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--size-title);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
</style>
