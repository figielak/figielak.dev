---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';

/**
 * Local time in Europe/Warsaw, ticking every second (koncept.md §3.4).
 * It runs in the browser, so it is always live and has no other states.
 */
interface Props {
	area?: string;
}

const { area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const zone = 'Europe/Warsaw';
---

<Tile area={area} label={t('tile.clock')} dense>
	<LiveDot slot="meta" state="live" />

	<div class="clock">
		<p class="clock-time">
			<time data-clock data-locale={lang} data-time-zone={zone}>--:--</time><time
				class="clock-seconds"
				data-clock
				data-clock-format="seconds"
				data-locale={lang}
				data-time-zone={zone}>--</time
			>
		</p>
		<time class="clock-date" data-clock data-clock-format="date" data-locale={lang} data-time-zone={zone}
			>&nbsp;</time
		>
	</div>

	<span slot="footer" class="clock-zone">
		{t('clock.zone')} · <time data-clock data-clock-format="offset" data-locale={lang} data-time-zone={zone}
			>GMT</time
		>
	</span>
</Tile>

<script>
	import { startClocks } from '../../scripts/clock';

	startClocks();
</script>

<style>
	.clock {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-2xs);
		height: 100%;
		container-type: inline-size;
	}

	.clock-time {
		margin: 0;
		font-family: var(--font-mono);
		/* Five characters must fit a 1×1 tile, whatever its width. */
		font-size: min(var(--size-number), 30cqi);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.clock-seconds {
		margin-left: var(--space-2xs);
		font-size: 0.45em;
		color: var(--text-subtle);
	}

	.clock-date {
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.clock-zone {
		font-family: var(--font-mono);
		color: var(--text-subtle);
	}
</style>
