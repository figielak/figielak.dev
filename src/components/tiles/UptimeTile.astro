---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { UPTIME_PLACEHOLDER, type Uptime } from '../../lib/mocks/uptime';

/**
 * Homelab uptime and service status (koncept.md §3.4). A service that is up
 * gets the accent dot, one that is down stays subtle (§5).
 */
interface Props {
	uptime: Uptime;
	area?: string;
}

const { uptime, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = uptime.data ?? UPTIME_PLACEHOLDER;
---

<Tile area={area} label={t('tile.uptime')} dense>
	<LiveDot slot="meta" state={dotState(uptime.state)} />

	<LiveBody state={uptime.state} errorText={t('uptime.unavailable')}>
		<div class="uptime">
			<p class="uptime-days">
				<span class="uptime-number" data-skeleton aria-live="polite">{d.uptimeDays}</span>
				<span class="uptime-unit">{t('uptime.days')}</span>
			</p>
			<ul class="uptime-services">
				{
					d.services.map((service) => (
						<li class="uptime-service" data-up={service.up ? '' : undefined}>
							<LiveDot
								state={service.up && uptime.state === 'ok' ? 'live' : 'offline'}
								label={service.up ? undefined : t('uptime.down')}
							/>
							<span data-skeleton>{t(`service.${service.kind}`)}</span>
						</li>
					))
				}
			</ul>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={uptime} />
</Tile>

<style>
	.uptime {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xl);
		height: 100%;
		min-width: 0;
	}

	.uptime-days {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		margin: 0;
	}

	.uptime-number {
		font-family: var(--font-mono);
		font-size: var(--size-number);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.uptime-unit {
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	.uptime-services {
		display: grid;
		grid-template-columns: repeat(2, auto);
		gap: var(--space-xs) var(--space-xl);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.uptime-service {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		color: var(--text-subtle);
		white-space: nowrap;
	}

	.uptime-service[data-up] {
		color: var(--text-muted);
	}
</style>
