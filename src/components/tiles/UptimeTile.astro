---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { uptimePercent } from '../../lib/units';
import { SERVICE_KINDS, UPTIME_PLACEHOLDER, type ServiceStatus, type Uptime } from '../../lib/mocks/uptime';

/**
 * Homelab uptime and service status (koncept.md §3.4): host uptime, and for
 * each generic service kind its state, 30-day availability and average
 * response time. A service that is up gets the accent dot, one that is down
 * stays subtle (§5); a kind the homelab does not run yet shows "—".
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser; without it, it shows `uptime` as given (mocks in /dev/tiles).
 */
interface Props {
	uptime: Uptime;
	endpoint?: string;
	area?: string;
}

const { uptime, endpoint, area } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = uptime.data ?? UPTIME_PLACEHOLDER;

/* Under a day the number is hours, so a fresh restart does not read "0". */
const hostUptime = (days: number) =>
	days >= 1
		? { value: Math.floor(days), unit: t('uptime.days') }
		: { value: Math.floor(days * 24), unit: t('uptime.hours') };
const host = hostUptime(d.uptimeDays);

const detail = (service?: ServiceStatus) =>
	[
		service?.uptime30d === undefined ? undefined : uptimePercent(service.uptime30d, lang),
		service?.avgMs === undefined ? undefined : `${Math.round(service.avgMs)} ms`,
	]
		.filter(Boolean)
		.join(' · ') || '—';

const status = (service?: ServiceStatus) => (!service ? 'none' : service.up ? 'up' : 'down');

const rows = SERVICE_KINDS.map((kind) => {
	const service = d.services.find((s) => s.kind === kind);
	return { kind, status: status(service), detail: detail(service) };
});
---

<Tile
	area={area}
	label={t('tile.uptime')}
	dense
	class="uptime-tile"
	data-endpoint={endpoint}
	data-lang={lang}
	data-days={t('uptime.days')}
	data-hours={t('uptime.hours')}
	data-down={t('uptime.down')}
	data-none={t('uptime.none')}
>
	<LiveDot slot="meta" state={dotState(uptime.state)} />

	<LiveBody state={uptime.state} errorText={t('uptime.unavailable')}>
		<div class="uptime">
			<p class="uptime-host">
				<span class="uptime-number" data-skeleton aria-live="polite">{host.value}</span>
				<span class="uptime-unit">{host.unit}</span>
			</p>
			<ul class="uptime-services">
				{
					rows.map((row) => (
						<li class="uptime-service" data-kind={row.kind} data-status={row.status}>
							<LiveDot
								state={row.status === 'up' && uptime.state === 'ok' ? 'live' : 'offline'}
								label={
									row.status === 'down' ? t('uptime.down') : row.status === 'none' ? t('uptime.none') : undefined
								}
							/>
							<span class="uptime-name" data-skeleton>
								{t(`service.${row.kind}`)}
							</span>
							<span class="uptime-detail" data-skeleton>
								{row.detail}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={uptime} />
</Tile>

<script>
	import { setText, watchLive } from '../../scripts/live';
	import { uptimePercent } from '../../lib/units';
	import type { ServiceStatus } from '../../lib/mocks/uptime';

	interface UptimeData {
		uptimeDays: number;
		services: ServiceStatus[];
	}

	for (const tile of document.querySelectorAll<HTMLElement>('.uptime-tile[data-endpoint]')) {
		const { lang = 'pl', days = '', hours = '', down = '', none = '' } = tile.dataset;

		watchLive<UptimeData>(tile, (data) => {
			const underDay = data.uptimeDays < 1;
			setText(
				tile.querySelector('.uptime-number'),
				String(Math.floor(underDay ? data.uptimeDays * 24 : data.uptimeDays)),
			);
			setText(tile.querySelector('.uptime-unit'), underDay ? hours : days);

			for (const row of tile.querySelectorAll<HTMLElement>('.uptime-service')) {
				const service = data.services.find((s) => s.kind === row.dataset.kind);
				const status = !service ? 'none' : service.up ? 'up' : 'down';
				row.dataset.status = status;

				/* The tile's own dot turns grey when stale; a row's dot follows the service. */
				const dot = row.querySelector<HTMLElement>('.live-dot');
				if (dot) {
					dot.dataset.state = status === 'up' ? 'live' : 'offline';
					if (status === 'up') {
						dot.removeAttribute('role');
						dot.removeAttribute('aria-label');
					} else {
						dot.setAttribute('role', 'img');
						dot.setAttribute('aria-label', status === 'down' ? down : none);
					}
				}

				const parts = [
					service?.uptime30d === undefined ? undefined : uptimePercent(service.uptime30d, lang),
					service?.avgMs === undefined ? undefined : `${Math.round(service.avgMs)} ms`,
				].filter(Boolean);
				setText(row.querySelector('.uptime-detail'), parts.join(' · ') || '—');
			}
		});
	}
</script>

<style>
	.uptime {
		display: flex;
		align-items: center;
		gap: var(--space-xl);
		height: 100%;
		min-width: 0;
	}

	.uptime-host {
		display: flex;
		flex: none;
		flex-direction: column;
		gap: var(--space-2xs);
		margin: 0;
	}

	.uptime-number {
		font-family: var(--font-mono);
		font-size: var(--size-number);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.uptime-unit {
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	/* Two columns where there is room, one on a narrow tile. */
	.uptime-services {
		display: grid;
		flex: 1;
		grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
		gap: var(--space-xs) var(--space-xl);
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.uptime-service {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		min-width: 0;
		color: var(--text-subtle);
		white-space: nowrap;
	}

	.uptime-service[data-status='up'] {
		color: var(--text-muted);
	}

	.uptime-name {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.uptime-detail {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
	}
</style>
