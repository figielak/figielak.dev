---
import Tile from '../ui/Tile.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { books } from '../../lib/books';

/** Books I am reading now (koncept.md §3.4). Static — edit src/lib/books.ts. */
interface Props {
	area?: string;
}

const { area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Tile area={area} label={t('tile.books')} dense>
	<ul class="books">
		{
			books.map((book) => (
				<li class="book">
					<span class="book-text">
						<span class="book-title">{book.title}</span>
						<span class="book-author">{book.author}</span>
					</span>
					{book.progress !== undefined && <span class="book-progress">{book.progress}%</span>}
				</li>
			))
		}
	</ul>
</Tile>

<style>
	.books {
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		gap: var(--space-md);
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.book {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		min-width: 0;
	}

	.book-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.book-title,
	.book-author {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.book-title {
		font-weight: 500;
	}

	.book-author {
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	.book-progress {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
		color: var(--text-subtle);
	}
</style>
