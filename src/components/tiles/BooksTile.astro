---
import Tile from '../ui/Tile.astro';
import Icon from '../ui/Icon.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { BOOKS_PLACEHOLDER, type Book, type Books } from '../../lib/mocks/books';

/**
 * Books I am reading now, from Hardcover (koncept.md §3.4, §9), each with
 * its cover in full colour (§4) beside the title and author. Three at a
 * time: with more, a click turns the card over to the next three.
 *
 * With `endpoint` the tile renders as loading and fills itself in the
 * browser, refreshing every hour; without it, it shows `books` as given.
 * The pages are built again from each response, so the markup of one book
 * lives in a <template> shared by the server and the browser.
 */
interface Props {
	books: Books;
	endpoint?: string;
	area?: string;
}

const PAGE_SIZE = 3;
/* Cached for an hour on the server, so stale only after three (as GitHub). */
const STALE_AFTER_MIN = 3 * 60;

const { books, endpoint, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const list: Book[] = (books.data ?? BOOKS_PLACEHOLDER).books;

const pages = Array.from({ length: Math.ceil(list.length / PAGE_SIZE) }, (_, i) =>
	list.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
);
const paged = pages.length > 1;
const pageLabel = (n: number) =>
	t('books.page').replace('{n}', String(n)).replace('{total}', String(pages.length));
const coverAlt = (title: string) => t('books.cover').replace('{title}', title);
---

<Tile
	area={area}
	label={t('tile.books')}
	icon="book"
	dense
	interactive={paged}
	class="books-tile"
	data-endpoint={endpoint}
	data-stale-after={STALE_AFTER_MIN}
	data-page-size={PAGE_SIZE}
	data-flip-label={t('books.flip')}
	data-page-label={t('books.page')}
	data-cover-label={t('books.cover')}
>
	<span slot="meta" class="books-meta">
		<span class="books-count" hidden={!paged}>
			<span data-books-count>1/{pages.length}</span>
			<Icon name="rotate-clockwise" size={14} />
		</span>
		<LiveDot state={dotState(books.state)} />
	</span>

	<LiveBody state={books.state} errorText={t('books.unavailable')}>
		<div class="books-box" data-books-box>
			{
				pages.map((page, i) => (
					<ul class="books" data-books-page hidden={i > 0}>
						{page.map((book) => (
							<li class="book">
								{book.coverUrl ? (
									<img class="book-cover" src={book.coverUrl} alt={coverAlt(book.title)} loading="lazy" decoding="async" />
								) : (
									<span class="book-cover book-cover-empty" aria-hidden="true">
										<Icon name="book" size={20} />
									</span>
								)}
								<span class="book-text">
									<span class="book-title" data-skeleton>{book.title}</span>
									<span class="book-author" data-skeleton>{book.author}</span>
								</span>
							</li>
						))}
					</ul>
				))
			}
			<p class="books-empty" hidden={list.length > 0}>{t('books.empty')}</p>
		</div>
	</LiveBody>

	<template data-books-template>
		<ul class="books" data-books-page>
			<li class="book">
				<img class="book-cover" alt="" loading="lazy" decoding="async" />
				<span class="book-cover book-cover-empty" aria-hidden="true">
					<Icon name="book" size={20} />
				</span>
				<span class="book-text">
					<span class="book-title"></span>
					<span class="book-author"></span>
				</span>
			</li>
		</ul>
	</template>

	<button
		type="button"
		class="books-flip"
		aria-label={`${t('books.flip')} (${pageLabel(1)})`}
		hidden={!paged}
		data-books-flip
	></button>

	<LiveFooter slot="footer" live={books}>Hardcover</LiveFooter>
</Tile>

<script>
	import { watchLive } from '../../scripts/live';
	import type { Books } from '../../lib/mocks/books';

	type BooksData = Omit<NonNullable<Books['data']>, 'updatedAt'>;

	/* Turn the card over: it narrows to its edge, the next page is swapped in,
	   and it widens back. A flat scaleX, not a 3D rotateY — a 3D transform on a
	   glass tile (backdrop-filter) makes Chromium light up the glow behind it.
	   Only transform moves; with reduced motion the page just changes. */
	const HALF_MS = 150;
	const HOUR = 60 * 60_000;
	const reduce = matchMedia('(prefers-reduced-motion: reduce)');

	for (const tile of document.querySelectorAll<HTMLElement>('.books-tile')) {
		const box = tile.querySelector<HTMLElement>('[data-books-box]')!;
		const empty = box.querySelector<HTMLElement>('.books-empty')!;
		/* One empty page with one book: scoped styles come with the clones. */
		const template = tile.querySelector<HTMLTemplateElement>('[data-books-template]')!;
		const pageProto = template.content.firstElementChild as HTMLElement;
		const itemProto = pageProto.firstElementChild as HTMLElement;
		itemProto.remove();
		const counter = tile.querySelector<HTMLElement>('.books-count')!;
		const count = tile.querySelector('[data-books-count]')!;
		const button = tile.querySelector<HTMLButtonElement>('[data-books-flip]')!;
		const { flipLabel = '', pageLabel = '', coverLabel = '{title}' } = tile.dataset;
		const pageSize = Number(tile.dataset.pageSize) || 3;
		let current = 0;
		let busy = false;

		const pages = () => [...box.querySelectorAll<HTMLElement>('[data-books-page]')];

		const show = (index: number) => {
			const all = pages();
			all.forEach((page, i) => (page.hidden = i !== index));
			current = index;
			const n = String(index + 1);
			const total = String(all.length);
			count.textContent = `${n}/${total}`;
			button.setAttribute(
				'aria-label',
				`${flipLabel} (${pageLabel.replace('{n}', n).replace('{total}', total)})`,
			);
		};

		const bookItem = ({ title, author, coverUrl }: BooksData['books'][number]) => {
			const item = itemProto.cloneNode(true) as HTMLElement;
			const img = item.querySelector<HTMLImageElement>('img.book-cover')!;
			const placeholder = item.querySelector('.book-cover-empty')!;
			if (coverUrl) {
				img.src = coverUrl;
				img.alt = coverLabel.replace('{title}', title);
				placeholder.remove();
			} else {
				img.remove();
			}
			item.querySelector('.book-title')!.textContent = title;
			item.querySelector('.book-author')!.textContent = author;
			return item;
		};

		/* Rebuilt only when the list changes, so an hourly refresh of the same
		   books neither reloads the covers nor turns the card back. */
		let shown = '';
		const render = (books: BooksData['books']) => {
			const key = JSON.stringify(books);
			if (key === shown) return;
			shown = key;

			pages().forEach((page) => page.remove());
			for (let i = 0; i < books.length; i += pageSize) {
				const page = pageProto.cloneNode() as HTMLElement;
				page.append(...books.slice(i, i + pageSize).map(bookItem));
				box.insertBefore(page, empty);
			}
			empty.hidden = books.length > 0;

			const paged = books.length > pageSize;
			counter.hidden = !paged;
			button.hidden = !paged;
			tile.toggleAttribute('data-interactive', paged);
			show(current < pages().length ? current : 0);
		};

		if (tile.dataset.endpoint) watchLive<BooksData>(tile, ({ books }) => render(books), HOUR);

		button.addEventListener('click', async () => {
			if (busy) return;
			const next = (current + 1) % pages().length;
			if (reduce.matches) return show(next);

			busy = true;
			const away = tile.animate(
				[{ transform: 'scaleX(1)' }, { transform: 'scaleX(0)' }],
				{ duration: HALF_MS, easing: 'ease-in', fill: 'forwards' },
			);
			await away.finished;
			show(next);
			const back = tile.animate(
				[{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
				{ duration: HALF_MS, easing: 'ease-out' },
			);
			away.cancel();
			await back.finished;
			busy = false;
		});
	}
</script>

<style>
	/* The layout follows the tile's width; on the desktop dashboard also its
	   height. A size container has no height of its own, so only there, where
	   the grid rows set it — below 1024px the rows grow with the content. */
	.books-box {
		container-type: inline-size;
		height: 100%;
	}

	@media (min-width: 1024px) {
		.books-box {
			container-type: size;
		}
	}

	/* The whole tile is the button that turns the card over. Above the cursor
	   light (z-index 2); the ring sits inside, since the tile clips its edge. */
	:global(.books-tile) {
		position: relative;
	}

	.books-flip {
		position: absolute;
		inset: 0;
		z-index: 3;
		padding: 0;
		border: 0;
		border-radius: inherit;
		background: none;
		cursor: pointer;
	}

	.books-flip:focus-visible {
		outline-offset: calc(-1 * var(--space-2xs));
	}

	.books-meta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-md);
	}

	.books-count[hidden] {
		display: none;
	}

	.books-count {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		font-variant-numeric: tabular-nums;
	}

	.books[hidden] {
		display: none;
	}

	.books-empty {
		display: grid;
		place-items: center;
		height: 100%;
		margin: 0;
		color: var(--text-muted);
		text-align: center;
	}

	.books-empty[hidden] {
		display: none;
	}

	/* Books side by side, each a cover with its title and author beside it. */
	.books {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
		align-items: center;
		gap: var(--space-lg) var(--space-xl);
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.book {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		min-width: 0;
	}

	.book-cover {
		flex: none;
		width: var(--size-book-cover);
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--space-2xs);
		background: var(--surface-inset);
	}

	.book-cover-empty {
		display: grid;
		place-items: center;
		color: var(--text-subtle);
	}

	.book-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	/* Up to three lines for a long title, then an ellipsis. */
	.book-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		font-weight: 500;
	}

	.book-author {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: var(--size-label);
		color: var(--text-muted);
	}

	/* One column, square-ish (half a phone): one book, the title under a
	   smaller cover. */
	@container (max-width: 300px) {
		.book:nth-child(n + 2) {
			display: none;
		}

		.book {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-sm);
		}

		/* The cover is an astro:assets image, outside this component's scope. */
		.book :global(.book-cover) {
			width: var(--size-book-cover-small);
		}

		.book-title {
			-webkit-line-clamp: 2;
			line-clamp: 2;
		}
	}

	/* One column but tall (the desktop dashboard): every book, one under
	   another, sharing the height; the covers shrink to fit their rows. */
	@container (max-width: 300px) and (min-height: 150px) {
		.books {
			grid-template-columns: 1fr;
			grid-auto-rows: minmax(0, 1fr);
			align-items: stretch;
			gap: var(--space-md);
		}

		.book:nth-child(n + 2) {
			display: flex;
		}

		.book {
			flex-direction: row;
			align-items: center;
			gap: var(--space-md);
			min-height: 0;
		}

		.book :global(.book-cover) {
			width: auto;
			max-width: 40%;
			height: 100%;
			max-height: calc(var(--size-book-cover) * 1.5);
		}
	}
</style>
