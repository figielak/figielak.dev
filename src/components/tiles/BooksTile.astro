---
import { Image } from 'astro:assets';
import Tile from '../ui/Tile.astro';
import Icon from '../ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { books } from '../../lib/books';

/**
 * Books I am reading now (koncept.md §3.4), each with its cover in full
 * colour (§4) beside the title and author. Static — edit src/lib/books.ts.
 */
interface Props {
	area?: string;
}

/* Rendered widths for 1x–3x screens; must match --size-book-cover. */
const COVER_PX = 72;

const { area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Tile area={area} label={t('tile.books')} icon="book" dense>
	<ul class="books">
		{
			books.map((book) => (
				<li class="book">
					{book.cover ? (
						<Image
							class="book-cover"
							src={book.cover}
							alt={t('books.cover').replace('{title}', book.title)}
							widths={[COVER_PX, COVER_PX * 2, COVER_PX * 3]}
							sizes={`${COVER_PX}px`}
						/>
					) : (
						<span class="book-cover book-cover-empty" aria-hidden="true">
							<Icon name="book" size={20} />
						</span>
					)}
					<span class="book-text">
						<span class="book-title">{book.title}</span>
						<span class="book-author">{book.author}</span>
					</span>
				</li>
			))
		}
	</ul>
</Tile>

<style>
	/* Books side by side, each a cover with its title and author beside it. */
	.books {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
		align-items: center;
		gap: var(--space-lg) var(--space-xl);
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.book {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		min-width: 0;
	}

	.book-cover {
		flex: none;
		width: var(--size-book-cover);
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--space-2xs);
		background: var(--surface-inset);
	}

	.book-cover-empty {
		display: grid;
		place-items: center;
		color: var(--text-subtle);
	}

	.book-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	/* Up to three lines for a long title, then an ellipsis. */
	.book-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		font-weight: 500;
	}

	.book-author {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: var(--size-label);
		color: var(--text-muted);
	}
</style>
