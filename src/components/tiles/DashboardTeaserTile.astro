---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n';
import {
	WEATHER_CONDITIONS,
	WEATHER_PLACEHOLDER,
	WEATHER_STALE_AFTER_MIN,
	type Weather,
} from '../../lib/mocks/weather';
import { MUSIC_PLACEHOLDER, type Music } from '../../lib/mocks/music';

/**
 * Small teaser at the bottom of the home stream: live local time and the
 * weather, linking to the full dashboard (docs/koncept.md §3.1).
 *
 * The clock is local, so it is always live. Weather and the track from
 * Last.fm go through the four live-tile states; every state keeps the same
 * footprint (docs/koncept.md §9). The track is the proof the dashboard is real.
 *
 * With `weatherEndpoint` / `musicEndpoint` a part renders as loading and
 * fills itself in the browser; without them it shows `weather` / `music`
 * as given (mocks in /dev/tiles).
 */
interface Props {
	weather: Weather;
	music: Music;
	weatherEndpoint?: string;
	musicEndpoint?: string;
}

const { weather, music, weatherEndpoint, musicEndpoint } = Astro.props;
const w = weather.data ?? WEATHER_PLACEHOLDER;
const track = (music.data ?? MUSIC_PLACEHOLDER).track;
const playing = music.state === 'ok' && track.nowPlaying;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const conditions = JSON.stringify(Object.fromEntries(WEATHER_CONDITIONS.map((c) => [c, t(`weather.${c}`)])));
---

<Tile label={t('tile.dashboard')} href={localizePath('/dashboard', lang)} dense>
	<div class="teaser">
		<time class="teaser-time" data-clock data-locale={lang} data-time-zone="Europe/Warsaw">--:--</time>

		<div
			class="teaser-weather"
			data-endpoint={weatherEndpoint}
			data-stale-after={WEATHER_STALE_AFTER_MIN}
			data-conditions={conditions}
		>
			<LiveBody state={weather.state} errorText={t('state.noData')}>
				<span class="teaser-weather-row">
					<span class="teaser-temp" data-skeleton>{w.tempC}°</span>
					<span class="teaser-detail">
						<span class="teaser-weather-line" data-skeleton>{t(`weather.${w.condition}`)} · {w.city}</span>
						<LiveFooter live={weather} staleOnly />
					</span>
				</span>
			</LiveBody>
		</div>

		<div class="teaser-music" data-endpoint={musicEndpoint}>
			<LiveBody state={music.state} errorText={t('music.unavailable')}>
				<span class="teaser-track">
					<span class="teaser-track-status" data-now={t('music.nowPlaying')} data-last={t('music.lastPlayed')}>
						<span class="teaser-track-dot" hidden={!playing}><LiveDot state="up" pulse /></span>
						<span class="teaser-track-status-text">
							{playing ? t('music.nowPlaying') : t('music.lastPlayed')}
						</span>
					</span>
					<span class="teaser-track-name" data-skeleton aria-live="polite">
						{track.title} — {track.artist}
					</span>
				</span>
			</LiveBody>
		</div>
	</div>

	<span slot="footer">{t('home.liveDashboard')}</span>
</Tile>

<script>
	import { startClocks } from '../../scripts/clock';
	import { setText, watchLive } from '../../scripts/live';
	import type { Music } from '../../lib/mocks/music';
	import type { Weather } from '../../lib/mocks/weather';

	type MusicData = Omit<NonNullable<Music['data']>, 'updatedAt'>;

	type WeatherData = Omit<NonNullable<Weather['data']>, 'updatedAt'>;

	startClocks();

	for (const section of document.querySelectorAll<HTMLElement>('.teaser-weather[data-endpoint]')) {
		const conditions: Record<string, string> = JSON.parse(section.dataset.conditions ?? '{}');
		watchLive<WeatherData>(
			section,
			(data) => {
				setText(section.querySelector('.teaser-temp'), `${data.tempC}°`);
				setText(section.querySelector('.teaser-weather-line'), `${conditions[data.condition] ?? ''} · ${data.city}`);
			},
			15 * 60_000,
		);
	}

	for (const section of document.querySelectorAll<HTMLElement>('.teaser-music[data-endpoint]')) {
		watchLive<MusicData>(
			section,
			({ track }) => {
				const status = section.querySelector<HTMLElement>('.teaser-track-status');
				section.querySelector<HTMLElement>('.teaser-track-dot')!.hidden = !track.nowPlaying;
				setText(
					section.querySelector('.teaser-track-status-text'),
					(track.nowPlaying ? status?.dataset.now : status?.dataset.last) ?? '',
				);
				setText(section.querySelector('.teaser-track-name'), `${track.title} — ${track.artist}`);
			},
			30_000,
		);
	}
</script>

<style>
	.teaser {
		display: flex;
		align-items: center;
		gap: var(--space-2xl);
		/* Same height in every weather state, so the tile never jumps. */
		min-height: var(--size-teaser);
	}

	.teaser-time {
		font-family: var(--font-mono);
		font-size: var(--size-hero);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.teaser-weather {
		display: flex;
		flex: 0 1 auto;
		align-items: center;
		gap: var(--space-lg);
		min-width: 0;
		padding-left: var(--space-2xl);
		border-left: 1px solid var(--border);
	}

	.teaser-weather-row {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		min-width: 0;
	}

	.teaser-temp {
		font-family: var(--font-mono);
		font-size: var(--size-title);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.teaser-detail {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
		color: var(--text-muted);
	}

	.teaser-weather > :global(.live-body),
	.teaser-weather :global(.live-content) {
		min-width: 0;
	}

	/* One line that gives way before the weather drops to a row of its own. */
	.teaser-weather-line {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* "… min ago" takes room only once the weather is stale, so fresh data
	   sits level with the temperature. */
	.teaser-detail :global(.live-footer:not([data-state='stale'])) {
		display: none;
	}

	/* Third column on wide screens; on a phone it takes its own row. */
	.teaser-music {
		flex: 1;
		min-width: 0;
		padding-left: var(--space-2xl);
		border-left: 1px solid var(--border);
	}

	.teaser-track {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.teaser-track-status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-subtle);
	}

	.teaser-track-dot {
		display: inline-flex;
	}

	.teaser-track-dot[hidden] {
		display: none;
	}

	.teaser-track-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	/* Error texts: one quiet line on the left. */
	:is(.teaser-weather, .teaser-music) :global(.live-error) {
		place-items: center start;
		text-align: left;
		white-space: nowrap;
	}

	@media (max-width: 639px) {
		.teaser {
			flex-wrap: wrap;
			row-gap: var(--space-lg);
		}

		/* Beside the time, cut short rather than wrapped under it. */
		.teaser-weather {
			flex: 1 1 0;
		}

		.teaser-music {
			flex-basis: 100%;
			padding: var(--space-lg) 0 0;
			border-left: 0;
			border-top: 1px solid var(--border);
		}
	}
</style>
