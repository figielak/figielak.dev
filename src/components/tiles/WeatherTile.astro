---
import Tile from '../ui/Tile.astro';
import LiveDot from '../ui/LiveDot.astro';
import LiveBody from '../ui/LiveBody.astro';
import LiveFooter from '../ui/LiveFooter.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { dotState } from '../../lib/live';
import { WEATHER_PLACEHOLDER, type Weather } from '../../lib/mocks/weather';

/** Current weather from Open-Meteo, cached 15 min (koncept.md §9). */
interface Props {
	weather: Weather;
	area?: string;
}

const { weather, area } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const d = weather.data ?? WEATHER_PLACEHOLDER;
---

<Tile area={area} label={t('tile.weather')} dense>
	<LiveDot slot="meta" state={dotState(weather.state)} />

	<LiveBody state={weather.state} errorText={t('weather.unavailable')}>
		<div class="weather">
			<span class="weather-temp" data-skeleton aria-live="polite">{d.tempC}°</span>
			<span class="weather-line" data-skeleton>{t(`weather.${d.condition}`)} · {d.city}</span>
			<span class="weather-line weather-detail" data-skeleton>
				{t('weather.feelsLike').replace('{n}', String(d.feelsLikeC))} · {
					t('weather.wind').replace('{n}', String(d.windKmh))
				}
			</span>
		</div>
	</LiveBody>

	<LiveFooter slot="footer" live={weather} />
</Tile>

<style>
	.weather {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: var(--space-2xs);
		height: 100%;
		min-width: 0;
		container-type: inline-size;
	}

	.weather-temp {
		font-family: var(--font-mono);
		font-size: min(var(--size-number), 30cqi);
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		margin-bottom: var(--space-2xs);
	}

	.weather-line {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text-muted);
	}

	.weather-detail {
		font-size: var(--size-label);
		color: var(--text-subtle);
	}

	/* Short desktop screens leave a 1×1 tile room for two lines only (§7). */
	@media (min-width: 1024px) and (max-height: 820px) {
		.weather-detail {
			display: none;
		}
	}
</style>
