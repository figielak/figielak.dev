---
import BentoLayout from '../ui/BentoLayout.astro';
import DashboardSwitch from '../ui/DashboardSwitch.astro';
import NowTile from '../tiles/NowTile.astro';
import LaunchersTile from '../tiles/LaunchersTile.astro';
import DeployTile from '../tiles/DeployTile.astro';
import SiteStatsTile from '../tiles/SiteStatsTile.astro';
import { mockDeploy } from '../../lib/mocks/deploy';
import { mockSite } from '../../lib/mocks/site';

/*
 * Private dashboard (koncept.md §3.4), behind a password on the server (§14):
 * launchers with real host names, deploys, site analytics and the now page.
 * Homelab stats are public (/dashboard).
 */
const lg = [
	'deploy  deploy  site    site    now     now',
	'launch  launch  launch  launch  launch  launch',
];

const md = [
	'launch  launch  launch  launch',
	'deploy  deploy  site    site',
	'now     now     now     now',
];

const base = [
	'launch  launch',
	'deploy  deploy',
	'site    site',
	'now     now',
];
---

<BentoLayout
	alive
	fill
	dense
	base={{ areas: base, columns: 2 }}
	md={{ areas: md, columns: 4 }}
	lg={{ areas: lg, columns: 6, rowSize: 'minmax(var(--dashboard-row-min), 1fr)' }}
>
	<NowTile area="now" />
	<LaunchersTile area="launch" />
	<DeployTile area="deploy" deploy={mockDeploy()} />
	<SiteStatsTile area="site" site={mockSite()} />
</BentoLayout>

<DashboardSwitch to="public" />
