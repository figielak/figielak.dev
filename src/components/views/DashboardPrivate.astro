---
import BentoLayout from '../ui/BentoLayout.astro';
import DashboardSwitch from '../ui/DashboardSwitch.astro';
import ServicesBarTile from '../tiles/ServicesBarTile.astro';
import ServerTile from '../tiles/ServerTile.astro';
import BackupTile from '../tiles/BackupTile.astro';
import DeployTile from '../tiles/DeployTile.astro';
import SiteStatsTile from '../tiles/SiteStatsTile.astro';
import LessonsTile from '../tiles/LessonsTile.astro';
import ExpiringTile from '../tiles/ExpiringTile.astro';
import GoalEditTile from '../tiles/GoalEditTile.astro';

/*
 * Private dashboard (koncept.md §3.4), behind a password on the server (§14):
 * a panel to run things from. The services in one line with their status on
 * top; then the server, the last backup and deploys; site analytics beside
 * the lessons; what expires beside the goal editor.
 *
 * Every tile reads its own /api/private/* endpoint, guarded like this page;
 * only the machine usage comes from the public /api/homelab/lab.
 * Rows count in halves, so the services bar is half as tall as the rest.
 */
const lg = [
	'svc     svc     svc     svc     svc      svc',
	'server  server  server  backup  deploy   deploy',
	'server  server  server  backup  deploy   deploy',
	'site    site    site    lessons  lessons  lessons',
	'site    site    site    lessons  lessons  lessons',
	'expire  expire  expire  goal     goal     goal',
	'expire  expire  expire  goal     goal     goal',
];

const md = [
	'svc     svc     svc     svc',
	'server  server  server  server',
	'backup  backup  deploy  deploy',
	'site    site    site    site',
	'lessons lessons expire  expire',
	'goal    goal    goal    goal',
];

const base = [
	'svc     svc',
	'server  server',
	'deploy  deploy',
	'backup  backup',
	'site    site',
	'lessons lessons',
	'expire  expire',
	'goal    goal',
];
---

<BentoLayout
	alive
	fill
	dense
	base={{ areas: base, columns: 2 }}
	md={{ areas: md, columns: 4 }}
	lg={{ areas: lg, columns: 6, rowSize: 'minmax(0, 1fr)' }}
>
	<ServicesBarTile area="svc" monitors={{ state: 'loading' }} endpoint="/api/private/homelab/monitors" />
	<ServerTile
		area="server"
		stats={{ state: 'loading' }}
		history={{ state: 'loading' }}
		containers={{ state: 'loading' }}
		endpoints={{
			lab: '/api/homelab/lab',
			history: '/api/private/homelab/history',
			containers: '/api/private/homelab/containers',
		}}
	/>
	<BackupTile area="backup" backup={{ state: 'loading' }} endpoint="/api/private/homelab/backup" />
	<DeployTile area="deploy" deploy={{ state: 'loading' }} endpoint="/api/private/deploys" />
	<SiteStatsTile area="site" site={{ state: 'loading' }} endpoint="/api/private/site" />
	<LessonsTile area="lessons" lessons={{ state: 'loading' }} endpoint="/api/private/lessons" />
	<ExpiringTile area="expire" expiring={{ state: 'loading' }} endpoint="/api/private/expiring" />
	<GoalEditTile area="goal" />
</BentoLayout>

<DashboardSwitch to="public" />
