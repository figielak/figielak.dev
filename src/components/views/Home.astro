---
import Pill from '../ui/Pill.astro';
import CopyValue from '../ui/CopyValue.astro';
import Dossier from '../ui/Dossier.astro';
import DossierSection from '../ui/DossierSection.astro';
import ProfileCard from '../ui/ProfileCard.astro';
import type { Social } from '../ui/ProfileCard.astro';
import DashboardTeaserTile from '../tiles/DashboardTeaserTile.astro';
import FeaturedCarousel from '../ui/FeaturedCarousel.astro';
import { featuredProjects } from '../../lib/featured';
import { emailEncoded, githubUrl, linkedinUrl } from '../../lib/contact';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * Two-column dossier: a pinned identity card on the left, a stream of sections
 * on the right. This view deliberately steps outside the bento grid the other
 * views share — see koncept.md §3.1.
 */
const name = 'Krystian Figiela';

/* The CV follows the page language (koncept.md §3.1). */
const cvHref = `/cv/cv-${lang}.pdf`;

const socials: Social[] = [
	{ label: 'GitHub', icon: 'github', href: githubUrl, external: true },
	{
		label: 'LinkedIn',
		icon: 'linkedin',
		href: linkedinUrl,
		external: true,
	},
];

/* Newest first. `period`: months (MM.YYYY) for stints under a year, years
   otherwise; `current` marks what is still going on. The company (`org`)
   shares the title's line, place and length go under it (`meta`), and `note`
   is one sentence on what I did — context, not a list of duties. */
const experience = [
	{
		period: '02.2026–05.2026',
		title: 'exp.bmm.title',
		org: 'exp.bmm.org',
		meta: 'exp.bmm.meta',
		note: 'exp.bmm.note',
	},
	{
		period: `2025–${t('edu.present')}`,
		title: 'exp.mlclub.title',
		meta: 'exp.mlclub.meta',
		note: 'exp.mlclub.note',
		current: true,
	},
	{
		period: '2023, 2024',
		title: 'exp.mfcomp.title',
		org: 'exp.mfcomp.org',
		meta: 'exp.mfcomp.meta',
		note: 'exp.mfcomp.note',
	},
] as const;

/* Newest first. A missing `end` means ongoing. */
const education = [
	{ start: 2025, title: 'edu.university.field', detail: 'edu.university.school' },
	{ start: 2020, end: 2025, title: 'edu.technikum.field', detail: 'edu.technikum.school' },
] as const;

/* En dash with no spaces, the typographic form for a range: 2020–2025. */
const formatPeriod = (start: number, end?: number) => `${start}–${end ?? t('edu.present')}`;

/* Grouped by theme: data, backend, tooling, AI. */
const skills = [
	'Python',
	'Pandas',
	'SQL',
	'FastAPI',
	'Flask',
	'Docker',
	'Linux',
	'Git',
	'Claude',
	'Copilot',
];
---

<Dossier>
	<ProfileCard
		slot="profile"
		name={name}
		role={t('home.role')}
		status={t('home.status')}
		bio={t('home.bio')}
		socials={socials}
		inlineSocials
	>
		<Fragment slot="actions">
			<a class="button button-primary" data-mailto={emailEncoded}>{t('home.write')}</a>
			<a class="button" href={cvHref}>{t('home.cv')}</a>
		</Fragment>

		<CopyValue encoded={emailEncoded} compact />
	</ProfileCard>

	<DossierSection
		label={t('home.featured')}
		action={{ href: localizePath('/projects', lang), label: t('home.allProjects') }}
	>
		<FeaturedCarousel projects={featuredProjects} />
	</DossierSection>

	<DossierSection label={t('tile.experience')} action={{ href: cvHref, label: t('home.fullCv') }}>
		<ul class="rows">
			{
				experience.map((item) => (
					<li class="row" data-current={'current' in item ? '' : undefined}>
						<span class="row-period">{item.period}</span>
						<span class="row-main">
							<span class="row-title">
								{t(item.title)}
								{'org' in item && <span class="row-org"> · {t(item.org)}</span>}
							</span>
							<span class="row-detail">{t(item.meta)}</span>
							<span class="row-note">{t(item.note)}</span>
						</span>
					</li>
				))
			}
		</ul>
	</DossierSection>

	<DossierSection label={t('tile.skills')}>
		<ul class="pills">
			{
				skills.map((skill) => (
					<li>
						<Pill>{skill}</Pill>
					</li>
				))
			}
		</ul>
	</DossierSection>

	<DossierSection label={t('tile.languages')}>
		<p class="languages">{t('home.languages')}</p>
	</DossierSection>

	<DossierSection label={t('tile.education')}>
		<ul class="rows">
			{
				education.map((item) => (
					<li class="row" data-current={'end' in item ? undefined : ''}>
						<span class="row-period">{formatPeriod(item.start, 'end' in item ? item.end : undefined)}</span>
						<span class="row-main">
							<span class="row-title">{t(item.title)}</span>
							<span class="row-detail">{t(item.detail)}</span>
						</span>
					</li>
				))
			}
		</ul>
	</DossierSection>

	<DashboardTeaserTile
		weather={{ state: 'loading' }}
		music={{ state: 'loading' }}
		weatherEndpoint="/api/weather"
		musicEndpoint="/api/music"
	/>
</Dossier>

<style>
	.languages {
		margin: 0;
	}
</style>
