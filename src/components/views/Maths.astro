---
import Tile from '../ui/Tile.astro';
import Pill from '../ui/Pill.astro';
import Icon from '../ui/Icon.astro';
import CopyValue from '../ui/CopyValue.astro';
import CardGrid from '../ui/CardGrid.astro';
import Dossier from '../ui/Dossier.astro';
import DossierSection from '../ui/DossierSection.astro';
import MobileContactBar from '../ui/MobileContactBar.astro';
import ProfileCard from '../ui/ProfileCard.astro';
import FeatureTile from '../tiles/FeatureTile.astro';
import type { Social } from '../ui/ProfileCard.astro';
import type { IconName } from '../ui/Icon.astro';
import {
	emailEncoded,
	instagramHandle,
	instagramUrl,
	messengerUrl,
	phoneEncoded,
} from '../../lib/contact';
import { ageOn, studyYearOn } from '../../lib/profile';
import { getLangFromUrl, pluralPl, useTranslations } from '../../i18n';
import type { TranslationKey } from '../../i18n';

const t = useTranslations(getLangFromUrl(Astro.url));

/*
 * Same dossier as the home page, written for pupils and parents instead of
 * recruiters (docs/koncept.md §3.3). Each section is a small row of cards rather
 * than lines of text, so the page can be scanned in a few seconds.
 * Polish only for now.
 */
const name = 'Krystian Figiela';

/* TODO: real price per 60 minutes. */
const price = 'XX';

const contactId = 'kontakt';

const age = ageOn();
const facts: { icon: IconName; text: string }[] = [
	{
		icon: 'cake',
		text: `${age} ${pluralPl(age, {
			one: t('maths.age.one'),
			few: t('maths.age.few'),
			many: t('maths.age.many'),
		})}`,
	},
	{ icon: 'school', text: t('maths.about.school') },
	{ icon: 'book', text: t('maths.about.study').replace('{year}', String(studyYearOn())) },
];

/* href / data-* are filled in by CopyValue's script from the encoded values. */
const socials: Social[] = [
	{ label: t('maths.contact.whatsapp'), icon: 'whatsapp', external: true, attrs: { 'data-whatsapp': phoneEncoded } },
	{ label: t('maths.contact.messenger'), icon: 'messenger', href: messengerUrl, external: true },
	{ label: t('maths.contact.instagram'), icon: 'instagram', href: instagramUrl, external: true },
	{ label: t('maths.contact.email'), icon: 'mail', attrs: { 'data-mailto': emailEncoded } },
];

type Card = {
	icon: IconName;
	title: TranslationKey;
	detail: TranslationKey;
	kicker?: TranslationKey;
	muted?: boolean;
};

const offer: Card[] = [
	{ icon: 'school', kicker: 'maths.offer.e8.tag', title: 'maths.offer.e8.title', detail: 'maths.offer.e8.detail' },
	{
		icon: 'math-function',
		kicker: 'maths.offer.basic.tag',
		title: 'maths.offer.basic.title',
		detail: 'maths.offer.basic.detail',
	},
	{
		icon: 'hourglass',
		kicker: 'maths.offer.extended.tag',
		title: 'maths.offer.extended.title',
		detail: 'maths.offer.extended.detail',
		muted: true,
	},
];

const paths: Card[] = [
	{ icon: 'seeding', title: 'maths.path.basics.title', detail: 'maths.path.basics.detail' },
	{ icon: 'calendar', title: 'maths.path.school.title', detail: 'maths.path.school.detail' },
	{ icon: 'target', title: 'maths.path.exam.title', detail: 'maths.path.exam.detail' },
	{ icon: 'bolt', title: 'maths.path.adhoc.title', detail: 'maths.path.adhoc.detail' },
];

const format: Card[] = [
	{ icon: 'device-laptop', title: 'maths.format.online.title', detail: 'maths.format.online.detail' },
	{ icon: 'map-pin', title: 'maths.format.inPerson.title', detail: 'maths.format.inPerson.detail' },
];

/* The WhatsApp href is replaced in the browser from the encoded number, like
   the icon above; the anchor fallback only keeps the card a link without JS. */
const messengers: {
	icon: IconName;
	title: string;
	detail: string;
	href?: string;
	attrs?: Record<string, string>;
}[] = [
	{
		icon: 'whatsapp',
		title: t('maths.contact.whatsapp'),
		detail: t('maths.contact.message'),
		href: `#${contactId}`,
		attrs: { 'data-whatsapp': phoneEncoded },
	},
	{
		icon: 'messenger',
		title: t('maths.contact.messenger'),
		detail: t('maths.contact.message'),
		href: messengerUrl,
	},
	{
		icon: 'instagram',
		title: t('maths.contact.instagram'),
		detail: `@${instagramHandle}`,
		href: instagramUrl,
	},
];
---

<Dossier relaxed>
	<ProfileCard
		slot="profile"
		name={name}
		role={t('maths.role')}
		status={t('maths.status')}
		location={t('maths.location')}
		bio={t('maths.bio')}
		socials={socials}
		avatarSize="lg"
	>
		<Fragment slot="actions">
			<a class="button button-primary" href={`#${contactId}`}>{t('maths.book')}</a>
			<a class="button" data-tel={phoneEncoded}>{t('maths.call')}</a>
		</Fragment>
	</ProfileCard>

	<DossierSection label={t('maths.free.label')}>
		<Tile class="free">
			<div class="free-inner">
				<span class="free-amount" data-numeric>{t('maths.free.amount')}</span>
				<div class="free-copy">
					<h2 class="free-title">
						<Icon name="gift" size={18} />
						{t('maths.free.title')}
					</h2>
					<p class="free-text">{t('maths.free.text')}</p>
				</div>
				<a class="button button-primary free-action" href={`#${contactId}`}>{t('maths.free.action')}</a>
			</div>
		</Tile>
	</DossierSection>

	<DossierSection label={t('maths.about.label')}>
		<p class="lead">{t('maths.about.text')}</p>
		<ul class="pills">
			{
				facts.map((fact) => (
					<li>
						<Pill class="fact">
							<Icon name={fact.icon} size={14} />
							{fact.text}
						</Pill>
					</li>
				))
			}
		</ul>
	</DossierSection>

	<DossierSection label={t('maths.offer.label')}>
		<CardGrid columns={3}>
			{
				offer.map((card) => (
					<FeatureTile
						icon={card.icon}
						kicker={card.kicker && t(card.kicker)}
						title={t(card.title)}
						detail={t(card.detail)}
						muted={card.muted}
					/>
				))
			}
		</CardGrid>
	</DossierSection>

	<DossierSection label={t('maths.method.label')}>
		<p class="lead">{t('maths.method.text')}</p>
		<CardGrid columns={2}>
			{
				paths.map((card, index) => (
					<FeatureTile
						icon={card.icon}
						kicker={String(index + 1).padStart(2, '0')}
						title={t(card.title)}
						detail={t(card.detail)}
						inline
					/>
				))
			}
		</CardGrid>
	</DossierSection>

	<DossierSection label={t('maths.format.label')}>
		<CardGrid columns={3}>
			{format.map((card) => <FeatureTile icon={card.icon} title={t(card.title)} detail={t(card.detail)} />)}
			<FeatureTile
				icon="coin"
				kicker={t('maths.format.price.tag')}
				title={t('maths.format.price.title').replace('{price}', price)}
				detail={t('maths.format.price.detail')}
				numeric
			/>
		</CardGrid>
	</DossierSection>

	<DossierSection label={t('maths.contact.label')} id={contactId}>
		<p class="lead">{t('maths.contact.text')}</p>
		<div class="copy-fields">
			<div class="copy-field">
				<span class="copy-field-label">{t('maths.contact.phone')}</span>
				<CopyValue encoded={phoneEncoded} kind="phone" />
			</div>
			<div class="copy-field">
				<span class="copy-field-label">{t('maths.contact.email')}</span>
				<CopyValue encoded={emailEncoded} />
			</div>
		</div>
		<CardGrid columns={3}>
			{
				messengers.map((card) => (
					<FeatureTile
						icon={card.icon}
						title={card.title}
						detail={card.detail}
						href={card.href}
						external
						{...card.attrs}
					/>
				))
			}
		</CardGrid>
	</DossierSection>
</Dossier>

<MobileContactBar
	target={contactId}
	primaryLabel={t('maths.book')}
	callLabel={t('maths.call')}
	phoneEncoded={phoneEncoded}
/>

<style>
	/* The one tinted card in the stream, marking the offer. */
	.free {
		background: var(--accent-soft);
		border-color: var(--accent-soft);
	}

	.free-inner {
		display: flex;
		align-items: center;
		gap: var(--space-2xl);
	}

	.free-amount {
		flex: none;
		font-family: var(--font-mono);
		font-size: var(--size-number);
		font-weight: 700;
		line-height: 1;
		color: var(--accent);
	}

	.free-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.free-title {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin: 0;
		font-size: var(--size-title);
		font-weight: 500;
	}

	.free-title :global(svg) {
		color: var(--accent);
	}

	.free-text,
	.lead {
		margin: 0;
		max-width: 68ch;
		color: var(--text-muted);
	}

	.free-action {
		flex: none;
	}

	/* Facts are read as content, not tags, so they use the body type. */
	.pills :global(.fact) {
		padding: var(--space-xs) var(--space-lg);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: var(--size-body);
	}

	.copy-fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--grid-gap);
	}

	.copy-field {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		min-width: 0;
	}

	.copy-field-label {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	@media (max-width: 639px) {
		.free-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-lg);
		}

		.copy-fields {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
