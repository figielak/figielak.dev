---
import BentoLayout from '../ui/BentoLayout.astro';
import DashboardSwitch from '../ui/DashboardSwitch.astro';
import ClockTile from '../tiles/ClockTile.astro';
import WeatherTile from '../tiles/WeatherTile.astro';
import AirTile from '../tiles/AirTile.astro';
import SunTile from '../tiles/SunTile.astro';
import ProgressTile from '../tiles/ProgressTile.astro';
import GithubTile from '../tiles/GithubTile.astro';
import WakaTile from '../tiles/WakaTile.astro';
import DnsTile from '../tiles/DnsTile.astro';
import NetTile from '../tiles/NetTile.astro';
import MusicTile from '../tiles/MusicTile.astro';
import BooksTile from '../tiles/BooksTile.astro';
import CoffeeTile from '../tiles/CoffeeTile.astro';
import EventTile from '../tiles/EventTile.astro';
import { mockWeather } from '../../lib/mocks/weather';
import { mockAir } from '../../lib/mocks/air';
import { mockWaka } from '../../lib/mocks/waka';
import { mockDns, mockTraffic } from '../../lib/mocks/network';
import { mockCoffee } from '../../lib/mocks/coffee';

/*
 * Public dashboard (koncept.md §3.4): local on top, then work, homelab and
 * life. GitHub gets two rows — its chart does not fit one at 1280×720. Anything that tells when I am at the computer lives on the
 * private dashboard instead (§14).
 */
const lg = [
	'clock   weather air     sun     progress progress',
	'github  github  github  music   music    music',
	'github  github  github  waka    waka     dns',
	'books   books   coffee  net     event    event',
];

const md = [
	'clock    weather  air      sun',
	'progress progress event    event',
	'github   github   github   github',
	'music    music    music    music',
	'waka     waka     dns      net',
	'books    books    coffee   coffee',
];

const base = [
	'clock    weather',
	'air      sun',
	'progress progress',
	'event    event',
	'github   github',
	'waka     waka',
	'music    music',
	'dns      net',
	'books    coffee',
];
---

<BentoLayout
	fill
	dense
	base={{ areas: base, columns: 2 }}
	md={{ areas: md, columns: 4 }}
	lg={{ areas: lg, columns: 6, rowSize: 'minmax(var(--dashboard-row-min), 1fr)' }}
>
	<ClockTile area="clock" />
	<WeatherTile area="weather" weather={mockWeather()} />
	<AirTile area="air" air={mockAir()} />
	<SunTile area="sun" />
	<ProgressTile area="progress" />
	<GithubTile area="github" github={{ state: 'loading' }} endpoint="/api/github" />
	<WakaTile area="waka" waka={mockWaka()} />
	<DnsTile area="dns" dns={mockDns()} />
	<NetTile area="net" traffic={mockTraffic()} />
	<MusicTile area="music" music={{ state: 'loading' }} endpoint="/api/music" />
	<BooksTile area="books" />
	<CoffeeTile area="coffee" coffee={mockCoffee()} />
	<EventTile area="event" />
</BentoLayout>

<DashboardSwitch to="private" />
