---
import BentoLayout from '../ui/BentoLayout.astro';
import DashboardSwitch from '../ui/DashboardSwitch.astro';
import CurrentWorkTile from '../tiles/CurrentWorkTile.astro';
import GithubTile from '../tiles/GithubTile.astro';
import WakaTile from '../tiles/WakaTile.astro';
import ExperimentTile from '../tiles/ExperimentTile.astro';
import MusicTile from '../tiles/MusicTile.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/* Reading and keyboard order match the explicit areas at every breakpoint. */
const lg = [
	'build build build build waka waka',
	'github github github github github github',
	'experiment experiment experiment music music music',
];
const md = [
	'build build build build',
	'waka waka waka waka',
	'github github github github',
	'experiment experiment music music',
];
const base = [
	'build build',
	'waka waka',
	'github github',
	'experiment music',
];
---

<section class="dev-log" aria-labelledby="dev-log-title">
	<header class="dev-log-intro">
		<p class="dev-log-label">{t('devLog.label')}</p>
		<h1 id="dev-log-title">{t('devLog.title')}</h1>
		<p class="dev-log-subtitle">{t('devLog.subtitle')}</p>
		<p class="dev-log-updated" data-template={t('devLog.updated')} data-lang={lang}>&nbsp;</p>
	</header>

	<BentoLayout
		alive
		base={{ areas: base, columns: 2 }}
		md={{ areas: md, columns: 4 }}
		lg={{ areas: lg, columns: 6 }}
	>
		<CurrentWorkTile area="build" endpoint="/api/github" />
		<WakaTile area="waka" waka={{ state: 'loading' }} endpoint="/api/waka" />
		<GithubTile area="github" github={{ state: 'loading' }} endpoint="/api/github" />
		<ExperimentTile area="experiment" />
		<MusicTile area="music" music={{ state: 'loading' }} endpoint="/api/music" />
	</BentoLayout>
	<DashboardSwitch to="private" />
</section>

<script>
	import { timeAgo } from '../../lib/live';

	/* One "updated …" for the page, from the newest answer of any card; a card
	   whose own data goes stale still says so itself. */
	for (const line of document.querySelectorAll<HTMLElement>('.dev-log-updated')) {
		const { template = '{t}', lang = 'pl' } = line.dataset;
		let newest: Date | undefined;
		const show = () => {
			if (newest) line.textContent = template.replace('{t}', timeAgo(newest, lang));
		};
		line.closest('.dev-log')?.addEventListener('live:updated', (event) => {
			const date = (event as CustomEvent<Date>).detail;
			if (!newest || date > newest) newest = date;
			show();
		});
		setInterval(show, 60_000);
	}
</script>

<style>
	.dev-log-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		margin-block: var(--space-3xl);
	}

	.dev-log-label,
	.dev-log-updated {
		font-family: var(--font-mono);
		font-size: var(--size-label);
		letter-spacing: var(--tracking-label);
		color: var(--text-muted);
	}

	.dev-log-updated {
		text-transform: uppercase;
	}

	h1 {
		font-size: var(--size-hero);
		font-weight: 700;
		line-height: 1.1;
	}

	.dev-log-subtitle {
		color: var(--text-muted);
	}

	/* Flat, opaque cards like the rest of the site (no glass over a glow);
	   the cursor light on the edges stays. */
	.dev-log :global(.tile) {
		container-type: inline-size;
		background: var(--surface);
		backdrop-filter: none;
	}

	.dev-log :global(.tile[data-interactive]:hover) {
		background: var(--surface-hover);
	}

	/* The public composition uses the roomier Tile padding; private density
	   and the reusable live components keep their existing defaults. */
	.dev-log :global(.tile[data-dense]) {
		padding: var(--tile-padding);
		gap: var(--space-lg);
	}

	/* A card's dot speaks only when there is a problem: stale or missing data. */
	.dev-log :global(.tile-header .live-dot[data-state='live']) {
		visibility: hidden;
	}

	.dev-log :global(.switch-link),
	.dev-log :global(.live-error),
	.dev-log :global(.live-footer) {
		color: var(--text-muted);
	}
</style>
