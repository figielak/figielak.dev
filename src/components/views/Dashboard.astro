---
import BentoLayout from '../ui/BentoLayout.astro';
import DashboardSwitch from '../ui/DashboardSwitch.astro';
import DayTile from '../tiles/DayTile.astro';
import WeatherTile from '../tiles/WeatherTile.astro';
import GithubTile from '../tiles/GithubTile.astro';
import WakaTile from '../tiles/WakaTile.astro';
import HomelabTile from '../tiles/HomelabTile.astro';
import MusicTile from '../tiles/MusicTile.astro';
import BooksTile from '../tiles/BooksTile.astro';
import EventTile from '../tiles/EventTile.astro';
import FeaturedTile from '../tiles/FeaturedTile.astro';
import SocialTile from '../tiles/SocialTile.astro';
import { mockWeather } from '../../lib/mocks/weather';
import { mockAir } from '../../lib/mocks/air';

/*
 * Public dashboard (koncept.md §3.4): cards in different shapes — the bento
 * rhythm. The day and the weather top left, GitHub wide and low under them,
 * music tall and narrow like a cover, the homelab big because it holds the
 * most; the featured project is the biggest, as the one card that sells
 * something. WakaTime is the one accent block beside the social tiles.
 * Homelab numbers are public: it is a server, so they do not tell when I am at
 * the computer (§14).
 *
 * Rows are half-height units, so the social tiles can be half as tall as the
 * rest: one screen from 1440×900 (§7), a little scroll on 1280×720.
 */
const lg = [
	'day      day      weather  music    lab      lab',
	'day      day      weather  music    lab      lab',
	'github   github   github   music    lab      lab',
	'github   github   github   music    lab      lab',
	'featured featured featured dc       ig       waka',
	'featured featured featured gh       li       waka',
	'featured featured featured books    books    event',
	'featured featured featured books    books    event',
];

const md = [
	'day      day      weather  music',
	'github   github   github   music',
	'featured featured featured featured',
	'featured featured featured featured',
	'dc       ig       gh       li',
	'lab      lab      lab      lab',
	'lab      lab      lab      lab',
	'waka     waka     books    books',
	'event    event    books    books',
];

/* Wide cards take the row, small ones go in pairs — never one column. */
const base = [
	'day      day',
	'weather  music',
	'github   github',
	'featured featured',
	'dc       ig',
	'gh       li',
	'lab      lab',
	'waka     event',
	'books    books',
];
---

<BentoLayout
	fill
	tall
	dense
	base={{ areas: base, columns: 2 }}
	md={{ areas: md, columns: 4 }}
	lg={{ areas: lg, columns: 6 }}
	xl={{ areas: lg, columns: 6, rowSize: 'minmax(auto, 1fr)' }}
>
	<DayTile area="day" />
	<WeatherTile area="weather" weather={mockWeather()} air={mockAir()} />
	<GithubTile area="github" github={{ state: 'loading' }} endpoint="/api/github" />
	<MusicTile area="music" music={{ state: 'loading' }} endpoint="/api/music" />
	<HomelabTile
		area="lab"
		stats={{ state: 'loading' }}
		uptime={{ state: 'loading' }}
		traffic={{ state: 'loading' }}
		dns={{ state: 'loading' }}
		endpoints={{
			lab: '/api/homelab/lab',
			uptime: '/api/homelab/uptime',
			net: '/api/homelab/net',
			dns: '/api/homelab/dns',
		}}
	/>
	<FeaturedTile area="featured" />
	<SocialTile area="dc" brand="discord" />
	<SocialTile area="ig" brand="instagram" />
	<SocialTile area="gh" brand="github" />
	<SocialTile area="li" brand="linkedin" />
	<WakaTile area="waka" waka={{ state: 'loading' }} endpoint="/api/waka" />
	<BooksTile area="books" />
	<EventTile area="event" />
</BentoLayout>

<DashboardSwitch to="private" />
