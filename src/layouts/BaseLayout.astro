---
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Nav from '../components/ui/Nav.astro';
import Terminal from '../components/ui/Terminal.astro';
import { getLangFromUrl, localizePath, stripLang, useTranslations } from '../i18n';
import { githubUrl, linkedinUrl } from '../lib/contact';

interface Props {
	title: string;
	description: string;
	/** Drops the content cap so the view spans the full viewport — the
	    dashboard's six-column grid uses every pixel it can get. */
	wide?: boolean;
	/** Keeps the page out of search results — the private dashboard. */
	noindex?: boolean;
	/** Blurred accent glow drifting behind the page — the dashboards. */
	glow?: boolean;
	/** Has an /en/ twin; off for Polish-only pages (tutoring). */
	translated?: boolean;
}

const { title, description, wide = false, noindex = false, glow = false, translated = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);

/* Both language versions for search engines, so English searches get /en/
   instead of "Translate this page"; Polish is the default (x-default). */
const path = stripLang(Astro.url.pathname);
/* With a trailing slash, like the canonical URL and the sitemap. */
const pageUrl = (target: 'pl' | 'en') => new URL(localizePath(path, target).replace(/\/?$/, '/'), Astro.site);
const alternates =
	translated && !noindex
		? [
				{ hreflang: 'pl', href: pageUrl('pl') },
				{ hreflang: 'en', href: pageUrl('en') },
				{ hreflang: 'x-default', href: pageUrl('pl') },
			]
		: [];

/* On the home page only: the site's name in search results (instead of the
   bare domain) and who it is about. Public facts only — no e-mail or phone. */
const structuredData =
	path === '/' && !noindex
		? JSON.stringify({
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'WebSite',
						'@id': `${Astro.site}#website`,
						url: Astro.site,
						name: 'Krystian Figiela',
						alternateName: 'figielak.dev',
						inLanguage: ['pl', 'en'],
					},
					{
						'@type': 'Person',
						'@id': `${Astro.site}#person`,
						name: 'Krystian Figiela',
						url: Astro.site,
						jobTitle: 'Data & Software Developer',
						address: { '@type': 'PostalAddress', addressLocality: 'Rzeszów', addressCountry: 'PL' },
						affiliation: { '@type': 'CollegeOrUniversity', name: 'Politechnika Rzeszowska' },
						sameAs: [githubUrl, linkedinUrl],
					},
				],
			}).replace(/</g, '\\u003c')
		: undefined;
---

<!doctype html>
<html lang={lang} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

		<link
			rel="preload"
			href="/fonts/Satoshi-Variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Krystian Figiela" />
		<meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		{structuredData && <script type="application/ld+json" set:html={structuredData} />}

		{/* Applies the stored theme before first paint, so it never flashes. */}
		<script is:inline>
			(() => {
				/* Storage can throw (private mode, blocked site data) — fall back to
				   the default theme set on <html>. */
				try {
					const stored = localStorage.getItem('theme');
					if (stored) document.documentElement.dataset.theme = stored;
				} catch {}
			})();
		</script>

		{/* Dashboard intro, first visit in a session or a click on Dashboard in
		    the navigation (Nav clears the mark): tiles stay hidden
		    until src/scripts/intro.ts plays them in. If that script never
		    starts, the timeout shows them anyway. */}
		{
			glow && (
				<script is:inline>
					(() => {
						try {
							if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
							if (sessionStorage.getItem('intro:' + location.pathname.replace(/\/$/, ''))) return;
							const html = document.documentElement;
							html.dataset.intro = 'pending';
							setTimeout(() => {
								if (html.dataset.intro === 'pending') delete html.dataset.intro;
							}, 2000);
						} catch {}
					})();
				</script>
			)
		}
	</head>

	<body class:list={[glow && 'has-glow']}>
		{
			glow && (
				<div class="page-glow" aria-hidden="true">
					<span />
					<span />
				</div>
			)
		}

		<a href="#main" class="skip-link">{t('nav.skip')}</a>

		<header class="topbar">
			<Nav />
		</header>

		<div class:list={['shell', wide && 'shell-wide']}>
			<main id="main" class="shell-main">
				<slot />
			</main>
		</div>

		<Terminal />

		<script>
			/* Phones: the navigation is pinned to the top, slides away while the
			   reader scrolls down and comes back on the first move up (docs/koncept.md
			   §2). Hidden, it is also inert, so Tab never lands in it unseen. */
			const topbar = document.querySelector<HTMLElement>('.topbar');
			const phone = window.matchMedia('(max-width: 639px)');
			/* Pixels of scroll in one direction before the bar reacts, so a
			   shaky thumb does not make it flicker. */
			const THRESHOLD = 8;

			if (topbar) {
				let last = window.scrollY;
				let queued = false;

				const setHidden = (hidden: boolean) => {
					topbar.toggleAttribute('data-hidden', hidden);
					topbar.toggleAttribute('inert', hidden);
				};

				const update = () => {
					queued = false;
					const y = window.scrollY;
					/* The terminal locks the page; its scroll jumps say nothing. */
					if (!phone.matches || document.documentElement.classList.contains('terminal-open')) {
						last = y;
						return;
					}
					if (y <= topbar.offsetHeight) setHidden(false);
					else if (y - last > THRESHOLD) setHidden(true);
					else if (last - y > THRESHOLD) setHidden(false);
					else return;
					last = y;
				};

				window.addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(update);
					},
					{ passive: true },
				);

				/* Wider screens (a turned phone) never hide it. */
				phone.addEventListener('change', () => {
					if (!phone.matches) setHidden(false);
					last = window.scrollY;
				});

				topbar.addEventListener('focusin', () => setHidden(false));
			}
		</script>
	</body>
</html>

<style>
	/* Full-bleed: the rule under the navigation runs the whole width of the
	   screen, while the navigation itself stays in the middle half. */
	.topbar {
		width: 100%;
		border-bottom: 1px solid var(--border-divider);
	}

	/* Phones: pinned to the top on frosted glass; the script above slides it
	   away while scrolling down. Only the transform moves (docs/koncept.md §8). */
	@media (max-width: 639px) {
		.topbar {
			position: sticky;
			top: 0;
			z-index: var(--z-nav);
			background: var(--nav-glass);
			backdrop-filter: blur(var(--glass-blur));
			transition: transform var(--duration-nav) var(--ease-out);
		}

		.topbar[data-hidden] {
			transform: translateY(-100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.topbar {
			transition: none;
		}
	}

	.shell {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		max-width: var(--page-max-width);
		min-height: 0;
		margin: 0 auto;
		padding: var(--grid-gap) var(--page-gutter) var(--page-gutter);
	}

	.shell-wide {
		max-width: none;
	}

	.shell-main {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	/* The glow sits over the page background and under everything else. */
	.has-glow {
		isolation: isolate;
	}

	.page-glow {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	.page-glow span {
		position: absolute;
		width: var(--glow-size);
		height: var(--glow-size);
		border-radius: 50%;
		background: radial-gradient(circle, var(--glow), transparent 70%);
		filter: blur(var(--glow-blur));
		animation: glow-drift var(--duration-glow) ease-in-out infinite alternate;
	}

	.page-glow span:first-child {
		top: -25%;
		left: -15%;
	}

	/* A longer, reversed cycle, so the two never move in step. */
	.page-glow span:last-child {
		right: -10%;
		bottom: -25%;
		animation-duration: calc(var(--duration-glow) * 1.3);
		animation-direction: alternate-reverse;
	}

	@keyframes glow-drift {
		0% {
			transform: translate(0, 0) scale(1);
		}
		50% {
			transform: translate(12vw, 8vh) scale(1.15);
		}
		100% {
			transform: translate(4vw, 18vh) scale(0.9);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-glow span {
			animation: none;
		}
	}

	.skip-link {
		position: absolute;
		left: -9999px;
	}

	.skip-link:focus {
		left: var(--page-gutter);
		top: var(--page-gutter);
		z-index: 50;
		padding: var(--space-sm) var(--space-xl);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--text);
	}
</style>
